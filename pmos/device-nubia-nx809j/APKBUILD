# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-nubia-nx809j
pkgdesc="Nubia RedMagic 11 Pro"
pkgver=1
pkgrel=7
url="https://github.com/Reixo0/nx809j-mainline"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# Deliberately minimal: no dynpart mappings or firmware partition mounts.
# Android lives on the same UFS and nothing here may write to it, except
# qbootctl marking slot a's boot successful (as Android does every boot).
# nx809j-wifi-mac and nx809j-bt-addr read persist/wifimac.dat and
# persist/.bt_nv.bin with debugfs -c (read only).
# mesa-vulkan-freedreno: Turnip, Vulkan for the Adreno 840 (the UI only
# pulls in the OpenGL side of Mesa)
depends="
	linux-nubia-nx809j
	mesa-vulkan-freedreno
	bluez-btmgmt
	e2fsprogs-extra
	postmarketos-base
	qbootctl
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	50-nx809j-usb0-unmanaged.conf
	80-nx809j.preset
	nx809j-usb-uplink.service
	nx809j-cpufreq-boost.conf
	nx809j-mark-boot-successful.service
	nx809j-wifi-mac
	nx809j-wifi-mac.service
	nx809j-bt-addr
	nx809j-bt-addr.service
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/50-nx809j-usb0-unmanaged.conf \
		-t "$pkgdir"/usr/lib/NetworkManager/conf.d/
	install -Dm644 "$srcdir"/nx809j-usb-uplink.service \
		"$srcdir"/nx809j-mark-boot-successful.service \
		"$srcdir"/nx809j-wifi-mac.service \
		"$srcdir"/nx809j-bt-addr.service \
		-t "$pkgdir"/usr/lib/systemd/system/
	install -Dm755 "$srcdir"/nx809j-wifi-mac "$srcdir"/nx809j-bt-addr \
		-t "$pkgdir"/usr/libexec/
	install -Dm644 "$srcdir"/80-nx809j.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset/
	install -Dm644 "$srcdir"/nx809j-cpufreq-boost.conf \
		"$pkgdir"/usr/lib/tmpfiles.d/nx809j-cpufreq-boost.conf
}

