# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-nubia-nx809j
pkgdesc="Nubia RedMagic 11 Pro"
pkgver=1
pkgrel=12
url="https://github.com/Reixo0/nx809j-mainline"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# Deliberately minimal: no dynpart mappings or firmware partition mounts.
# Android lives on the same UFS and nothing here may write to it, except
# qbootctl marking slot a's boot successful (as Android does every boot).
# nx809j-wifi-mac and nx809j-bt-addr read persist/wifimac.dat and
# persist/.bt_nv.bin with debugfs -c (read only).
# mesa-vulkan-freedreno: Turnip, Vulkan for the Adreno 840 (the UI only
# pulls in the OpenGL side of Mesa)
# rmtfs, tqftpserv: the modem's file system and firmware servers; rmtfs
# serves copies in /var/lib/rmtfs, never the modem partitions
# The files themselves come from device/rootfs in the nx809j-mainline repo,
# packed into device-files.tar.gz by scripts/pmos-kernel-pkg.sh, so every
# distribution gets the same ones.
depends="
	linux-nubia-nx809j
	mesa-vulkan-freedreno
	bluez-btmgmt
	e2fsprogs-extra
	postmarketos-base
	qbootctl
	rmtfs
	tqftpserv
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	device-files.tar.gz
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	tar -C "$pkgdir" --no-same-owner -xzf "$srcdir"/device-files.tar.gz
}

sha512sums="
e19d5042d4e4013d4298804c9b0cfccc748c32068520030ea3962f781866a041d2a93d7cbe13772ac79399df392800ba327d7641a35819cea382d45de66c2594  deviceinfo
688ed1003ffcee683dc5cf130d30c72c3fbeb553fa0b4dfefd33b11b4ddc57a53b1a58719dea76f37dc9880cf0946f7975a89a8afc9a96a912097dd190b6d1cf  device-files.tar.gz
"
