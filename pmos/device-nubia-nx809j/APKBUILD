# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-nubia-nx809j
pkgdesc="Nubia RedMagic 11 Pro"
pkgver=1
pkgrel=2
url="https://github.com/Reixo0/nx809j-mainline"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# Deliberately minimal: no qbootctl, dynpart mappings or firmware partition
# mounts. Android lives on the same UFS and nothing here may write to it.
depends="
	linux-nubia-nx809j
	postmarketos-base
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	50-nx809j-usb0-unmanaged.conf
	80-nx809j.preset
	nx809j-usb-uplink.service
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/50-nx809j-usb0-unmanaged.conf \
		-t "$pkgdir"/usr/lib/NetworkManager/conf.d/
	install -Dm644 "$srcdir"/nx809j-usb-uplink.service \
		-t "$pkgdir"/usr/lib/systemd/system/
	install -Dm644 "$srcdir"/80-nx809j.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset/
}

