# Kernel for the Nubia RedMagic 11 Pro, built outside pmbootstrap from
# linux-next + the patches in https://github.com/Reixo0/nx809j-mainline
# (scripts/build.sh). scripts/pmos-kernel-pkg.sh refreshes the tarball.
#
# The phone boots its kernel from boot_a via the shim, not from this package;
# it provides /boot and the dtb so the rootfs matches what's running.
pkgname=linux-nubia-nx809j
pkgver=7.3.0_git20261022
pkgrel=5
pkgdesc="Nubia RedMagic 11 Pro kernel (linux-next, prebuilt)"
arch="aarch64"
_carch="arm64"
_flavor="nubia-nx809j"
url="https://github.com/Reixo0/nx809j-mainline"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
source="kernel.tar.gz"

package() {
	install -Dm644 "$srcdir/Image" "$pkgdir/boot/vmlinuz"
	install -Dm644 "$srcdir/kaanapali-nubia-nx809j.dtb" \
		"$pkgdir/boot/dtbs/qcom/kaanapali-nubia-nx809j.dtb"
	install -Dm644 "$srcdir/config" "$pkgdir/boot/config"

	# mkinitfs looks up the kernel version here (Alpine convention)
	install -Dm644 "$srcdir/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"

	# /lib is a symlink to usr/lib in the rootfs
	local release="$(cat "$srcdir/kernel.release")"
	local moddir="$pkgdir/usr/lib/modules/$release"
	mkdir -p "$moddir"
	if [ -d "$srcdir/lib/modules/$release" ]; then
		cp -a "$srcdir/lib/modules/$release/." "$moddir/"
	fi
	# Most drivers are built in; mkinitfs and modprobe need these lists
	install -Dm644 "$srcdir/modules.builtin" "$srcdir/modules.builtin.modinfo" \
		-t "$moddir"
	[ -e "$moddir/modules.order" ] || touch "$moddir/modules.order"
}

sha512sums="
101151eb06699e4d3236b015aa94c9452f3812103289686c6f0aa85c6a0d66d08d87390212287466bcc666aae5cd720fe3785957b762016d67feff5363ea8660  kernel.tar.gz
"
