From bc964b42bd0b8659da1d5147395f02c6d13ca64e Mon Sep 17 00:00:00 2001
From: Reixo <125610085+Reixo0@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:34:41 +0100
Subject: [PATCH] Work inside Firefox's RDD sandbox

Firefox decodes in a sandboxed process that may open the render node and
/dev/videoN but not /dev/dma_heap/system, list /dev or read sysfs.

- surface: when the DMA heap cannot be opened, allocate the surface as a
  linear R8 GBM buffer on the render node (libgbm loaded at run time) and
  use its dma-buf, instead of a memfd that EGL cannot import.
- qcom-iris: when the glob of /dev or the sysfs name check finds no
  decoder, try /dev/video0..63 and take the node whose QUERYCAP names the
  Iris decoder.

With these, Firefox 160 decodes VP9 through VA-API in its normal sandbox
with default preferences (NX809J, SM8850).
---
 src/decode/surface.c     | 75 +++++++++++++++++++++++++++++++++++++---
 src/platform/qcom/iris.c | 34 ++++++++++++++++--
 2 files changed, 103 insertions(+), 6 deletions(-)

diff --git a/src/decode/surface.c b/src/decode/surface.c
index 6b75376..170c9b1 100644
--- a/src/decode/surface.c
+++ b/src/decode/surface.c
@@ -5,6 +5,7 @@
  * Surfaces belong to the VA display, not to a decode context, so they outlive
  * the engine that decoded into them and may be recycled across seeks. */
 
+#include <dlfcn.h>
 #include <errno.h>
 #include <fcntl.h>
 #include <stdio.h>
@@ -45,6 +46,66 @@ dma_heap_alloc(int heap_fd, unsigned int size)
 	return data.fd;
 }
 
+/* Backing from the GPU's render node through GBM, for clients whose
+ * sandbox allows the render node but not /dev/dma_heap/system (Firefox's
+ * RDD process). A linear R8 buffer of pitch x rows, exported as a dma-buf:
+ * GPU-importable like a heap buffer and CPU-mappable. libgbm is loaded at
+ * run time, so the driver does not depend on it. Returns -1 when no render
+ * node or GBM is available. */
+struct gbm_device;
+struct gbm_bo;
+union gbm_bo_handle { void *ptr; int32_t s32; uint32_t u32; int64_t s64; uint64_t u64; };
+#define VPU_GBM_FORMAT_R8 0x20203852u /* fourcc 'R','8',' ',' ' */
+#define VPU_GBM_BO_USE_LINEAR (1u << 4)
+
+static int
+gbm_alloc(unsigned int pitch, unsigned int rows)
+{
+	static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+	static struct gbm_device *dev;
+	static struct gbm_device *(*create_device)(int);
+	static struct gbm_bo *(*bo_create)(struct gbm_device *, uint32_t,
+					   uint32_t, uint32_t, uint32_t);
+	static int (*bo_get_fd)(struct gbm_bo *);
+	static void (*bo_destroy)(struct gbm_bo *);
+	static int tried;
+	struct gbm_bo *bo;
+	int fd = -1;
+
+	pthread_mutex_lock(&lock);
+	if (!tried) {
+		void *lib = dlopen("libgbm.so.1", RTLD_NOW | RTLD_LOCAL);
+		char path[32];
+		int i, drm = -1;
+
+		tried = 1;
+		if (lib) {
+			create_device = dlsym(lib, "gbm_create_device");
+			bo_create = dlsym(lib, "gbm_bo_create");
+			bo_get_fd = dlsym(lib, "gbm_bo_get_fd");
+			bo_destroy = dlsym(lib, "gbm_bo_destroy");
+		}
+		for (i = 128; i < 136 && drm < 0 && create_device; i++) {
+			snprintf(path, sizeof(path), "/dev/dri/renderD%d", i);
+			drm = open(path, O_RDWR | O_CLOEXEC);
+		}
+		if (drm >= 0 && bo_create && bo_get_fd && bo_destroy)
+			dev = create_device(drm);
+		if (!dev && drm >= 0)
+			close(drm);
+	}
+	if (dev) {
+		bo = bo_create(dev, pitch, rows, VPU_GBM_FORMAT_R8,
+			       VPU_GBM_BO_USE_LINEAR);
+		if (bo) {
+			fd = bo_get_fd(bo);
+			bo_destroy(bo);
+		}
+	}
+	pthread_mutex_unlock(&lock);
+	return fd;
+}
+
 /* Fallback backing for when /dev/dma_heap/system is not accessible (root
  * only): an anonymous memfd is mmappable and readable by local tests and the
  * ffmpeg CPU readback path, but is NOT a DRM buffer and cannot be imported by
@@ -487,10 +548,16 @@ vpu_surfaces_alloc(struct vpu_surfaces *t, VASurfaceID id,
 		bfd = dma_heap_alloc(heap, size);
 		close(heap);
 	} else {
-		fprintf(stderr, "[surf] dma_heap unavailable (%s); "
-			"using memfd backing (not GPU-importable)\n",
-			strerror(errno));
-		bfd = memfd_alloc(size);
+		int heap_errno = errno;
+
+		bfd = gbm_alloc(surface_pitch(width, fourcc),
+				ALIGN_TO(height, 32) * 3 / 2);
+		if (bfd < 0) {
+			fprintf(stderr, "[surf] dma_heap unavailable (%s) and no "
+				"GBM render node; using memfd backing (not "
+				"GPU-importable)\n", strerror(heap_errno));
+			bfd = memfd_alloc(size);
+		}
 	}
 	if (bfd < 0) {
 		perror("[surf] alloc backing");
diff --git a/src/platform/qcom/iris.c b/src/platform/qcom/iris.c
index 4517b9d..68922e9 100644
--- a/src/platform/qcom/iris.c
+++ b/src/platform/qcom/iris.c
@@ -35,6 +35,36 @@ static int qcom_iris_supports(const char *device, enum vpu_codec_id codec,
 	       v4l2_dec_supports_capture_format(device, (unsigned int)format);
 }
 
+/* For a sandbox that lets a client open /dev/videoN but not list /dev or
+ * read sysfs (Firefox's RDD process): try the nodes in order and take the
+ * one whose QUERYCAP names the Iris decoder. Only the name check of the
+ * main path is skipped; the card name stands in for it. */
+static char *qcom_iris_probe_numbered(void)
+{
+	for (int n = 0; n < 64; n++) {
+		struct v4l2_capability cap = {0};
+		char path[32];
+		int ret, fd;
+
+		snprintf(path, sizeof(path), "/dev/video%d", n);
+		fd = open(path, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+		if (fd < 0)
+			continue;
+		do {
+			ret = ioctl(fd, VIDIOC_QUERYCAP, &cap);
+		} while (ret < 0 && errno == EINTR);
+		close(fd);
+		if (ret < 0 || strcmp((char *)cap.driver, "iris_driver") ||
+		    strcmp((char *)cap.card, "Iris Decoder"))
+			continue;
+		for (int codec = VPU_CODEC_H264; codec <= VPU_CODEC_VP9; codec++)
+			if (qcom_iris_supports(path, codec, VPU_PIXEL_FORMAT_NV12) ||
+			    qcom_iris_supports(path, codec, VPU_PIXEL_FORMAT_P010))
+				return strdup(path);
+	}
+	return NULL;
+}
+
 static char *qcom_iris_discover_device(void)
 {
 	glob_t devices = {0};
@@ -42,7 +72,7 @@ static char *qcom_iris_discover_device(void)
 
 	if (glob("/dev/video[0-9]*", 0, NULL, &devices)) {
 		globfree(&devices);
-		return NULL;
+		return qcom_iris_probe_numbered();
 	}
 	for (size_t i = 0; i < devices.gl_pathc; i++) {
 		struct v4l2_capability cap = {0};
@@ -93,7 +123,7 @@ static char *qcom_iris_discover_device(void)
 			break;
 	}
 	globfree(&devices);
-	return device;
+	return device ? device : qcom_iris_probe_numbered();
 }
 
 static void *qcom_iris_session_create(void)
-- 
2.56.1

