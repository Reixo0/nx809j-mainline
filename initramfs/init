#!/nx809j/busybox sh
# Bring-up initramfs for the NX809J.
# - Logs to the framebuffer console (tty0)
# - Brings up a USB NCM gadget at 172.16.42.1 with a raw shell on port 23 (nc)
# - Must never exit: init exiting panics the kernel

# No applet links exist yet: call busybox directly until --install made them
/nx809j/busybox mkdir -p /nx809j/bin
/nx809j/busybox --install -s /nx809j/bin
export PATH=/nx809j/bin

mkdir -p /proc /sys /dev /tmp /run
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t configfs configfs /sys/kernel/config
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
mount -t pstore pstore /sys/fs/pstore 2>/dev/null

# Everything we print goes to the screen *and* the kernel log (so it ends up
# in pstore for scripts/get-pstore.sh). A failed redirection on `exec` would
# end the script and panic the kernel, so check the devices first.
[ -c /dev/tty0 ] && exec </dev/tty0
mkfifo /tmp/log.fifo
( while IFS= read -r line; do
	[ -c /dev/tty0 ] && echo "$line" >/dev/tty0
	echo "nx809j-init: $line" >/dev/kmsg
  done </tmp/log.fifo ) &
exec >/tmp/log.fifo 2>&1
echo "=== NX809J mainline initramfs: $(uname -r) ==="

setup_usb() {
	G=/sys/kernel/config/usb_gadget/g1
	for i in $(seq 1 30); do
		UDC=$(ls /sys/class/udc 2>/dev/null | head -n1)
		[ -n "$UDC" ] && break
		sleep 1
	done
	if [ -z "$UDC" ]; then
		echo "!! no UDC appeared (dwc3/phy probe failed?)"
		return 1
	fi
	mkdir -p $G/strings/0x409 $G/configs/c.1/strings/0x409 $G/functions/ncm.usb0
	echo 0x18d1 > $G/idVendor
	echo 0xd001 > $G/idProduct
	echo "Nubia" > $G/strings/0x409/manufacturer
	echo "NX809J mainline" > $G/strings/0x409/product
	echo "nx809j" > $G/strings/0x409/serialnumber
	echo "NCM" > $G/configs/c.1/strings/0x409/configuration
	ln -s $G/functions/ncm.usb0 $G/configs/c.1/
	echo "$UDC" > $G/UDC

	ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up
	# Alpine's static busybox has no telnetd/udhcpd (they live in
	# busybox-extras). nc gives a raw shell instead; the host uses a static
	# 172.16.42.2/24 (scripts/phone-sh.py, or: nc 172.16.42.1 23).
	nc -lk -s 172.16.42.1 -p 23 -e /nx809j/bin/sh &
	echo ">> USB network up on $UDC: shell on 172.16.42.1:23 (nc)"
}

# nx809j.root=nbd: use the rootfs the PC serves over NBD (scripts/nbd-root.sh)
nbd_root() {
	NBD_SERVER=172.16.42.2
	NBD_PORT=10809
	echo ">> waiting for NBD server $NBD_SERVER:$NBD_PORT"
	for i in $(seq 1 60); do
		nc -z -w 1 $NBD_SERVER $NBD_PORT 2>/dev/null && break
		sleep 1
	done
	nbd-client $NBD_SERVER $NBD_PORT /dev/nbd0 || { echo "!! nbd-client failed"; return 1; }
	# nbd-client returns before the kernel has set the device size; mounting
	# right away reads an empty device
	for i in $(seq 1 50); do
		[ "$(cat /sys/block/nbd0/size 2>/dev/null)" -gt 0 ] 2>/dev/null && break
		sleep 0.1
	done
	switch_to /dev/nbd0
}

# nx809j.root=dm: rootfs in a logical partition inside super ("linux_root"),
# mapped by the kernel itself from the dm-mod.create= cmdline argument
dm_root() {
	for i in $(seq 1 100); do
		[ -b /dev/dm-0 ] && break
		sleep 0.1
	done
	[ -b /dev/dm-0 ] || { echo "!! /dev/dm-0 didn't show up (dm-mod.create= missing?)"; return 1; }
	switch_to /dev/dm-0
}

# Mount an ext4 rootfs from $1 and hand over to its init; returns on failure
switch_to() {
	mkdir -p /newroot
	for i in 1 2 3 4 5; do
		mount -t ext4 "$1" /newroot && break
		sleep 1
	done
	mountpoint -q /newroot || { echo "!! mounting $1 failed"; return 1; }
	if [ ! -x /newroot/sbin/init ]; then
		echo "!! no /sbin/init on $1"
		umount /newroot
		return 1
	fi
	echo ">> switching to the rootfs on $1"
	# The rootfs takes over from here; our nc shell lives in the initramfs
	# that switch_root deletes, so stop it. usb0 (and nbd-client) stay up.
	kill $(pidof nc) 2>/dev/null
	for m in /dev /proc /sys; do
		mkdir -p /newroot$m
		mount --move $m /newroot$m
	done
	exec switch_root -c /dev/console /newroot /sbin/init
}

ROOT_KIND=$(sed -n 's/.*nx809j\.root=\([a-z]*\).*/\1/p' /proc/cmdline)
if [ -n "$ROOT_KIND" ]; then
	setup_usb
	case $ROOT_KIND in
		nbd) nbd_root ;;
		dm) dm_root ;;
		*) echo "!! unknown nx809j.root=$ROOT_KIND" ;;
	esac
	echo "!! switching to the rootfs failed, staying in the initramfs"
	# switch_to may have killed the nc shell before failing
	pidof nc >/dev/null || nc -lk -s 172.16.42.1 -p 23 -e /nx809j/bin/sh &
else
	setup_usb &
fi

# Show the important bits on screen, then keep a shell on the console.
sleep 3
dmesg | grep -iE 'error|fail|unable|deferred|timeout' | tail -n 20
( sleep 15
  for r in /sys/class/remoteproc/remoteproc*; do
	[ -e "$r" ] && echo "rproc $(cat $r/name): $(cat $r/state)"
  done
  ls /sys/class/power_supply 2>/dev/null | sed 's/^/power_supply: /' ) &
while true; do
	setsid sh -c 'exec sh </dev/tty0 >/dev/tty0 2>&1'
	sleep 1
done
