+  {0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x76,0xCC,0xCC,0xCC,0xCC,0xCC,0xCC,0x7C,0x0C,0x0C,0x1E,0x00}, /* 'q' */
+  {0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xDC,0x66,0x60,0x60,0x60,0x60,0x60,0xF0,0x00,0x00,0x00,0x00}, /* 'r' */
+  {0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x7C,0xC6,0xC0,0x7C,0x06,0x06,0xC6,0x7C,0x00,0x00,0x00,0x00}, /* 's' */
+  {0x00,0x00,0x00,0x10,0x30,0x30,0x30,0xFC,0x30,0x30,0x30,0x30,0x30,0x36,0x1C,0x00,0x00,0x00,0x00}, /* 't' */
+  {0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xCC,0xCC,0xCC,0xCC,0xCC,0xCC,0xCC,0x76,0x00,0x00,0x00,0x00}, /* 'u' */
+  {0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xCC,0xCC,0xCC,0xCC,0xCC,0xCC,0x78,0x30,0x00,0x00,0x00,0x00}, /* 'v' */
+  {0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xC6,0xC6,0xC6,0xD6,0xD6,0xFE,0xEE,0x6C,0x00,0x00,0x00,0x00}, /* 'w' */
+  {0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xC6,0x6C,0x38,0x38,0x6C,0x6C,0xC6,0xC6,0x00,0x00,0x00,0x00}, /* 'x' */
+  {0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xC6,0xC6,0xC6,0xC6,0xC6,0xC6,0xC6,0x7E,0x06,0x0C,0xF8,0x00}, /* 'y' */
+  {0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xFE,0x86,0x0C,0x18,0x30,0x60,0xC0,0xFE,0x00,0x00,0x00,0x00}, /* 'z' */
+  {0x00,0x00,0x00,0x0E,0x18,0x18,0x18,0x18,0x30,0x18,0x18,0x18,0x18,0x18,0x0E,0x00,0x00,0x00,0x00}, /* '{' */
+  {0x00,0x00,0x00,0x18,0x18,0x18,0x18,0x18,0x18,0x18,0x18,0x18,0x18,0x18,0x18,0x00,0x00,0x00,0x00}, /* '|' */
+  {0x00,0x00,0x00,0xE0,0x30,0x30,0x30,0x30,0x18,0x30,0x30,0x30,0x30,0x30,0xE0,0x00,0x00,0x00,0x00}, /* '}' */
+  {0x00,0x00,0x00,0x76,0xDC,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00}, /* '~' */
+};
+
+/* EFI_BLACK .. EFI_WHITE, as GraphicsConsoleDxe draws them. */
+STATIC CONST EFI_GRAPHICS_OUTPUT_BLT_PIXEL mSfbBigPalette[16] = {
+  { 0x00, 0x00, 0x00, 0 }, { 0x98, 0x00, 0x00, 0 },
+  { 0x00, 0x98, 0x00, 0 }, { 0x98, 0x98, 0x00, 0 },
+  { 0x00, 0x00, 0x98, 0 }, { 0x98, 0x00, 0x98, 0 },
+  { 0x00, 0x98, 0x98, 0 }, { 0x98, 0x98, 0x98, 0 },
+  { 0x10, 0x10, 0x10, 0 }, { 0xff, 0x10, 0x10, 0 },
+  { 0x10, 0xff, 0x10, 0 }, { 0xff, 0xff, 0x10, 0 },
+  { 0x10, 0x10, 0xff, 0 }, { 0xf0, 0x10, 0xff, 0 },
+  { 0x10, 0xff, 0xff, 0 }, { 0xff, 0xff, 0xff, 0 },
+};
+/* Selected rows: white on red (Blue, Green, Red, Reserved). */
+STATIC CONST EFI_GRAPHICS_OUTPUT_BLT_PIXEL mSfbBigAccent = { 0x30, 0x20, 0xc8, 0 };
+
+STATIC EFI_GRAPHICS_OUTPUT_PROTOCOL    *mSfbBigGop;
+STATIC EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *mSfbBigFirmwareOut;
+STATIC EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL  mSfbBigOut;
+STATIC EFI_SIMPLE_TEXT_OUTPUT_MODE      mSfbBigMode;
+STATIC EFI_GRAPHICS_OUTPUT_BLT_PIXEL   *mSfbBigRow;
+STATIC UINTN mSfbBigRowPixels;
+STATIC UINTN mSfbBigScale, mSfbBigCellW, mSfbBigCellH;
+STATIC UINTN mSfbBigColumns, mSfbBigRows, mSfbBigLeft, mSfbBigTop;
+STATIC UINTN mSfbBigWidth, mSfbBigHeight;
+
+STATIC VOID
+SfbBigColors (OUT EFI_GRAPHICS_OUTPUT_BLT_PIXEL *Fg,
+              OUT EFI_GRAPHICS_OUTPUT_BLT_PIXEL *Bg)
+{
+  UINTN Attribute = (UINTN)mSfbBigMode.Attribute;
+  if (((Attribute >> 4) & 0x7) == EFI_LIGHTGRAY) {
+    *Fg = mSfbBigPalette[EFI_WHITE];
+    *Bg = mSfbBigAccent;
+    return;
+  }
+  *Fg = mSfbBigPalette[Attribute & 0x0f];
+  *Bg = mSfbBigPalette[(Attribute >> 4) & 0x7];
+}
+
+/* Draw Count characters at the cursor row, starting at the cursor column. */
+STATIC VOID
+SfbBigDrawRun (IN CONST CHAR16 *Text, IN UINTN Count)
+{
+  EFI_GRAPHICS_OUTPUT_BLT_PIXEL Fg, Bg;
+  UINTN Width = Count * mSfbBigCellW;
+  UINTN Index, Y, X;
+
+  if (Count == 0) { return; }
+  SfbBigColors (&Fg, &Bg);
+  for (Index = 0; Index < Count; Index++) {
+    CHAR16 Char = Text[Index];
+    CONST UINT8 *Glyph = mSfbBigGlyphs[(Char >= 0x20 && Char < 0x7f ? Char : L'?') - 0x20];
+    for (Y = 0; Y < mSfbBigCellH; Y++) {
+      UINT8 Bits = Glyph[Y / mSfbBigScale];
+      EFI_GRAPHICS_OUTPUT_BLT_PIXEL *Pixel = mSfbBigRow + Y * Width + Index * mSfbBigCellW;
+      for (X = 0; X < mSfbBigCellW; X++) {
+        Pixel[X] = (Bits & (0x80 >> (X / mSfbBigScale))) ? Fg : Bg;
+      }
+    }
+  }
+  mSfbBigGop->Blt (mSfbBigGop, mSfbBigRow, EfiBltBufferToVideo, 0, 0,
+                   mSfbBigLeft + (UINTN)mSfbBigMode.CursorColumn * mSfbBigCellW,
+                   mSfbBigTop + (UINTN)mSfbBigMode.CursorRow * mSfbBigCellH,
+                   Width, mSfbBigCellH, 0);
+}
+
+STATIC VOID
+SfbBigNewLine (VOID)
+{
+  EFI_GRAPHICS_OUTPUT_BLT_PIXEL Fg, Bg;
+  if ((UINTN)mSfbBigMode.CursorRow + 1 < mSfbBigRows) {
+    mSfbBigMode.CursorRow++;
+    return;
+  }
+  /* Scroll the grid up one row and blank the last one. */
+  SfbBigColors (&Fg, &Bg);
+  mSfbBigGop->Blt (mSfbBigGop, NULL, EfiBltVideoToVideo,
+                   mSfbBigLeft, mSfbBigTop + mSfbBigCellH, mSfbBigLeft, mSfbBigTop,
+                   mSfbBigColumns * mSfbBigCellW, (mSfbBigRows - 1) * mSfbBigCellH, 0);
+  mSfbBigGop->Blt (mSfbBigGop, &Bg, EfiBltVideoFill, 0, 0,
+                   mSfbBigLeft, mSfbBigTop + (mSfbBigRows - 1) * mSfbBigCellH,
+                   mSfbBigColumns * mSfbBigCellW, mSfbBigCellH, 0);
+}
+
+STATIC EFI_STATUS EFIAPI
+SfbBigOutputString (IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *This, IN CHAR16 *String)
+{
+  CONST CHAR16 *Run = String;
+  UINTN Count = 0;
+
+  for (; *String != L'\0'; String++) {
+    CHAR16 Char = *String;
+    if (Char == L'\r' || Char == L'\n' || Char == L'\b') {
+      SfbBigDrawRun (Run, Count);
+      mSfbBigMode.CursorColumn += (INT32)Count;
+      Count = 0;
+      if (Char == L'\r') {
+        mSfbBigMode.CursorColumn = 0;
+      } else if (Char == L'\n') {
+        SfbBigNewLine ();
+      } else if (mSfbBigMode.CursorColumn > 0) {
+        mSfbBigMode.CursorColumn--;
+      }
+      Run = String + 1;
+      continue;
+    }
+    Count++;
+    if ((UINTN)mSfbBigMode.CursorColumn + Count == mSfbBigColumns) {
+      SfbBigDrawRun (Run, Count);
+      mSfbBigMode.CursorColumn = 0;
+      SfbBigNewLine ();
+      Count = 0;
+      Run = String + 1;
+    }
+  }
+  SfbBigDrawRun (Run, Count);
+  mSfbBigMode.CursorColumn += (INT32)Count;
+  return EFI_SUCCESS;
+}
+
+STATIC EFI_STATUS EFIAPI
+SfbBigTestString (IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *This, IN CHAR16 *String)
+{
+  return EFI_SUCCESS;
+}
+
+STATIC EFI_STATUS EFIAPI
+SfbBigQueryMode (IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *This, IN UINTN ModeNumber,
+                 OUT UINTN *Columns, OUT UINTN *Rows)
+{
+  if (ModeNumber != 0) { return EFI_UNSUPPORTED; }
+  *Columns = mSfbBigColumns;
+  *Rows = mSfbBigRows;
+  return EFI_SUCCESS;
+}
+
+STATIC EFI_STATUS EFIAPI
+SfbBigClearScreen (IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *This)
+{
+  /* The whole panel, margins included, without the selection accent. */
+  EFI_GRAPHICS_OUTPUT_BLT_PIXEL Bg = mSfbBigPalette[((UINTN)mSfbBigMode.Attribute >> 4) & 0x7];
+  mSfbBigGop->Blt (mSfbBigGop, &Bg, EfiBltVideoFill, 0, 0, 0, 0,
+                   mSfbBigWidth, mSfbBigHeight, 0);
+  mSfbBigMode.CursorColumn = 0;
+  mSfbBigMode.CursorRow = 0;
+  return EFI_SUCCESS;
+}
+
+STATIC EFI_STATUS EFIAPI
+SfbBigSetMode (IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *This, IN UINTN ModeNumber)
+{
+  if (ModeNumber != 0) { return EFI_UNSUPPORTED; }
+  return SfbBigClearScreen (This);
+}
+
+STATIC EFI_STATUS EFIAPI
+SfbBigSetAttribute (IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *This, IN UINTN Attribute)
+{
+  if ((Attribute & ~(UINTN)0x7f) != 0) { return EFI_UNSUPPORTED; }
+  mSfbBigMode.Attribute = (INT32)Attribute;
+  return EFI_SUCCESS;
+}
+
+STATIC EFI_STATUS EFIAPI
+SfbBigReset (IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *This, IN BOOLEAN Extended)
+{
+  mSfbBigMode.Attribute = EFI_TEXT_ATTR (EFI_LIGHTGRAY, EFI_BLACK);
+  return SfbBigClearScreen (This);
+}
+
+STATIC EFI_STATUS EFIAPI
+SfbBigSetCursorPosition (IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *This,
+                         IN UINTN Column, IN UINTN Row)
+{
+  if (Column >= mSfbBigColumns || Row >= mSfbBigRows) { return EFI_UNSUPPORTED; }
+  mSfbBigMode.CursorColumn = (INT32)Column;
+  mSfbBigMode.CursorRow = (INT32)Row;
+  return EFI_SUCCESS;
+}
+
+/* The menus never show a cursor; remember the setting only. */
+STATIC EFI_STATUS EFIAPI
+SfbBigEnableCursor (IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *This, IN BOOLEAN Visible)
+{
+  mSfbBigMode.CursorVisible = Visible;
+  return EFI_SUCCESS;
+}
+
+STATIC VOID
+SfbBigSetConOut (IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *Out)
+{
+  gST->ConOut = Out;
+  gST->Hdr.CRC32 = 0;
+  gBS->CalculateCrc32 ((UINT8 *)&gST->Hdr, gST->Hdr.HeaderSize, &gST->Hdr.CRC32);
+}
+
+EFI_STATUS
+SfbBigConsoleInstall (VOID)
+{
+  EFI_GRAPHICS_OUTPUT_MODE_INFORMATION *Info;
+  EFI_STATUS Status;
+  UINTN Pixels;
+
+  if (gST->ConOut == &mSfbBigOut) { return EFI_SUCCESS; }
+  if (gST->ConOut == NULL) { return EFI_NOT_READY; }
+
+  Status = EFI_NOT_FOUND;
+  if (gST->ConsoleOutHandle != NULL) {
+    Status = gBS->HandleProtocol (gST->ConsoleOutHandle,
+                                  &gEfiGraphicsOutputProtocolGuid,
+                                  (VOID **)&mSfbBigGop);
+  }
+  if (EFI_ERROR (Status)) {
+    Status = gBS->LocateProtocol (&gEfiGraphicsOutputProtocolGuid, NULL,
+                                  (VOID **)&mSfbBigGop);
+  }
+  if (EFI_ERROR (Status) || mSfbBigGop == NULL || mSfbBigGop->Mode == NULL ||
+      mSfbBigGop->Mode->Info == NULL) {
+    DEBUG ((EFI_D_WARN, "SFB: big console: no GOP (%r)\n", Status));
+    return EFI_UNSUPPORTED;
+  }
+
+  /* Read the mode every time: a child image may have changed it. */
+  Info = mSfbBigGop->Mode->Info;
+  mSfbBigWidth = Info->HorizontalResolution;
+  mSfbBigHeight = Info->VerticalResolution;
+  mSfbBigScale = mSfbBigWidth / (SFB_BIG_GLYPH_W * SFB_BIG_MIN_COLUMNS);
+  if (mSfbBigScale < 2) {
+    return EFI_UNSUPPORTED;
+  }
+  mSfbBigCellW = SFB_BIG_GLYPH_W * mSfbBigScale;
+  mSfbBigCellH = SFB_BIG_GLYPH_H * mSfbBigScale;
+  mSfbBigColumns = mSfbBigWidth / mSfbBigCellW;
+  mSfbBigRows = mSfbBigHeight / mSfbBigCellH;
+  mSfbBigLeft = (mSfbBigWidth - mSfbBigColumns * mSfbBigCellW) / 2;
+  mSfbBigTop = (mSfbBigHeight - mSfbBigRows * mSfbBigCellH) / 2;
+
+  Pixels = mSfbBigColumns * mSfbBigCellW * mSfbBigCellH;
+  if (Pixels > mSfbBigRowPixels) {
+    if (mSfbBigRow != NULL) { FreePool (mSfbBigRow); }
+    mSfbBigRow = AllocatePool (Pixels * sizeof (*mSfbBigRow));
+    mSfbBigRowPixels = mSfbBigRow != NULL ? Pixels : 0;
+    if (mSfbBigRow == NULL) { return EFI_OUT_OF_RESOURCES; }
+  }
+
+  mSfbBigOut.Reset = SfbBigReset;
+  mSfbBigOut.OutputString = SfbBigOutputString;
+  mSfbBigOut.TestString = SfbBigTestString;
+  mSfbBigOut.QueryMode = SfbBigQueryMode;
+  mSfbBigOut.SetMode = SfbBigSetMode;
+  mSfbBigOut.SetAttribute = SfbBigSetAttribute;
+  mSfbBigOut.ClearScreen = SfbBigClearScreen;
+  mSfbBigOut.SetCursorPosition = SfbBigSetCursorPosition;
+  mSfbBigOut.EnableCursor = SfbBigEnableCursor;
+  mSfbBigOut.Mode = &mSfbBigMode;
+  mSfbBigMode.MaxMode = 1;
+  mSfbBigMode.Mode = 0;
+  mSfbBigMode.Attribute = gST->ConOut->Mode != NULL
+                            ? (gST->ConOut->Mode->Attribute & 0x7f)
+                            : EFI_TEXT_ATTR (EFI_LIGHTGRAY, EFI_BLACK);
+  mSfbBigMode.CursorColumn = 0;
+  mSfbBigMode.CursorRow = 0;
+  mSfbBigMode.CursorVisible = FALSE;
+
+  mSfbBigFirmwareOut = gST->ConOut;
+  SfbBigSetConOut (&mSfbBigOut);
+  DEBUG ((EFI_D_INFO, "SFB: big console %ux%u, scale %u, grid %ux%u\n",
+          (UINT32)mSfbBigWidth, (UINT32)mSfbBigHeight, (UINT32)mSfbBigScale,
+          (UINT32)mSfbBigColumns, (UINT32)mSfbBigRows));
+  return EFI_SUCCESS;
+}
+
+BOOLEAN
+SfbBigConsoleRemove (VOID)
+{
+  if (gST->ConOut != &mSfbBigOut) { return FALSE; }
+  SfbBigSetConOut (mSfbBigFirmwareOut);
+  return TRUE;
+}
diff --git a/submodules/uefi/edk2/QcomModulePkg/Application/LinuxLoader/SuperFbBigConsole.h b/submodules/uefi/edk2/QcomModulePkg/Application/LinuxLoader/SuperFbBigConsole.h
new file mode 100644
index 00000000..03bf4bbf
--- /dev/null
+++ b/submodules/uefi/edk2/QcomModulePkg/Application/LinuxLoader/SuperFbBigConsole.h
@@ -0,0 +1,25 @@
+/*
+ * Scaled text console for the boot menu and Super Fastboot screens.
+ *
+ * nx809j local change. The firmware console draws its 8x19 font 1:1, which is
+ * unreadably small on a 1216x2688 phone panel.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#ifndef __SUPER_FB_BIG_CONSOLE_H__
+#define __SUPER_FB_BIG_CONSOLE_H__
+
+#include <Uefi.h>
+
+/* Swap gST->ConOut for the scaled console. Idempotent; leaves the firmware
+ * console in place when there is no GOP or the panel is too small to scale. */
+EFI_STATUS
+SfbBigConsoleInstall (VOID);
+
+/* Put the firmware console back. Returns TRUE when the scaled one was in use,
+ * so a caller can reinstall it after a child image returns. */
+BOOLEAN
+SfbBigConsoleRemove (VOID);
+
+#endif
