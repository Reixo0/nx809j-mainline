@@ -32,7 +35,19 @@
 #include "iobuffer.h"
 #include "listener.h"
 
+#define APPS_STD_MAX_MAPPED 16
+
+/* A file the DSP reads through a buffer mapped on its side */
+struct apps_std_mapped {
+	int fd;
+	uint64_t vaddr;
+	uint64_t len;
+	void *buf;
+};
+
 struct apps_std_ctx {
+	int rpcfd;
+	struct apps_std_mapped mapped[APPS_STD_MAX_MAPPED];
 	int rootfd;
 	int adsp_avs_cfg_dirfd;
 	int adsp_library_dirfd;
@@ -351,7 +366,131 @@ static uint32_t apps_std_stat(void *data,
 	return 0;
 }
 
-struct fastrpc_interface *fastrpc_apps_std_init(struct hexagonfs_dirent *root)
+static uint32_t apps_std_fclose_fd(void *data,
+				   const struct fastrpc_io_buffer *inbufs,
+				   struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	int fd = *(const uint32_t *) ((const char *) inbufs[0].p +
+				      (inbufs[0].s - sizeof(uint32_t)));
+	struct apps_std_mapped *m;
+	struct fastrpc_mem_unmap unmap = { 0 };
+	int i, ret;
+
+	for (i = 0; i < APPS_STD_MAX_MAPPED; i++) {
+		m = &ctx->mapped[i];
+		if (m->buf == NULL || m->fd != fd)
+			continue;
+
+		unmap.fd = m->fd;
+		unmap.vaddr = m->vaddr;
+		unmap.length = m->len;
+		ret = ioctl(ctx->rpcfd, FASTRPC_IOCTL_MEM_UNMAP, &unmap);
+		if (ret)
+			perror("Could not unmap file buffer");
+		munmap(m->buf, m->len);
+		ioctl(ctx->rpcfd, FASTRPC_IOCTL_FREE_DMA_BUFF, &m->fd);
+		m->buf = NULL;
+		return 0;
+	}
+
+	fprintf(stderr, "fclose_fd: unknown fd %d\n", fd);
+	return AEE_EBADPARM;
+}
+
+/* Reads a file into a buffer, maps that on the DSP and answers with its fd. */
+static uint32_t apps_std_fopen_with_env_fd(void *data,
+					   const struct fastrpc_io_buffer *inbufs,
+					   struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	struct {
+		uint32_t fd;
+		uint32_t len;
+	} *out = outbufs[0].p;
+	const char *env = inbufs[1].p, *name = inbufs[3].p;
+	struct fastrpc_alloc_dma_buf dmabuf = { 0 };
+	struct fastrpc_mem_map map = { 0 };
+	struct apps_std_mapped *m = NULL;
+	struct stat stats;
+	size_t done = 0;
+	long page_size = sysconf(_SC_PAGE_SIZE);
+	int i, dirfd, file;
+	void *buf;
+
+	if (strcmp(env, "ADSP_LIBRARY_PATH")) {
+		fprintf(stderr, "Unknown search directory %s\n", env);
+		return AEE_EBADPARM;
+	}
+	dirfd = ctx->adsp_library_dirfd;
+	if (dirfd < 0)
+		return AEE_EFAILED;
+	if (!strncmp(name, "./", 2))
+		name += 2;
+
+	for (i = 0; i < APPS_STD_MAX_MAPPED; i++)
+		if (ctx->mapped[i].buf == NULL) {
+			m = &ctx->mapped[i];
+			break;
+		}
+	if (m == NULL)
+		return AEE_ENOMEMORY;
+
+	file = hexagonfs_openat(ctx->fds, ctx->rootfd, dirfd, name);
+	if (file < 0) {
+		fprintf(stderr, "Could not open %s: %s\n", name, strerror(-file));
+		return AEE_EFAILED;
+	}
+	if (hexagonfs_fstat(ctx->fds, file, &stats) < 0)
+		goto err_close;
+
+	dmabuf.size = (stats.st_size + page_size - 1) & ~(page_size - 1);
+	if (ioctl(ctx->rpcfd, FASTRPC_IOCTL_ALLOC_DMA_BUFF, &dmabuf)) {
+		perror("Could not allocate file buffer");
+		goto err_close;
+	}
+	buf = mmap(NULL, dmabuf.size, PROT_READ | PROT_WRITE, MAP_SHARED, dmabuf.fd, 0);
+	if (buf == MAP_FAILED)
+		goto err_free;
+
+	while (done < (size_t) stats.st_size) {
+		ssize_t got = hexagonfs_read(ctx->fds, file, stats.st_size - done,
+					     (char *) buf + done);
+
+		if (got <= 0)
+			goto err_unmap;
+		done += got;
+	}
+
+	map.fd = dmabuf.fd;
+	map.flags = FASTRPC_MAP_FD;
+	map.vaddrin = (uint64_t) (uintptr_t) buf;
+	map.length = dmabuf.size;
+	if (ioctl(ctx->rpcfd, FASTRPC_IOCTL_MEM_MAP, &map)) {
+		perror("Could not map file buffer");
+		goto err_unmap;
+	}
+
+	hexagonfs_close(ctx->fds, file);
+	m->fd = dmabuf.fd;
+	m->vaddr = map.vaddrout;
+	m->len = dmabuf.size;
+	m->buf = buf;
+	out->fd = dmabuf.fd;
+	out->len = stats.st_size;
+	fprintf(stderr, "fopen_fd(%s) -> fd %d, %zu bytes\n", name, m->fd, done);
+	return 0;
+
+err_unmap:
+	munmap(buf, dmabuf.size);
+err_free:
+	ioctl(ctx->rpcfd, FASTRPC_IOCTL_FREE_DMA_BUFF, &dmabuf.fd);
+err_close:
+	hexagonfs_close(ctx->fds, file);
+	return AEE_EFAILED;
+}
+
+struct fastrpc_interface *fastrpc_apps_std_init(struct hexagonfs_dirent *root, int rpcfd)
 {
 	struct fastrpc_interface *iface;
 	struct apps_std_ctx *ctx;
@@ -366,6 +505,7 @@ struct fastrpc_interface *fastrpc_apps_std_init(struct hexagonfs_dirent *root)
 
 	memcpy(iface, &apps_std_interface, sizeof(struct fastrpc_interface));
 
+	ctx->rpcfd = rpcfd;
 	ctx->rootfd = hexagonfs_open_root(ctx->fds, root);
 	if (ctx->rootfd < 0)
 		goto err_free_ctx;
@@ -465,10 +605,21 @@ static const struct fastrpc_function_impl apps_std_procs[] = {
 		.def = &apps_std_stat_def,
 		.impl = apps_std_stat,
 	},
+	{ .def = NULL, .impl = NULL, },
+	{ .def = NULL, .impl = NULL, },
+	{ .def = NULL, .impl = NULL, },
+	{
+		.def = &apps_std_fclose_fd_def,
+		.impl = apps_std_fclose_fd,
+	},
+	{
+		.def = &apps_std_fopen_with_env_fd_def,
+		.impl = apps_std_fopen_with_env_fd,
+	},
 };
 
 const struct fastrpc_interface apps_std_interface = {
 	.name = "apps_std",
-	.n_procs = 32,
+	.n_procs = 37,
 	.procs = apps_std_procs,
 };
