# NX809J: Qualcomm A/B slot control; nx809j-mark-boot-successful.service
# runs `qbootctl -m a` every boot, as Android does
pkgname=qbootctl
pkgver=0.2.2
pkgrel=1
pkgdesc='Qualcomm bootloader A/B slot control'
arch=(aarch64)
url='https://github.com/linux-msm/qbootctl'
license=(GPL-3.0-only)
depends=(glibc)
makedepends=(meson)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('e66b361f86fac413f6a96974b4045a1fbc385f9eb6cee7fa8a26e0ca77c74a51')

build() {
  arch-meson $pkgname-$pkgver build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
