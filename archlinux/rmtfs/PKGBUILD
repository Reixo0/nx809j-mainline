# NX809J: Qualcomm remote file system service (linux-msm). The NX809J
# drop-in in device/rootfs makes it serve copies in /var/lib/rmtfs.
pkgname=rmtfs
pkgver=1.3
pkgrel=1
pkgdesc='Qualcomm remote file system service'
arch=(aarch64)
url='https://github.com/linux-msm/rmtfs'
license=(BSD-3-Clause)
depends=(qrtr systemd-libs)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('4b6c398806a1046e2256a685d592833de0f37b7245b8adc4797e1791f0e117ee')

build() {
  cd $pkgname-$pkgver
  # The generated QMI code is shipped; don't regenerate it (needs qmic)
  touch qmi_rmtfs.c
  make prefix=/usr
}

package() {
  cd $pkgname-$pkgver
  make prefix=/usr DESTDIR="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
