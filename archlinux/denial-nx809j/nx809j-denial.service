[Unit]
Description=Denial on the RedMagic 11 Pro
After=systemd-logind.service systemd-user-sessions.service dbus.service systemd-udev-trigger.service
# The session owns tty1 like a login does: logind only places a session on
# seat0, which has VTs, when it comes with one.
Conflicts=getty@tty1.service
After=getty@tty1.service
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
Type=simple
User=alarm
Group=alarm
SupplementaryGroups=audio input render video
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
WorkingDirectory=%h
Environment=HOME=%h
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_CLASS=user
Environment=XDG_SESSION_DESKTOP=Denial
Environment=XDG_CURRENT_DESKTOP=Denial
Environment=LIBSEAT_BACKEND=logind
Environment=RUST_LOG=deniald=info,smithay=warn
Environment=DENIAL_SHELL_PROFILE=mobile
# Denial writes its output configuration atomically into this directory.
StateDirectory=nx809j
StateDirectoryMode=0755
ExecStartPre=+/bin/sh -c 'test -e /var/lib/nx809j/outputs.conf || install -o %u -g %g -m 0644 /usr/share/nx809j/outputs.conf /var/lib/nx809j/'
# The image sets its user in a drop-in: see scripts/make-arch-image.sh
ExecStart=/usr/lib/denial/native/deniald --device /dev/dri/by-path/platform-9801000.display-controller-card --render-device /dev/dri/by-path/platform-9801000.display-controller-render --output-config /var/lib/nx809j/outputs.conf --wayland --flutter-bundle /usr/lib/denial/shell
Environment=DENIAL_SETTINGS_BINARY=/usr/lib/denial/settings/denial-settings
AmbientCapabilities=CAP_SYS_NICE
LimitRTPRIO=10
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
