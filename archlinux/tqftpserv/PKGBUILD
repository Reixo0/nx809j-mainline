# NX809J: TFTP server over QRTR, serves firmware files to the modem (linux-msm)
pkgname=tqftpserv
pkgver=1.3
pkgrel=1
pkgdesc='Trivial File Transfer Protocol server over QRTR'
arch=(aarch64)
url='https://github.com/linux-msm/tqftpserv'
license=(BSD-3-Clause)
depends=(qrtr zstd xz)
makedepends=(meson)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('87a3845e8f47b42f31d8aaad04c5e0707e391b3954d096aeff6f0a03467dc33f')

build() {
  arch-meson $pkgname-$pkgver build -Dsystemd-unit-prefix=/usr/lib/systemd/system
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 $pkgname-$pkgver/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
