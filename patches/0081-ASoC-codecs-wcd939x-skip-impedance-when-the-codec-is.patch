From 0387cb50fff0d7d576c36344c364b2bd9f4888bd Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Sat, 3 Oct 2026 11:44:32 +0300
Subject: [PATCH 081/162] ASoC: codecs: wcd939x: skip impedance when the codec
 is unreadable

The impedance measurement polls the volatile MBHC result registers. When
they cannot be read (cache-only regmap while the TX SoundWire device is
suspended or not attached), each failed read returns an error code that
is then used as register content, so the ramp-down loop never sees a
zero result and runs its full 900 iterations for each channel: 3600
"ASoC error (-16)" lines for one plug event, and a meaningless result.

Read one result register through the regmap first and report no
impedance if that fails.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sound/soc/codecs/wcd939x.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/sound/soc/codecs/wcd939x.c b/sound/soc/codecs/wcd939x.c
index 6d96b39328f8..3bffd5abd09d 100644
--- a/sound/soc/codecs/wcd939x.c
+++ b/sound/soc/codecs/wcd939x.c
@@ -2168,6 +2168,17 @@ static void wcd939x_wcd_mbhc_calc_impedance(struct snd_soc_component *component,
 	bool is_fsm_disable = false;
 	s32 z1l, z1r, z1ls;
 
+	/*
+	 * The result registers are volatile: while the TX device is
+	 * suspended or not attached the regmap is cache-only and every read
+	 * fails, which would run the measurement loops to their limits.
+	 */
+	if (regmap_read(wcd939x->regmap, WCD939X_ANA_MBHC_RESULT_2, &reg0)) {
+		dev_dbg(component->dev, "impedance not measured: MBHC result unreadable\n");
+		*zl = *zr = 0;
+		return;
+	}
+
 	reg0 = snd_soc_component_read(component, WCD939X_ANA_MBHC_BTN5);
 	reg1 = snd_soc_component_read(component, WCD939X_ANA_MBHC_BTN6);
 	reg2 = snd_soc_component_read(component, WCD939X_ANA_MBHC_BTN7);
