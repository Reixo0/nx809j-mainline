From f8e131424fd4b5372a0036125de9833ba86734c2 Mon Sep 17 00:00:00 2001
From: Doctor Logix <doctor.logix@gmail.com>
Date: Fri, 30 Oct 2026 18:43:11 +0100
Subject: [PATCH] drm/panel: raydium-rm692h5: set the idle level before
 entering idle mode

The ambient level went out after the idle mode settle, so the panel
showed idle mode at the old level for a moment and flashed brighter.
Send it right before the switch.

(cherry picked from commit 4ed5a80feab1250c35c301c75edf77afd8fc1780)
---
 drivers/gpu/drm/panel/panel-raydium-rm692h5.c | 16 +++++++++++-----
 1 file changed, 11 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-raydium-rm692h5.c b/drivers/gpu/drm/panel/panel-raydium-rm692h5.c
index b2f7ec9c953a..b2949ea74fad 100644
--- a/drivers/gpu/drm/panel/panel-raydium-rm692h5.c
+++ b/drivers/gpu/drm/panel/panel-raydium-rm692h5.c
@@ -92,10 +92,14 @@ static inline struct rm692h5 *to_rm692h5(struct drm_panel *panel)
 	return container_of(panel, struct rm692h5, panel);
 }
 
-static void rm692h5_idle_on(struct mipi_dsi_multi_context *dsi_ctx)
+/* The level goes out with the switch: idle mode at the old one flashes. */
+static void rm692h5_idle_on(struct mipi_dsi_multi_context *dsi_ctx, u16 level)
 {
+	u8 set_level[] = { MIPI_DCS_SET_DISPLAY_BRIGHTNESS, level >> 8, level & 0xff };
+
 	dsi_ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xfe, 0x00);
+	mipi_dsi_dcs_write_buffer_multi(dsi_ctx, set_level, sizeof(set_level));
 	mipi_dsi_dcs_write_buffer_multi(dsi_ctx, (u8[]){ MIPI_DCS_ENTER_IDLE_MODE }, 1);
 	mipi_dsi_msleep(dsi_ctx, idle_settle_ms);
 }
@@ -126,7 +130,8 @@ static int rm692h5_set_idle(const char *val, const struct kernel_param *kp)
 
 	dsi_ctx = (struct mipi_dsi_multi_context){ .dsi = ctx->dsi };
 	if (on) {
-		rm692h5_idle_on(&dsi_ctx);
+		rm692h5_idle_on(&dsi_ctx, min_t(u32, ctx->panel.backlight->props.brightness,
+						RM692H5_MAX_BRIGHTNESS));
 	} else {
 		rm692h5_idle_off(&dsi_ctx);
 		if (!dsi_ctx.accum_err)
@@ -697,9 +702,10 @@ static int rm692h5_disable(struct drm_panel *panel)
 		u16 level = min_t(uint, ambient_brightness, RM692H5_MAX_BRIGHTNESS);
 		u8 set_level[] = { MIPI_DCS_SET_DISPLAY_BRIGHTNESS, level >> 8, level & 0xff };
 
-		if (!ctx->idle)
-			rm692h5_idle_on(&dsi_ctx);
-		mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, set_level, sizeof(set_level));
+		if (ctx->idle)
+			mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, set_level, sizeof(set_level));
+		else
+			rm692h5_idle_on(&dsi_ctx, level);
 		ctx->retained = !dsi_ctx.accum_err;
 		ctx->idle = ctx->retained;
 		dev_info(&ctx->dsi->dev, "blank into idle mode at 0x%04x: %d\n",
-- 
2.56.0

