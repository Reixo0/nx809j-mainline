From 195d048f6e415c8f3bd7a0cc0251dfae9f56fa32 Mon Sep 17 00:00:00 2001
From: Victor Fuentes <victor@vlinkz.dev>
Date: Wed, 23 Sep 2026 02:50:17 -0700
Subject: [PATCH 069/165] ASoC: qcom: q6apm: Send commands from the APM's GPR
 service

The Kaanapali ADSP firmware only answers packets from the port the
client is registered on.

Signed-off-by: Victor Fuentes <victor@vlinkz.dev>
---
 sound/soc/qcom/qdsp6/q6apm.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index b6b1ef6833b3..1e07c42e3d72 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -35,6 +35,7 @@ int q6apm_send_cmd_sync(struct q6apm *apm, struct gpr_pkt *pkt,
 	gpr_device_t *gdev = apm->gdev;
 
 	pkt->hdr.dest_domain = audioreach_gpr_dest_domain(gdev);
+	pkt->hdr.src_port = gdev->svc_id;
 
 	return audioreach_send_cmd_sync(&gdev->dev, gdev, &apm->result, &apm->lock,
 					NULL, &apm->wait, pkt, rsp_opcode);
-- 
