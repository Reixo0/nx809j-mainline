From 8fc0cde0b15cba9d0c4d1db5f5720acca15c9b0d Mon Sep 17 00:00:00 2001
From: Reixo <125610085+Reixo0@users.noreply.github.com>
Date: Mon, 26 Oct 2026 17:12:32 +0100
Subject: [PATCH 117/121] net: ipa: halt modem channels after the modem stops

The downstream driver halts the GSI channels of every modem endpoint
once the modem has shut down (IPA v4.0 and later), so they are idle
before the modem starts again. The upstream driver only does this for
IPA v4.2, where the AP allocates the modem channels.

Add an optional mask of modem channels to the IPA data, and halt those
channels when the modem goes offline.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/net/ipa/gsi.c       | 15 +++++++++++++++
 drivers/net/ipa/gsi.h       | 10 ++++++++++
 drivers/net/ipa/ipa.h       |  2 ++
 drivers/net/ipa/ipa_data.h  |  2 ++
 drivers/net/ipa/ipa_main.c  |  1 +
 drivers/net/ipa/ipa_modem.c | 18 ++++++++++++++++++
 6 files changed, 48 insertions(+)

diff --git a/drivers/net/ipa/gsi.c b/drivers/net/ipa/gsi.c
index 624649484..c95a2e96a 100644
--- a/drivers/net/ipa/gsi.c
+++ b/drivers/net/ipa/gsi.c
@@ -1837,6 +1837,21 @@ static void gsi_modem_channel_halt(struct gsi *gsi, u32 channel_id)
 			ret, channel_id);
 }
 
+/* Halt the modem GSI channels in a mask, after the modem has stopped */
+void gsi_modem_channels_halt(struct gsi *gsi, u32 mask)
+{
+	mutex_lock(&gsi->mutex);
+
+	while (mask) {
+		u32 channel_id = __ffs(mask);
+
+		mask ^= BIT(channel_id);
+		gsi_modem_channel_halt(gsi, channel_id);
+	}
+
+	mutex_unlock(&gsi->mutex);
+}
+
 /* Enable or disable flow control for a modem GSI TX channel (IPA v4.2+) */
 void
 gsi_modem_channel_flow_control(struct gsi *gsi, u32 channel_id, bool enable)
diff --git a/drivers/net/ipa/gsi.h b/drivers/net/ipa/gsi.h
index 9d8e05d95..fe1b67a73 100644
--- a/drivers/net/ipa/gsi.h
+++ b/drivers/net/ipa/gsi.h
@@ -198,6 +198,16 @@ int gsi_channel_start(struct gsi *gsi, u32 channel_id);
  */
 int gsi_channel_stop(struct gsi *gsi, u32 channel_id);
 
+/**
+ * gsi_modem_channels_halt() - Halt modem GSI channels
+ * @gsi:	GSI pointer
+ * @mask:	Bitmap of modem channel IDs to halt
+ *
+ * Some modems leave their channels running when they stop, and need
+ * them halted before they are started again.
+ */
+void gsi_modem_channels_halt(struct gsi *gsi, u32 mask);
+
 /**
  * gsi_modem_channel_flow_control() - Set channel flow control state (IPA v4.2+)
  * @gsi:	GSI pointer returned by gsi_setup()
diff --git a/drivers/net/ipa/ipa.h b/drivers/net/ipa/ipa.h
index 3a0168f0e..e7a379334 100644
--- a/drivers/net/ipa/ipa.h
+++ b/drivers/net/ipa/ipa.h
@@ -35,6 +35,7 @@ struct ipa_smp2p;
  * @table_virt:		Virtual address of filter/route table content
  * @route_count:	Total number of entries in a routing table
  * @modem_route_count:	Number of modem entries in a routing table
+ * @modem_halt_channels: Modem GSI channels to halt after the modem stops
  * @filter_count:	Maximum number of entries in a filter table
  * @interrupt:		IPA Interrupt information
  * @uc_powered:		true if power is active by proxy for microcontroller
@@ -87,6 +88,7 @@ struct ipa {
 	__le64 *table_virt;
 	u32 route_count;
 	u32 modem_route_count;
+	u32 modem_halt_channels;
 	u32 filter_count;
 
 	struct ipa_interrupt *interrupt;
diff --git a/drivers/net/ipa/ipa_data.h b/drivers/net/ipa/ipa_data.h
index 3eb9dc2ce..231d53291 100644
--- a/drivers/net/ipa/ipa_data.h
+++ b/drivers/net/ipa/ipa_data.h
@@ -226,6 +226,7 @@ struct ipa_power_data {
  * @qsb_count:		number of entries in the qsb_data array
  * @qsb_data:		Qualcomm System Bus configuration data
  * @modem_route_count:	number of modem entries in a routing table
+ * @modem_halt_channels: modem GSI channels to halt after the modem stops
  * @endpoint_count:	number of entries in the endpoint_data array
  * @endpoint_data:	IPA endpoint/GSI channel data
  * @resource_data:	IPA resource configuration data
@@ -238,6 +239,7 @@ struct ipa_data {
 	u32 qsb_count;		/* number of entries in qsb_data[] */
 	const struct ipa_qsb_data *qsb_data;
 	u32 modem_route_count;
+	u32 modem_halt_channels;
 	u32 endpoint_count;	/* number of entries in endpoint_data[] */
 	const struct ipa_gsi_endpoint_data *endpoint_data;
 	const struct ipa_resource_data *resource_data;
diff --git a/drivers/net/ipa/ipa_main.c b/drivers/net/ipa/ipa_main.c
index 14ac2d2fa..2b47ed5bd 100644
--- a/drivers/net/ipa/ipa_main.c
+++ b/drivers/net/ipa/ipa_main.c
@@ -849,6 +849,7 @@ static int ipa_probe(struct platform_device *pdev)
 	ipa->power = power;
 	ipa->version = data->version;
 	ipa->modem_route_count = data->modem_route_count;
+	ipa->modem_halt_channels = data->modem_halt_channels;
 	init_completion(&ipa->completion);
 
 	ret = ipa_reg_init(ipa, pdev);
diff --git a/drivers/net/ipa/ipa_modem.c b/drivers/net/ipa/ipa_modem.c
index 9466f3e11..d25d79e45 100644
--- a/drivers/net/ipa/ipa_modem.c
+++ b/drivers/net/ipa/ipa_modem.c
@@ -448,6 +448,22 @@ static void ipa_modem_crashed(struct ipa *ipa)
 	(void)pm_runtime_put_autosuspend(dev);
 }
 
+/* Halt the channels the modem left running before it is started again */
+static void ipa_modem_halt_channels(struct ipa *ipa)
+{
+	struct device *dev = ipa->dev;
+	int ret;
+
+	ret = pm_runtime_get_sync(dev);
+	if (ret < 0)
+		dev_err(dev, "error %d getting power to halt modem channels\n",
+			ret);
+	else
+		gsi_modem_channels_halt(&ipa->gsi, ipa->modem_halt_channels);
+
+	(void)pm_runtime_put_autosuspend(dev);
+}
+
 static int ipa_modem_notify(struct notifier_block *nb, unsigned long action,
 			    void *data)
 {
@@ -476,6 +492,8 @@ static int ipa_modem_notify(struct notifier_block *nb, unsigned long action,
 
 	case QCOM_SSR_AFTER_SHUTDOWN:
 		dev_info(dev, "received modem offline event\n");
+		if (ipa->setup_complete && ipa->modem_halt_channels)
+			ipa_modem_halt_channels(ipa);
 		break;
 
 	default:
