 };
 
+enum csid_phy_sel {
+	CSID_PHY_SEL_DPHY = 0,
+	CSID_PHY_SEL_CPHY = 1
+};
+
 struct csid_format_info {
 	u32 code;
 	u8 data_type;
@@ -70,6 +75,7 @@ struct csid_phy_config {
 	u32 lane_assign;
 	u32 en_vc;
