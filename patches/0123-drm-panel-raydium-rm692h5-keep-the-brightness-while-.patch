From de620c58000e77373b440c10d66996db58dc0ac9 Mon Sep 17 00:00:00 2001
From: Reixo <125610085+Reixo0@users.noreply.github.com>
Date: Tue, 27 Oct 2026 17:06:16 +0100
Subject: [PATCH] drm/panel: raydium-rm692h5: keep the brightness while the
 panel is off

Writing the brightness before the panel is prepared fails with -EINVAL,
as the DSI link is down. systemd-backlight restores the saved level as
soon as the backlight device appears, which with DRM_MSM as a module is
before the first modeset, and the service failed. Keep the level
instead: drm_panel_enable() makes the backlight core send it again.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/panel/panel-raydium-rm692h5.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-raydium-rm692h5.c b/drivers/gpu/drm/panel/panel-raydium-rm692h5.c
index bcdd8e5b776e..9aa80e0e3d95 100644
--- a/drivers/gpu/drm/panel/panel-raydium-rm692h5.c
+++ b/drivers/gpu/drm/panel/panel-raydium-rm692h5.c
@@ -563,9 +563,17 @@ static const struct drm_panel_funcs rm692h5_panel_funcs = {
 static int rm692h5_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct rm692h5 *ctx = mipi_dsi_get_drvdata(dsi);
 	u16 brightness = backlight_get_brightness(bl);
 	int ret;
 
+	/*
+	 * The DSI link is down while the panel is off. Keep the level: the
+	 * backlight core sends it again when drm_panel_enable() enables it.
+	 */
+	if (!ctx->panel.prepared)
+		return 0;
+
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
 	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
-- 
2.56.0

