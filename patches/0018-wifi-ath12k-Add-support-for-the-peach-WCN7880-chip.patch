+		/* PEACH_PCIE_REMAP_BAR_CTRL_OFFSET in downstream cnss2 */
+		ab_pci->window_reg_addr = WINDOW_REG_ADDRESS_QCC2072;
+		ath12k_wifi7_pci_read_hw_version(ab, &soc_hw_version_major,
+						 &soc_hw_version_minor);
+		dev_info(&pdev->dev, "peach soc hw version %u.%u\n",
+			 soc_hw_version_major, soc_hw_version_minor);
+		ab->target_mem_mode = ATH12K_QMI_MEMORY_MODE_DEFAULT;
+		/* Android only ships the "20" firmware files for this chip */
+		ab->hw_rev = ATH12K_HW_PEACH_HW20;
+		break;
 	default:
 		dev_err(&pdev->dev, "Unknown Wi-Fi 7 PCI device found: 0x%x\n",
