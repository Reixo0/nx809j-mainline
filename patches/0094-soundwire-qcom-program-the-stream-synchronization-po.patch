From e7eddf6111a86c2b345e2ab92166df04da0006ba Mon Sep 17 00:00:00 2001
From: Reixo <125610085+Reixo0@users.noreply.github.com>
Date: Sun, 25 Oct 2026 18:45:48 +0100
Subject: [PATCH 094/162] soundwire: qcom: program the stream synchronization
 point period

The frame control register of v2 controllers has an SSP period field
(bits 23:16): frames between stream synchronization points, minus one.
Mainline leaves it at 0. PDM ports don't care, but PCM data ports need
it to find their sample boundaries: the WCD9395 HIFI_PCM headphone port
on Kaanapali stays silent without it.

Program it as the downstream driver does, for a 4 kHz SSP rate. With
the default 9.6 MHz clock and a 50x16 frame that is 5, the value the
stock firmware leaves in the register.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/soundwire/qcom.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/drivers/soundwire/qcom.c b/drivers/soundwire/qcom.c
index c9cb8d52fe69..b74633b94562 100644
--- a/drivers/soundwire/qcom.c
+++ b/drivers/soundwire/qcom.c
@@ -95,6 +95,9 @@
 #define SWRM_MCP_FRAME_CTRL_BANK_ADDR(m)		(0x101C + 0x40 * (m))
 #define SWRM_MCP_FRAME_CTRL_BANK_COL_CTRL_BMSK			GENMASK(2, 0)
 #define SWRM_MCP_FRAME_CTRL_BANK_ROW_CTRL_BMSK			GENMASK(7, 3)
+#define SWRM_MCP_FRAME_CTRL_BANK_SSP_PERIOD_BMSK		GENMASK(23, 16)
+/* Stream synchronization point rate */
+#define SWRM_SSP_RATE						4000
 #define SWRM_MCP_BUS_CTRL					0x1044
 #define SWRM_MCP_BUS_CLK_START					BIT(1)
 #define SWRM_MCP_CFG_ADDR					0x1048
@@ -1093,6 +1096,19 @@ static int qcom_swrm_pre_bank_switch(struct sdw_bus *bus)
 	u32p_replace_bits(&val, ctrl->cols_index, SWRM_MCP_FRAME_CTRL_BANK_COL_CTRL_BMSK);
 	u32p_replace_bits(&val, ctrl->rows_index, SWRM_MCP_FRAME_CTRL_BANK_ROW_CTRL_BMSK);
 
+	/*
+	 * Frames between stream synchronization points, minus one. PCM data
+	 * ports need it to find their sample boundaries; the downstream
+	 * driver programs it the same way.
+	 */
+	if (ctrl->version >= SWRM_VERSION_2_0_0) {
+		u32 frame = bus->params.row * bus->params.col;
+		u32 ssp = frame ? bus->params.curr_dr_freq / (frame * SWRM_SSP_RATE) : 1;
+
+		u32p_replace_bits(&val, max(ssp, 1U) - 1,
+				  SWRM_MCP_FRAME_CTRL_BANK_SSP_PERIOD_BMSK);
+	}
+
 	return ctrl->reg_write(ctrl, reg, val);
 }
 
