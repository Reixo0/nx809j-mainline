From 2d4f53e3fd72d82325cb0fbdf7d5c582cbf46bbb Mon Sep 17 00:00:00 2001
From: Doctor Logix <doctor.logix@gmail.com>
Date: Wed, 28 Oct 2026 17:08:40 +0100
Subject: [PATCH 153/165] phy: qcom: mipi-csi2: add C-PHY for Kaanapali

The endpoint bus-type now picks the mode: C-PHY endpoints take up
to three trios, and set_mode only accepts the mode the endpoint gave.

The core and timer clocks run at the symbol rate over 7 for C-PHY
(two bytes per trio clock) and at the link frequency over 4 for
D-PHY, as before.

The Kaanapali C-PHY sequence and rate table are the vendor CSIPHY
v2.4 settings: hold the PHY in reset, set the common registers and
the trio enables, write the per-trio lane table and the rate
dependent values, then release with the 3-phase enables. The settle
count is 60 ns of the 400 MHz timer less 10, which is the 14 the
stock tables use. SoCs without C-PHY tables return -EOPNOTSUPP.

Tested on the nx809j main camera, an OV50E40 on three trios at
2816 Msym/s: 4096x3072 frames at 30.00 fps.

(cherry picked from commit cb84832dac2104cc9026188c43b703be7fdf8a00)
---
 .../qualcomm/phy-qcom-mipi-csi2-3ph-dphy.c    | 148 ++++++++++++++++++
 .../phy/qualcomm/phy-qcom-mipi-csi2-core.c    |  52 ++++--
 drivers/phy/qualcomm/phy-qcom-mipi-csi2.h     |  23 ++-
 3 files changed, 210 insertions(+), 13 deletions(-)

diff --git a/drivers/phy/qualcomm/phy-qcom-mipi-csi2-3ph-dphy.c b/drivers/phy/qualcomm/phy-qcom-mipi-csi2-3ph-dphy.c
index 658a39463104..4da48e33b693 100644
--- a/drivers/phy/qualcomm/phy-qcom-mipi-csi2-3ph-dphy.c
+++ b/drivers/phy/qualcomm/phy-qcom-mipi-csi2-3ph-dphy.c
@@ -10,6 +10,7 @@
 #include <linux/interrupt.h>
 #include <linux/io.h>
 #include <linux/time64.h>
+#include <linux/units.h>
 
 #include "phy-qcom-mipi-csi2.h"
 
@@ -24,6 +25,18 @@
 
 #define CSIPHY_2PH_LN_CSI_2PHASE_CTRL9n(n)		((0x200 * (n)) + 0x24)
 
+/* C-PHY trio n sits between D-PHY lanes n and n + 1 */
+#define CSIPHY_3PH_LN_BASE(n)				(0x200 + 0x400 * (n))
+#define CSIPHY_3PH_CMN_CSI_COMMON_CTRL0_3PH_EN		0x0e
+
+/*
+ * C-PHY settle time. The stock camera modes program a count of 14, which
+ * the vendor driver derives as the time in timer periods minus 10: 60 ns
+ * on the 400 MHz timer.
+ */
+#define CSIPHY_3PH_SETTLE_NS				60
+#define CSIPHY_3PH_SETTLE_OFFSET			10
+
 /*
  * 3 phase CSI has 19 common status regs with only 0-10 being used
  * and 11-18 being reserved.
@@ -162,6 +175,52 @@ mipi_csi2phy_lane_regs lane_regs_x1e80100[] = {
 	{.reg_addr = 0x0c64, .reg_data = 0x7f, .param_type = CSIPHY_SKEW_CAL},
 };
 
+/* 3nm 3PH v2.4 C-PHY lane settings, written to each trio */
+static const struct
+mipi_csi2phy_lane_regs lane_regs_kaanapali_3ph[] = {
+	{.reg_addr = 0x0094, .reg_data = 0x0d},
+	{.reg_addr = 0x00f4, .reg_data = 0x00},
+	{.reg_addr = 0x00f8, .reg_data = 0x00},
+	{.reg_addr = 0x00fc, .reg_data = 0x00},
+	{.reg_addr = 0x00f0, .reg_data = 0xef, .delay_us = 211},
+	{.reg_addr = 0x0004, .reg_data = 0x00},
+	{.reg_addr = 0x00e4, .reg_data = 0x00},
+	{.reg_addr = 0x00e8, .reg_data = 0x7f},
+	{.reg_addr = 0x00ec, .reg_data = 0x7f},
+	{.reg_addr = 0x0018, .reg_data = 0x3e},
+	{.reg_addr = 0x001c, .reg_data = 0x41},
+	{.reg_addr = 0x0020, .reg_data = 0x41},
+	{.reg_addr = 0x0024, .reg_data = 0x7f},
+	{.reg_addr = 0x0028, .reg_data = 0x00},
+	{.reg_addr = 0x002c, .reg_data = 0x00},
+	{.reg_addr = 0x0064, .reg_data = 0x01},
+	{.reg_addr = 0x0044, .reg_data = 0xb2},
+	{.reg_addr = 0x0110, .reg_data = 0x35},
+	{.reg_addr = 0x00bc, .reg_data = 0xd0},
+	{.reg_addr = 0x0054, .reg_data = 0x00},
+	{.reg_addr = 0x0040, .reg_data = 0x00},
+	{.reg_addr = 0x0060, .reg_data = 0xa8},
+	{.reg_addr = 0x0084, .reg_data = 0x00},
+	{.reg_addr = 0x0090, .reg_data = 0x02},
+};
+
+/* 3nm 3PH v2.4 C-PHY rate settings, 80 Msps to 6 Gsps */
+static const struct mipi_csi2phy_cphy_rate cphy_rates_kaanapali[] = {
+	{ .max_msps =  100, .reg_14 = 0x6b, .reg_6c = 0x38, .reg_78 = 0x5f, .reg_8c = 0x77 },
+	{ .max_msps =  200, .reg_14 = 0x33, .reg_6c = 0x38, .reg_78 = 0x5f, .reg_8c = 0x77 },
+	{ .max_msps =  700, .reg_14 = 0x20, .reg_6c = 0x38, .reg_78 = 0x5f, .reg_8c = 0x77 },
+	{ .max_msps = 1000, .reg_14 = 0x09, .reg_6c = 0x38, .reg_78 = 0x5f, .reg_8c = 0x77 },
+	{ .max_msps = 1500, .reg_14 = 0x09, .reg_6c = 0x38, .reg_78 = 0x3f, .reg_8c = 0x77 },
+	{ .max_msps = 1700, .reg_14 = 0x09, .reg_6c = 0x1d, .reg_78 = 0x26, .reg_8c = 0x03 },
+	{ .max_msps = 2000, .reg_14 = 0x00, .reg_6c = 0x1d, .reg_78 = 0x26, .reg_8c = 0x03 },
+	{ .max_msps = 3000, .reg_14 = 0x00, .reg_6c = 0x1d, .reg_78 = 0x1c, .reg_8c = 0x03 },
+	{ .max_msps = 3500, .reg_14 = 0x00, .reg_6c = 0x1d, .reg_78 = 0x0f, .reg_8c = 0x03 },
+	{ .max_msps = 4000, .reg_14 = 0x00, .reg_6c = 0x1d, .reg_70 = 0x01, .reg_78 = 0x0c, .reg_8c = 0x75 },
+	{ .max_msps = 4500, .reg_14 = 0x00, .reg_6c = 0x1d, .reg_70 = 0x01, .reg_78 = 0x09, .reg_8c = 0x75 },
+	{ .max_msps = 5500, .reg_14 = 0x00, .reg_6c = 0x3d, .reg_70 = 0x01, .reg_78 = 0x08, .reg_8c = 0x75 },
+	{ .max_msps = 6000, .reg_14 = 0x00, .reg_6c = 0x1b, .reg_70 = 0x02, .reg_78 = 0x07, .reg_8c = 0x77 },
+};
+
 static inline const struct mipi_csi2phy_device_regs *
 csi2phy_dev_to_regs(struct mipi_csi2phy_device *csi2phy)
 {
@@ -273,6 +332,88 @@ phy_qcom_mipi_csi2_gen2_config_lanes(struct mipi_csi2phy_device *csi2phy,
 	}
 }
 
+static const struct mipi_csi2phy_cphy_rate *
+phy_qcom_mipi_csi2_cphy_rate(const struct mipi_csi2phy_device_regs *regs,
+			     u64 symbol_rate)
+{
+	int i;
+
+	for (i = 0; i < regs->num_cphy_rates - 1; i++)
+		if (symbol_rate <= (u64)regs->cphy_rates[i].max_msps * HZ_PER_MHZ)
+			break;
+
+	return &regs->cphy_rates[i];
+}
+
+static int phy_qcom_mipi_csi2_cphy_lanes_enable(struct mipi_csi2phy_device *csi2phy,
+						struct mipi_csi2phy_stream_cfg *cfg)
+{
+	const struct mipi_csi2phy_device_regs *regs = csi2phy_dev_to_regs(csi2phy);
+	struct mipi_csi2phy_lanes_cfg *lane_cfg = &cfg->lane_cfg;
+	const struct mipi_csi2phy_cphy_rate *rate;
+	const struct mipi_csi2phy_lane_regs *r;
+	u32 common = regs->common_regs_offset;
+	u32 settle_cnt;
+	u8 lane_mask = 0;
+	int i, j;
+
+	if (!regs->num_cphy_rates)
+		return -EOPNOTSUPP;
+
+	rate = phy_qcom_mipi_csi2_cphy_rate(regs, cfg->symbol_rate);
+
+	settle_cnt = div_u64((u64)CSIPHY_3PH_SETTLE_NS * csi2phy->timer_clk_rate,
+			     NSEC_PER_SEC) - CSIPHY_3PH_SETTLE_OFFSET;
+
+	/* Trio n powers up with bit 2n + 1, see the D-PHY lane map below */
+	for (i = 0; i < cfg->num_data_lanes; i++)
+		lane_mask |= BIT(lane_cfg->data[i].pos * 2 + 1);
+
+	/* Configure while held in reset */
+	writel(CSIPHY_3PH_CMN_CSI_COMMON_CTRL0_PHY_SW_RESET,
+	       csi2phy->base + CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(common, 0));
+
+	writel(0x00, csi2phy->base + CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(common, 33));
+	writel(0x0e, csi2phy->base + CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(common, 35));
+	writel(0x7a, csi2phy->base + CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(common, 7));
+	writel(CSIPHY_3PH_CMN_CSI_COMMON_CTRL6_COMMON_PWRDN_B,
+	       csi2phy->base + CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(common, 6));
+	writel(lane_mask, csi2phy->base + CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(common, 5));
+
+	for (i = 0; i < cfg->num_data_lanes; i++) {
+		void __iomem *ln = csi2phy->base + CSIPHY_3PH_LN_BASE(lane_cfg->data[i].pos);
+
+		for (j = 0, r = regs->cphy_init_seq; j < regs->cphy_array_size; j++, r++) {
+			writel(r->reg_data, ln + r->reg_addr);
+			if (r->delay_us)
+				fsleep(r->delay_us);
+		}
+
+		writel(0xf1, ln + 0x0068);
+		writel(rate->reg_6c, ln + 0x006c);
+		writel(rate->reg_70, ln + 0x0070);
+		writel(0x00, ln + 0x0074);
+		writel(rate->reg_78, ln + 0x0078);
+		writel(0x00, ln + 0x0088);
+		writel(rate->reg_8c, ln + 0x008c);
+		writel(0x02, ln + 0x0090);
+		writel(settle_cnt & 0xff, ln + 0x000c);
+		writel(settle_cnt >> 8, ln + 0x0008);
+		writel(0x00, ln + 0x0010);
+		writel(rate->reg_14, ln + 0x0014);
+	}
+
+	/* IRQ_MASK registers - disable all interrupts */
+	for (i = CSI_COMMON_STATUS_NUM; i < CSI_CTRL_STATUS_INDEX; i++)
+		writel(0, csi2phy->base + CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(common, i));
+
+	writel(CSIPHY_3PH_CMN_CSI_COMMON_CTRL0_3PH_EN,
+	       csi2phy->base + CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(common, 0));
+	fsleep(10);
+
+	return 0;
+}
+
 static int phy_qcom_mipi_csi2_lanes_enable(struct mipi_csi2phy_device *csi2phy,
 					   struct mipi_csi2phy_stream_cfg *cfg)
 {
@@ -282,6 +423,9 @@ static int phy_qcom_mipi_csi2_lanes_enable(struct mipi_csi2phy_device *csi2phy,
 	u8 val;
 	int i;
 
+	if (csi2phy->phy_mode == PHY_MODE_MIPI_CPHY)
+		return phy_qcom_mipi_csi2_cphy_lanes_enable(csi2phy, cfg);
+
 	if (cfg->link_freq <= 0)
 		return -EINVAL;
 
@@ -395,6 +539,10 @@ const struct mipi_csi2phy_soc_cfg mipi_csi2_dphy_3nm_kaanapali = {
 	.reg_info = {
 		.init_seq = lane_regs_x1e80100,
 		.lane_array_size = ARRAY_SIZE(lane_regs_x1e80100),
+		.cphy_init_seq = lane_regs_kaanapali_3ph,
+		.cphy_array_size = ARRAY_SIZE(lane_regs_kaanapali_3ph),
+		.cphy_rates = cphy_rates_kaanapali,
+		.num_cphy_rates = ARRAY_SIZE(cphy_rates_kaanapali),
 		.common_regs_offset = 0x1000,
 		.common_status_offset = 0x138,
 	},
diff --git a/drivers/phy/qualcomm/phy-qcom-mipi-csi2-core.c b/drivers/phy/qualcomm/phy-qcom-mipi-csi2-core.c
index aff9e66f0352..3c2c443de728 100644
--- a/drivers/phy/qualcomm/phy-qcom-mipi-csi2-core.c
+++ b/drivers/phy/qualcomm/phy-qcom-mipi-csi2-core.c
@@ -26,10 +26,10 @@
 
 static int
 phy_qcom_mipi_csi2_set_clock_rates(struct mipi_csi2phy_device *csi2phy,
-				   s64 link_freq)
+				   unsigned long rate)
 {
 	struct device *dev = csi2phy->dev;
-	unsigned long opp_rate = link_freq / 4;
+	unsigned long opp_rate = rate;
 	struct dev_pm_opp *opp;
 	long timer_rate;
 	int i, pstate;
@@ -37,8 +37,8 @@ phy_qcom_mipi_csi2_set_clock_rates(struct mipi_csi2phy_device *csi2phy,
 
 	opp = dev_pm_opp_find_freq_ceil(dev, &opp_rate);
 	if (IS_ERR(opp)) {
-		dev_err(csi2phy->dev, "Couldn't find ceiling for %lld Hz\n",
-			link_freq);
+		dev_err(csi2phy->dev, "Couldn't find ceiling for %lu Hz\n",
+			rate);
 		return PTR_ERR(opp);
 	}
 
@@ -68,7 +68,7 @@ phy_qcom_mipi_csi2_set_clock_rates(struct mipi_csi2phy_device *csi2phy,
 		goto unset_opp_rate;
 	}
 
-	timer_rate = clk_round_rate(csi2phy->timer_clk, link_freq / 4);
+	timer_rate = clk_round_rate(csi2phy->timer_clk, rate);
 	if (timer_rate <= 0) {
 		ret = -ENODEV;
 		goto unset_opp_rate;
@@ -104,6 +104,18 @@ static int phy_qcom_mipi_csi2_configure(struct phy *phy,
 	struct mipi_csi2phy_stream_cfg *stream_cfg = &csi2phy->stream_cfg;
 	int ret;
 
+	if (csi2phy->phy_mode == PHY_MODE_MIPI_CPHY) {
+		struct phy_configure_opts_mipi_cphy *cphy_cfg = &opts->mipi_cphy;
+
+		if (!cphy_cfg->symbol_rate ||
+		    cphy_cfg->trios != stream_cfg->num_data_lanes)
+			return -EINVAL;
+
+		stream_cfg->symbol_rate = cphy_cfg->symbol_rate;
+
+		return 0;
+	}
+
 	ret = phy_mipi_dphy_config_validate(dphy_cfg);
 	if (ret)
 		return ret;
@@ -124,10 +136,10 @@ static int phy_qcom_mipi_csi2_set_mode(struct phy *phy,
 {
 	struct mipi_csi2phy_device *csi2phy = phy_get_drvdata(phy);
 
-	if (mode != PHY_MODE_MIPI_DPHY)
+	/* The bus type of the endpoint sets the mode */
+	if (mode != csi2phy->phy_mode)
 		return -EOPNOTSUPP;
 
-	csi2phy->phy_mode = mode;
 	return 0;
 }
 
@@ -135,8 +147,16 @@ static int phy_qcom_mipi_csi2_power_on(struct phy *phy)
 {
 	struct mipi_csi2phy_device *csi2phy = phy_get_drvdata(phy);
 	const struct mipi_csi2phy_hw_ops *ops = csi2phy->soc_cfg->ops;
+	struct mipi_csi2phy_stream_cfg *stream_cfg = &csi2phy->stream_cfg;
+	unsigned long rate;
 	int i, ret;
 
+	/* The core clock takes a byte per D-PHY lane or two per C-PHY trio */
+	if (csi2phy->phy_mode == PHY_MODE_MIPI_CPHY)
+		rate = div_u64(stream_cfg->symbol_rate, 7);
+	else
+		rate = stream_cfg->link_freq / 4;
+
 	ret = regulator_bulk_enable(csi2phy->soc_cfg->num_supplies,
 				    csi2phy->supplies);
 	if (ret)
@@ -146,7 +166,7 @@ static int phy_qcom_mipi_csi2_power_on(struct phy *phy)
 	if (ret < 0)
 		goto disable_regulators;
 
-	ret = phy_qcom_mipi_csi2_set_clock_rates(csi2phy, csi2phy->stream_cfg.link_freq);
+	ret = phy_qcom_mipi_csi2_set_clock_rates(csi2phy, rate);
 	if (ret)
 		goto poweroff_phy;
 
@@ -258,6 +278,7 @@ static int phy_qcom_mipi_csi2_parse_routing(struct mipi_csi2phy_device *csi2phy)
 	struct fwnode_handle *ep;
 	int num_polarities;
 	int num_data_lanes;
+	int max_data_lanes;
 	u32 bus_type;
 	int i, ret;
 
@@ -278,14 +299,23 @@ static int phy_qcom_mipi_csi2_parse_routing(struct mipi_csi2phy_device *csi2phy)
 	bus_type = MEDIA_BUS_TYPE_CSI2_DPHY;
 	fwnode_property_read_u32(ep, "bus-type", &bus_type);
 
-	if (bus_type != MEDIA_BUS_TYPE_CSI2_DPHY) {
+	switch (bus_type) {
+	case MEDIA_BUS_TYPE_CSI2_DPHY:
+		csi2phy->phy_mode = PHY_MODE_MIPI_DPHY;
+		max_data_lanes = CSI2_MAX_DATA_LANES;
+		break;
+	case MEDIA_BUS_TYPE_CSI2_CPHY:
+		csi2phy->phy_mode = PHY_MODE_MIPI_CPHY;
+		max_data_lanes = CSI2_MAX_TRIOS;
+		break;
+	default:
 		ret = -EOPNOTSUPP;
 		dev_err(dev, "Unsupported bus-type %u\n", bus_type);
 		goto out_put;
 	}
 
 	num_data_lanes = fwnode_property_count_u32(ep, "data-lanes");
-	if (num_data_lanes < 1 || num_data_lanes > CSI2_MAX_DATA_LANES) {
+	if (num_data_lanes < 1 || num_data_lanes > max_data_lanes) {
 		ret = -EINVAL;
 		dev_err(dev, "Invalid data-lanes count: %d\n", num_data_lanes);
 		goto out_put;
@@ -322,7 +352,7 @@ static int phy_qcom_mipi_csi2_parse_routing(struct mipi_csi2phy_device *csi2phy)
 	csi2phy->stream_cfg.lane_cfg.clk.pol = lane_polarities[0];
 
 	for (i = 0; i < csi2phy->stream_cfg.num_data_lanes; i++) {
-		if (data_lanes[i] < 1 || data_lanes[i] > CSI2_MAX_DATA_LANES) {
+		if (data_lanes[i] < 1 || data_lanes[i] > max_data_lanes) {
 			dev_err(dev, "Invalid lane %d\n", data_lanes[i]);
 			ret = -EINVAL;
 			goto out_put;
diff --git a/drivers/phy/qualcomm/phy-qcom-mipi-csi2.h b/drivers/phy/qualcomm/phy-qcom-mipi-csi2.h
index 2355a1db9b94..9d95615947c8 100644
--- a/drivers/phy/qualcomm/phy-qcom-mipi-csi2.h
+++ b/drivers/phy/qualcomm/phy-qcom-mipi-csi2.h
@@ -11,6 +11,7 @@
 #include <linux/phy/phy.h>
 
 #define CSI2_MAX_DATA_LANES	4
+#define CSI2_MAX_TRIOS		3
 #define CSI2_DEFAULT_CLK_LANE	7
 
 struct mipi_csi2phy_lane {
@@ -24,8 +25,9 @@ struct mipi_csi2phy_lanes_cfg {
 };
 
 struct mipi_csi2phy_stream_cfg {
-	s64 link_freq;
-	u8 num_data_lanes;
+	s64 link_freq;		/* D-PHY */
+	u64 symbol_rate;	/* C-PHY, per trio */
+	u8 num_data_lanes;	/* D-PHY data lanes or C-PHY trios */
 	struct mipi_csi2phy_lanes_cfg lane_cfg;
 };
 
@@ -47,9 +49,26 @@ struct mipi_csi2phy_lane_regs {
 	const u32 param_type;
 };
 
+/*
+ * Rate dependent C-PHY lane settings, used up to max_msps symbols per
+ * second. The values are named after their lane register offsets.
+ */
+struct mipi_csi2phy_cphy_rate {
+	u32 max_msps;
+	u8 reg_14;
+	u8 reg_6c;
+	u8 reg_70;
+	u8 reg_78;
+	u8 reg_8c;
+};
+
 struct mipi_csi2phy_device_regs {
 	const struct mipi_csi2phy_lane_regs *init_seq;
 	const int lane_array_size;
+	const struct mipi_csi2phy_lane_regs *cphy_init_seq;
+	const int cphy_array_size;
+	const struct mipi_csi2phy_cphy_rate *cphy_rates;
+	const int num_cphy_rates;
 	const u32 common_regs_offset;
 	const u32 common_status_offset;
 };
-- 
