From eb92a7e1c44bf9b9984929eb586e2ed601997d28 Mon Sep 17 00:00:00 2001
From: Reixo <125610085+Reixo0@users.noreply.github.com>
Date: Sun, 25 Oct 2026 18:45:48 +0100
Subject: [PATCH 095/165] ASoC: qcom: sc8280xp: run the RX codec DMA at 24 bit
 on kaanapali

The Kaanapali ADSP passes no samples from a 16-bit RX codec DMA to the
RX macro: headphone playback over the WCD9395 stays silent while a
microphone routed into the same interpolators through the RX macro is
heard. With 24-bit samples the headphones play.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sound/soc/qcom/sc8280xp.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/sound/soc/qcom/sc8280xp.c b/sound/soc/qcom/sc8280xp.c
index 33488f940486..4af95f60188a 100644
--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -310,6 +310,16 @@ static int sc8280xp_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 	case TX_CODEC_DMA_TX_3:
 		channels->min = 1;
 		break;
+	case RX_CODEC_DMA_RX_0:
+		/*
+		 * The Kaanapali ADSP passes nothing to the RX macro from a
+		 * 16-bit RX codec DMA; 24-bit samples go through.
+		 */
+		if (!strcmp(rtd->card->driver_name, "kaanapali")) {
+			snd_mask_none(fmt);
+			snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S24_LE);
+		}
+		break;
 	case PRIMARY_MI2S_RX:
 		if (!(codec_dai->driver->playback.formats & SNDRV_PCM_FMTBIT_S16_LE)) {
 			snd_mask_none(fmt);
-- 
