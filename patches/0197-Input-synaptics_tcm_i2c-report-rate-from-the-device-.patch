From b3f595a856680bd64cbf845a6c202ad1b69b7e8f Mon Sep 17 00:00:00 2001
From: Reixo <125610085+Reixo0@users.noreply.github.com>
Date: Sun, 1 Nov 2026 00:52:12 +0100
Subject: [PATCH] Input: synaptics_tcm_i2c - report rate from the device tree

syna,report-rate is the firmware's code for dynamic config 0xe6, applied
at probe, after a recovery and on resume. On the NX809J it gives 240 Hz
instead of 120 Hz, below the panel's 144 Hz. From Doctor Logix's
2ce68e6e5136 and ba93b224bf4b for the other driver.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/input/touchscreen/synaptics_tcm_i2c.c | 28 +++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/drivers/input/touchscreen/synaptics_tcm_i2c.c b/drivers/input/touchscreen/synaptics_tcm_i2c.c
index 5cc88dc8a707..290e20c77918 100644
--- a/drivers/input/touchscreen/synaptics_tcm_i2c.c
+++ b/drivers/input/touchscreen/synaptics_tcm_i2c.c
@@ -64,6 +64,7 @@
 /* Dynamic config IDs. */
 #define SYNA_DC_IN_WAKEUP_GESTURE_MODE	0x09
 #define SYNA_DC_GESTURE_MASK		0xfe
+#define SYNA_DC_REPORT_RATE		0xe6
 
 /* Status codes, i.e. header codes of a command response. */
 #define SYNA_STATUS_IDLE		0x00
@@ -187,6 +188,9 @@ struct syna_tcm {
 	u8 normal_config[SYNA_MAX_CONFIG_SIZE];
 	unsigned int normal_config_len;
 
+	/* Firmware's report rate code from syna,report-rate, 0 keeps its own. */
+	u32 report_rate;
+
 	unsigned int max_objects;
 	struct syna_object objects[SYNA_MAX_OBJECTS];
 };
@@ -392,6 +396,20 @@ static int syna_set_dynamic_config(struct syna_tcm *ts, u8 id, u16 value)
 	return syna_exec_command(ts, SYNA_CMD_SET_DYNAMIC_CONFIG, buf, sizeof(buf));
 }
 
+/* A failure keeps the firmware's own rate; touch reporting stays on. */
+static void syna_apply_report_rate(struct syna_tcm *ts)
+{
+	int ret;
+
+	if (!ts->report_rate)
+		return;
+
+	ret = syna_set_dynamic_config(ts, SYNA_DC_REPORT_RATE, ts->report_rate);
+	if (ret)
+		dev_err(ts->dev, "report rate %u not applied: %d\n",
+			ts->report_rate, ret);
+}
+
 /* Extract a big field of @bits from the report's bit stream at @offset. */
 static u32 syna_get_bits(const u8 *buf, unsigned int buf_len,
 			 unsigned int offset, unsigned int bits)
@@ -867,6 +885,8 @@ static int syna_reinit_hw(struct syna_tcm *ts)
 	if (ret)
 		goto err_power_off;
 
+	syna_apply_report_rate(ts);
+
 	return 0;
 
 err_power_off:
@@ -910,10 +930,14 @@ static int syna_probe_common(struct syna_tcm *ts)
 	if (ret)
 		return ret;
 
+	device_property_read_u32(dev, "syna,report-rate", &ts->report_rate);
+
 	ret = syna_setup(ts);
 	if (ret)
 		return ret;
 
+	syna_apply_report_rate(ts);
+
 	ret = input_register_device(ts->input);
 	if (ret)
 		return dev_err_probe(dev, ret, "failed to register input device\n");
@@ -1012,6 +1036,8 @@ static int syna_resume(struct device *dev)
 		if (ret)
 			dev_warn(dev, "failed to read touch report config: %d\n", ret);
 
+		syna_apply_report_rate(ts);
+
 		ts->gesture_enabled = false;
 		ts->suspended = false;
 		enable_irq(ts->irq);
@@ -1030,6 +1056,8 @@ static int syna_resume(struct device *dev)
 			}
 		}
 
+		syna_apply_report_rate(ts);
+
 		ts->suspended = false;
 		enable_irq(ts->irq);
 	}
-- 
