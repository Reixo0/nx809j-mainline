From 0d82adb9568d8c2e9eb3f494d7ead961bfe2c099 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 2 Oct 2026 12:59:46 +0300
Subject: [PATCH 64/66] drm/msm/dsi/phy: release the iface clock while
 suspended

The DSI PHY lets pm_clk manage its "iface" clock. pm_clk prepares the
clock when it is added and only disables it on runtime suspend, so the
clock stays prepared for as long as the driver is bound. The PHY has no
system sleep callbacks either: a PHY that is still runtime-active when
the system suspends keeps the clock enabled through the sleep.

On Qualcomm SoCs with RPMh the iface clock (disp_cc_mdss_ahb_clk) is
derived from the RPMh XO clock, which votes for the crystal on prepare,
in the sleep set too. On the OnePlus Pad 4 (SM8850) the two DSI PHYs
kept the clock prepared with every display device runtime-suspended,
and with the PCIe link off it was the last clock holding the crystal
vote in the RPMh sleep set during s2idle.

Prepare and enable the clock in the runtime resume callback, disable and
unprepare it in runtime suspend, and use pm_runtime_force_suspend() and
pm_runtime_force_resume() as system sleep callbacks, as the DSI host and
the DPU driver do. All register accesses of the PHY run under a runtime
PM reference: msm_dsi_phy_enable() takes one, and the clock framework
takes one around the PLL clock operations because those clocks are
registered with this device. The callbacks run in process context; the
device's runtime PM is not irq-safe.

With the change, the clock's prepare count drops from 2 to 0 when the
screen turns off, the crystal vote leaves the RPMh sleep set in s2idle,
and the display comes back after screen off / on and after five s2idle
cycles.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/msm/dsi/phy/dsi_phy.c | 36 ++++++++++++++++++++-------
 drivers/gpu/drm/msm/dsi/phy/dsi_phy.h |  1 +
 2 files changed, 28 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
index 1fb3899b8..737b44ec3 100644
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
@@ -5,7 +5,6 @@
 
 #include <linux/clk-provider.h>
 #include <linux/platform_device.h>
-#include <linux/pm_clock.h>
 #include <linux/pm_runtime.h>
 #include <dt-bindings/phy/phy.h>
 
@@ -687,13 +686,14 @@ static int dsi_phy_driver_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
-	ret = devm_pm_clk_create(dev);
-	if (ret)
-		return ret;
-
-	ret = pm_clk_add(dev, "iface");
-	if (ret < 0)
-		return dev_err_probe(dev, ret, "Unable to get iface clk\n");
+	/*
+	 * Not through pm_clk: it would keep the clock prepared while the PHY
+	 * is suspended, and with it the RPMh XO vote of the clock's source.
+	 */
+	phy->ahb_clk = devm_clk_get(dev, "iface");
+	if (IS_ERR(phy->ahb_clk))
+		return dev_err_probe(dev, PTR_ERR(phy->ahb_clk),
+				     "Unable to get iface clk\n");
 
 	if (phy->cfg->ops.pll_init) {
 		ret = phy->cfg->ops.pll_init(phy);
@@ -711,8 +711,26 @@ static int dsi_phy_driver_probe(struct platform_device *pdev)
 	return 0;
 }
 
+static int dsi_phy_runtime_suspend(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+
+	clk_disable_unprepare(phy->ahb_clk);
+
+	return 0;
+}
+
+static int dsi_phy_runtime_resume(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+
+	return clk_prepare_enable(phy->ahb_clk);
+}
+
 static const struct dev_pm_ops dsi_phy_pm_ops = {
-	SET_RUNTIME_PM_OPS(pm_clk_suspend, pm_clk_resume, NULL)
+	SET_RUNTIME_PM_OPS(dsi_phy_runtime_suspend, dsi_phy_runtime_resume, NULL)
+	SET_SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend,
+				pm_runtime_force_resume)
 };
 
 static struct platform_driver dsi_phy_platform_driver = {
diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
index f5d3e806f..e658dd283 100644
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
@@ -107,6 +107,7 @@ struct msm_dsi_phy {
 	int id;
 
 	struct regulator_bulk_data *supplies;
+	struct clk *ahb_clk;
 
 	struct msm_dsi_dphy_timing timing;
 	const struct msm_dsi_phy_cfg *cfg;
-- 
