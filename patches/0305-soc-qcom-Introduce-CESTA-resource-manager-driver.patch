+	TP_printk("%s: IRQ vcd_type: %u resource_idx: %u irq_status: %lu",
+		  __get_str(name), __entry->vcd_type, __entry->resource_idx,
+		  __entry->irq_status)
+);
+
+TRACE_EVENT(crm_switch_channel,
+
+	TP_PROTO(const char *name, int ch, int ret),
+
+	TP_ARGS(name, ch, ret),
+
+	TP_STRUCT__entry(
