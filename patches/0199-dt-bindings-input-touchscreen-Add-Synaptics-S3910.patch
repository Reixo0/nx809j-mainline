From d3c1f45154800d45ea5b9a6faf979aaffc3c5b63 Mon Sep 17 00:00:00 2001
From: Doctor Logix <doctor.logix@gmail.com>
Date: Sun, 18 Oct 2026 22:42:53 +0200
Subject: [PATCH] dt-bindings: input: touchscreen: Add Synaptics S3910

The Synaptics S3910 is a touchscreen controller that speaks the
Synaptics TouchComm protocol over SPI. It is found in the OnePlus Ace 3
and OnePlus 12R. It needs a digital supply, an analog supply, an
active-low reset line and an interrupt. It boots its application
firmware from its own flash, so no firmware name is described.

(cherry picked from commit 15a7a3eafd184aeda047a8e4564e6ea432794997)
---
 .../input/touchscreen/syna,s3910.yaml         | 70 +++++++++++++++++++
 1 file changed, 70 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/touchscreen/syna,s3910.yaml

diff --git a/Documentation/devicetree/bindings/input/touchscreen/syna,s3910.yaml b/Documentation/devicetree/bindings/input/touchscreen/syna,s3910.yaml
new file mode 100644
index 000000000000..41d37ed7a40d
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/touchscreen/syna,s3910.yaml
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/syna,s3910.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Synaptics S3910 TouchComm SPI touchscreen controller
+
+maintainers:
+  - Doctor Logix <doctor.logix@gmail.com>
+
+description:
+  The Synaptics S3910 is a touchscreen controller that speaks the Synaptics
+  TouchComm protocol over SPI. It runs its application firmware from its own
+  flash.
+
+allOf:
+  - $ref: touchscreen.yaml#
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: syna,s3910
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+    description: GPIO connected to the active-low reset input.
+
+  vdd-supply:
+    description: Digital and I/O supply (1.8 V).
+
+  avdd-supply:
+    description: Analog supply.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - reset-gpios
+  - vdd-supply
+  - avdd-supply
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@0 {
+            compatible = "syna,s3910";
+            reg = <0>;
+            spi-max-frequency = <19000000>;
+            interrupt-parent = <&tlmm>;
+            interrupts = <25 IRQ_TYPE_LEVEL_LOW>;
+            reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
+            vdd-supply = <&vreg_l4b_1p8>;
+            avdd-supply = <&ts_avdd>;
+        };
+    };
-- 
