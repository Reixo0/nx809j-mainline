From 86f92dfab560c500b3be1a3f39b7bd14255e1245 Mon Sep 17 00:00:00 2001
From: Reixo <125610085+Reixo0@users.noreply.github.com>
Date: Mon, 26 Oct 2026 17:12:30 +0100
Subject: [PATCH 114/121] net: ipa: mark the microcontroller descriptor RAM on
 IPA v5.5

Starting with IPA v5.5, the downstream driver writes 0xabcdef01 to the
first word of the microcontroller descriptor RAM when it initializes
the IPA local memory, before the modem loads the microcontroller
firmware.

Without the marker, the microcontroller hangs the whole SoC as soon as
the modem starts it on Kaanapali: UFS, USB and the display stop, the
modem and ADSP watchdogs fire, and the board resets (sometimes into
EDL). Write the marker at the start of the microcontroller region.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/net/ipa/ipa_mem.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/drivers/net/ipa/ipa_mem.c b/drivers/net/ipa/ipa_mem.c
index 078d32a18..5430a1ee2 100644
--- a/drivers/net/ipa/ipa_mem.c
+++ b/drivers/net/ipa/ipa_mem.c
@@ -24,6 +24,9 @@
 /* "Canary" value placed between memory regions to detect overflow */
 #define IPA_MEM_CANARY_VAL		cpu_to_le32(0xdeadbeef)
 
+/* Marker the microcontroller expects at the start of its descriptor RAM */
+#define IPA_MEM_UC_DESC_MARKER		0xabcdef01
+
 /* SMEM host id representing the modem. */
 #define QCOM_SMEM_HOST_MODEM	1
 
@@ -385,6 +388,17 @@ int ipa_mem_config(struct ipa *ipa)
 		goto err_dma_free;
 	}
 
+	/* Starting with IPA v5.5, the first word of the microcontroller
+	 * descriptor RAM must hold a marker before the microcontroller
+	 * firmware is started.
+	 */
+	if (mem && ipa->version >= IPA_VERSION_5_5) {
+		u32 *uc_desc = ipa->mem_virt + ipa->mem_offset + mem->offset;
+
+		*uc_desc = cpu_to_le32(IPA_MEM_UC_DESC_MARKER);
+		wmb();
+	}
+
 	return 0;
 
 err_dma_free:
