From c98bf700b894d45cf65dad9564eb6ece2fc1419a Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Sat, 10 Oct 2026 04:33:09 +0300
Subject: [PATCH 025/162] Bluetooth: hci_qca: Discard the RX burst of the
 WCN7860 baudrate change

Every WCN7860 setup logs "Frame reassembly failed (-84)" about 0.1 ms
after "QCA controller version", i.e. right after qca_set_speed()
asserted RTS again at the operating speed. The peripheral baudrate
command of peri_set_baudrate() is only queued, so it goes out together
with the HCI baudrate command while RTS is deasserted; the controller
then sends its held-back bytes when RTS comes back, and that burst does
not start with a valid H:4 packet type. Nothing waits for these
replies: the rampatch download that follows works and the setup
completes, so the message is noise, but an error-level line on every
power-on hides real failures.

Set a QCA_DISCARD_RX flag around the WCN7860 speed change, drop what
qca_recv() gets while it is set (dumped with dynamic debug), and keep
the window open for 20 ms after RTS is asserted again. Other SoCs are
not affected.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/bluetooth/hci_qca.c | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/drivers/bluetooth/hci_qca.c b/drivers/bluetooth/hci_qca.c
index 042f9df6ce4d..b36387322d28 100644
--- a/drivers/bluetooth/hci_qca.c
+++ b/drivers/bluetooth/hci_qca.c
@@ -80,6 +80,7 @@ enum qca_flags {
 	QCA_BT_OFF,
 	QCA_ROM_FW,
 	QCA_DEBUGFS_CREATED,
+	QCA_DISCARD_RX,
 };
 
 enum qca_capabilities {
@@ -1284,6 +1285,14 @@ static int qca_recv(struct hci_uart *hu, const void *data, int count)
 	if (!test_bit(HCI_UART_REGISTERED, &hu->flags))
 		return -EUNATCH;
 
+	if (test_bit(QCA_DISCARD_RX, &qca->flags)) {
+		bt_dev_dbg(hu->hdev, "Discarding %d bytes during baudrate change",
+			   count);
+		print_hex_dump_debug("hci_qca rx: ", DUMP_PREFIX_OFFSET, 16, 1,
+				     data, min(count, 32), false);
+		return count;
+	}
+
 	qca->rx_skb = h4_recv_buf(hu, qca->rx_skb, data, count,
 				  qca_recv_pkts, ARRAY_SIZE(qca_recv_pkts));
 	if (IS_ERR(qca->rx_skb)) {
@@ -1556,6 +1565,17 @@ static int qca_set_speed(struct hci_uart *hu, enum qca_speed_type speed_type)
 			set_bit(QCA_DROP_VENDOR_EVENT, &qca->flags);
 			break;
 
+		case QCA_WCN7860:
+			/* Nothing waits for the replies to the peripheral and
+			 * HCI baudrate commands. The controller sends them once
+			 * RTS is asserted again after the host changed its
+			 * speed, and that burst does not start with a valid
+			 * H:4 packet type, so the reassembly fails with
+			 * -EILSEQ. Discard what arrives in that window.
+			 */
+			set_bit(QCA_DISCARD_RX, &qca->flags);
+			break;
+
 		default:
 			break;
 		}
@@ -1586,6 +1606,11 @@ static int qca_set_speed(struct hci_uart *hu, enum qca_speed_type speed_type)
 			break;
 		}
 
+		if (test_bit(QCA_DISCARD_RX, &qca->flags)) {
+			msleep(20);
+			clear_bit(QCA_DISCARD_RX, &qca->flags);
+		}
+
 		switch (soc_type) {
 		case QCA_WCN3990:
 			/* Wait for the controller to send the vendor event
-- 
