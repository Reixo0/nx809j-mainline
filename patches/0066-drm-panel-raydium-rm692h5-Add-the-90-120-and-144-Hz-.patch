+#define RM692H5_MODE(_fps, _hfp, _hbp) {				\
+	.clock = (1216 + (_hfp) + 8 + (_hbp)) * (2688 + 56 + 8 + 8) *	\
+		 (_fps) / 1000,						\
+	.hdisplay = 1216,						\
+	.hsync_start = 1216 + (_hfp),					\
+	.hsync_end = 1216 + (_hfp) + 8,					\
+	.htotal = 1216 + (_hfp) + 8 + (_hbp),				\
+	.vdisplay = 2688,						\
+	.vsync_start = 2688 + 56,					\
+	.vsync_end = 2688 + 56 + 8,					\
+	.vtotal = 2688 + 56 + 8 + 8,					\
+	.width_mm = 72,							\
+	.height_mm = 158,						\
+	.type = DRM_MODE_TYPE_DRIVER,					\
+}
