From c8f11ca2ce5adb8f067edc8ff5ba42e07f8ecdee Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Wed, 30 Sep 2026 10:07:42 +0300
Subject: [PATCH 77/88] ASoC: codecs: lpass-tx-macro: disable the decimator
 adaptive block on codec 2.8+

LPASS codec 2.8 and later have an adaptive (ADPT) block in every TX
decimator, enabled out of reset (ADPT_CTRL = 0x51). This driver never
programs it. The downstream driver, at every decimator power-up, either
loads the board's tuning into it or disables it.

Left at its reset state the block lifts the recording's noise floor. On
the OnePlus Pad 4 (Kaanapali, WCD9395 analog mics, quiet room): -47 dBFS
as is, -64 dBFS with ADPT_CTRL = 0, and -64.5 dBFS with the downstream
tuning; a 1 kHz reference tone keeps its level (-30.5 dBFS) in all three.

Add the ADPT_CTRL registers to the regmap and disable the block at
decimator power-up, as downstream does when no tuning is given.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sound/soc/codecs/lpass-tx-macro.c | 28 +++++++++++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/sound/soc/codecs/lpass-tx-macro.c b/sound/soc/codecs/lpass-tx-macro.c
index 6deaaabe4..1e2e4d1ac 100644
--- a/sound/soc/codecs/lpass-tx-macro.c
+++ b/sound/soc/codecs/lpass-tx-macro.c
@@ -186,7 +186,8 @@
 #define CDC_TX7_TX_PATH_SEC4		(0x07A0)
 #define CDC_TX7_TX_PATH_SEC5		(0x07A4)
 #define CDC_TX7_TX_PATH_SEC6		(0x07A8)
-#define TX_MAX_OFFSET			(0x07A8)
+#define CDC_TXn_ADPT_CTRL(n)		(0x0800 + 0x80 * n)
+#define TX_MAX_OFFSET			(0x0B80)
 
 #define TX_MACRO_RATES (SNDRV_PCM_RATE_8000 | SNDRV_PCM_RATE_16000 |\
 			SNDRV_PCM_RATE_32000 | SNDRV_PCM_RATE_48000 |\
@@ -432,6 +433,14 @@ static struct reg_default tx_defaults[] = {
 	{ CDC_TX7_TX_PATH_SEC4, 0x20},
 	{ CDC_TX7_TX_PATH_SEC5, 0x00},
 	{ CDC_TX7_TX_PATH_SEC6, 0x00},
+	{ CDC_TXn_ADPT_CTRL(0), 0x51},
+	{ CDC_TXn_ADPT_CTRL(1), 0x51},
+	{ CDC_TXn_ADPT_CTRL(2), 0x51},
+	{ CDC_TXn_ADPT_CTRL(3), 0x51},
+	{ CDC_TXn_ADPT_CTRL(4), 0x51},
+	{ CDC_TXn_ADPT_CTRL(5), 0x51},
+	{ CDC_TXn_ADPT_CTRL(6), 0x51},
+	{ CDC_TXn_ADPT_CTRL(7), 0x51},
 };
 
 static bool tx_is_volatile_register(struct device *dev, unsigned int reg)
@@ -591,6 +600,14 @@ static bool tx_is_rw_register(struct device *dev, unsigned int reg)
 	case CDC_TX7_TX_PATH_SEC4:
 	case CDC_TX7_TX_PATH_SEC5:
 	case CDC_TX7_TX_PATH_SEC6:
+	case CDC_TXn_ADPT_CTRL(0):
+	case CDC_TXn_ADPT_CTRL(1):
+	case CDC_TXn_ADPT_CTRL(2):
+	case CDC_TXn_ADPT_CTRL(3):
+	case CDC_TXn_ADPT_CTRL(4):
+	case CDC_TXn_ADPT_CTRL(5):
+	case CDC_TXn_ADPT_CTRL(6):
+	case CDC_TXn_ADPT_CTRL(7):
 		return true;
 	}
 
@@ -951,6 +968,15 @@ static int tx_macro_enable_dec(struct snd_soc_dapm_widget *w,
 					      CDC_TXn_PGA_MUTE_MASK, 0x1);
 		break;
 	case SND_SOC_DAPM_POST_PMU:
+		/*
+		 * LPASS codec 2.8+ has an adaptive block per decimator that is
+		 * enabled out of reset. Without its board tuning it lifts the
+		 * recording's noise floor; disable it, as downstream does when
+		 * no tuning is given.
+		 */
+		if (lpass_macro_get_codec_version() >= LPASS_CODEC_VERSION_2_8)
+			snd_soc_component_write(component,
+						CDC_TXn_ADPT_CTRL(decimator), 0x00);
 		snd_soc_component_write_field(component, tx_vol_ctl_reg,
 					     CDC_TXn_CLK_EN_MASK, 0x1);
 		if (!is_amic_enabled(component, tx, decimator)) {
-- 
