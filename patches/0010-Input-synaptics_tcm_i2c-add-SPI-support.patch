@@ -270,7 +280,7 @@ static int syna_recv_message(struct syna_tcm *ts)
 		unsigned int read_len = chunk + 2;
 		unsigned int payload_chunk;
 
-		ret = i2c_master_recv(ts->client, ts->rxbuf, read_len);
+		ret = ts->read(ts, ts->rxbuf, read_len);
 		if (ret < 0)
