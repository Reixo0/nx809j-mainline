From f58f0dc6bb6fb58260f7ce1f46bb602973b5bb35 Mon Sep 17 00:00:00 2001
From: Reixo <125610085+Reixo0@users.noreply.github.com>
Date: Sat, 24 Oct 2026 00:48:16 +0200
Subject: [PATCH 10/40] Input: synaptics_tcm_i2c - add SPI support

The TouchComm v1 message format is the same on SPI as on I2C: a read
returns the next chunk of the current message, starting with the 0xa5
marker, so the protocol code can be shared. Put the bus transfers behind
read/write callbacks, split probe into a bus independent part, and add an
SPI driver next to the I2C one. SPI reads clock out 0xff, like the vendor
driver, and the transfer buffers are cache line aligned for DMA.

Each bus driver gets its own OF match table: the SPI core warns about
compatibles without a matching spi_device_id otherwise.

Tested with the S3910 (firmware 15.20, TouchComm v1) on SPI in the Nubia
RedMagic 11 Pro: identify, report config and multitouch events with
tracking IDs and contact size at ~180 Hz.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/input/touchscreen/Kconfig             |   9 +-
 drivers/input/touchscreen/synaptics_tcm_i2c.c | 234 ++++++++++++++----
 2 files changed, 192 insertions(+), 51 deletions(-)

diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
index c58e3e4cc..9dc419d6b 100644
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -1311,11 +1311,14 @@ config TOUCHSCREEN_SX8654
 	  module will be called sx8654.
 
 config TOUCHSCREEN_SYNAPTICS_TCM_I2C
-	tristate "Synaptics TouchComm I2C touchscreen"
-	depends on I2C
+	tristate "Synaptics TouchComm I2C/SPI touchscreen"
+	depends on I2C || SPI_MASTER
+	depends on I2C || I2C=n
+	depends on SPI_MASTER || SPI_MASTER=n
 	help
 	  Say Y here if you have a Synaptics TouchComm (TCM) touch controller
-	  attached over I2C, such as the S3908 found in the OnePlus 9RT.
+	  attached over I2C, such as the S3908 found in the OnePlus 9RT, or over
+	  SPI, such as the one in the Nubia RedMagic 11 Pro.
 
 	  Only controllers that boot into application mode out of their own
 	  flash are supported; there is no host firmware download.
