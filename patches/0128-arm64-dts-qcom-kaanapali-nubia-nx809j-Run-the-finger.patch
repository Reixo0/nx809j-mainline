From bef87c7a5976f0768b7ae11dae00ff385a119ad4 Mon Sep 17 00:00:00 2001
From: Doctor Logix <doctor.logix@gmail.com>
Date: Tue, 27 Oct 2026 23:04:36 +0100
Subject: [PATCH 128/165] arm64: dts: qcom: kaanapali-nubia-nx809j: Run the
 fingerprint supply at 3.296 V

Stock asks L7M for exactly 3.3 V, which this 8 mV-step LDO cannot
produce. Enabling it at 3.304 V, the next step up, reset the phone
before regulator_enable() returned. At 3.296 V the sensor powers on,
completes its reset and raises interrupts.

(cherry picked from commit 22f4ed9985390909b1e3eea1ebffd39f464ead98)
---
 arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts b/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts
index 42291a2fbd26..55bcffc41924 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts
@@ -998,9 +998,12 @@ vreg_l6m_2p8: ldo6 {
 
 		vreg_l7m_2p8: ldo7 {
 			regulator-name = "vreg_l7m_2p8";
-			/* Downstream asks 3.3 V; this LDO steps 8 mV from 1.504 V */
-			regulator-min-microvolt = <3304000>;
-			regulator-max-microvolt = <3304000>;
+			/*
+			 * Stock asks exactly 3.3 V. This LDO steps 8 mV from 1.504 V;
+			 * enabling it at 3.304 V reset the phone.
+			 */
+			regulator-min-microvolt = <3296000>;
+			regulator-max-microvolt = <3296000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
 	};
