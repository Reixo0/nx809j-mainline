From b30950847d2a0c041c9ede5c0b3f9cda4c7d929d Mon Sep 17 00:00:00 2001
From: Victor Fuentes <victor@vlinkz.dev>
Date: Wed, 23 Sep 2026 11:31:20 -0700
Subject: [PATCH 035/165] clk: qcom: gcc-kaanapali: Keep the PCIe PHY GDSC in
 retention

The PCIe link can stay up across suspend-to-idle, so don't power off the
PHY under it, as on SM8550 and SM8650.

Fixes: d1919c375f21 ("clk: qcom: Add support for Global clock controller on Kaanapali")

Signed-off-by: Victor Fuentes <victor@vlinkz.dev>
---
 drivers/clk/qcom/gcc-kaanapali.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/clk/qcom/gcc-kaanapali.c b/drivers/clk/qcom/gcc-kaanapali.c
index 452c72c0049f..98e6a216b4d7 100644
--- a/drivers/clk/qcom/gcc-kaanapali.c
+++ b/drivers/clk/qcom/gcc-kaanapali.c
@@ -3153,7 +3153,7 @@ static struct gdsc gcc_pcie_0_phy_gdsc = {
 	.pd = {
 		.name = "gcc_pcie_0_phy_gdsc",
 	},
-	.pwrsts = PWRSTS_OFF_ON,
+	.pwrsts = PWRSTS_RET_ON,
 	.flags = POLL_CFG_GDSCR | RETAIN_FF_ENABLE | VOTABLE,
 };
 
-- 
2.56.0

