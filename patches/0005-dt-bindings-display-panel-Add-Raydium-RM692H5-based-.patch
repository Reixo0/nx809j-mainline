From 2b604d27535b12a339cd5325409e85cdb3ffdc94 Mon Sep 17 00:00:00 2001
From: Reixo <125610085+Reixo0@users.noreply.github.com>
Date: Fri, 23 Oct 2026 23:13:58 +0200
Subject: [PATCH 5/7] dt-bindings: display: panel: Add Raydium RM692H5 based
 panels

Document the Raydium RM692H5 AMOLED DSI panel IC, as used for the 6.8"
1216x2688 DSC command mode panel in the Nubia RedMagic 11 Pro.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../display/panel/raydium,rm692h5.yaml        | 73 +++++++++++++++++++
 1 file changed, 73 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/panel/raydium,rm692h5.yaml

diff --git a/Documentation/devicetree/bindings/display/panel/raydium,rm692h5.yaml b/Documentation/devicetree/bindings/display/panel/raydium,rm692h5.yaml
new file mode 100644
index 000000000..3e1234bb4
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/raydium,rm692h5.yaml
@@ -0,0 +1,73 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/raydium,rm692h5.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Raydium RM692H5 based DSI display panels
+
+maintainers:
+  - Reixo <125610085+Reixo0@users.noreply.github.com>
+
+description:
+  The Raydium RM692H5 is a DSI panel IC used to control AMOLED panels, such
+  as the 6.8" 1216x2688 DSC command mode panel in the Nubia RedMagic 11 Pro.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    items:
+      - const: nubia,nx809j-rm692h5
+      - const: raydium,rm692h5
+
+  reg:
+    maxItems: 1
+
+  vddio-supply:
+    description: I/O voltage rail
+
+  vdd-supply:
+    description: Digital voltage rail
+
+  vci-supply:
+    description: Analog voltage rail
+
+required:
+  - compatible
+  - reg
+  - reset-gpios
+  - vddio-supply
+  - vdd-supply
+  - vci-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "nubia,nx809j-rm692h5", "raydium,rm692h5";
+            reg = <0>;
+
+            reset-gpios = <&tlmm 98 GPIO_ACTIVE_LOW>;
+            vddio-supply = <&vreg_l12b_1p8>;
+            vdd-supply = <&vreg_l11b_1p0>;
+            vci-supply = <&vreg_l13b_3p0>;
+
+            port {
+                panel_in_0: endpoint {
+                    remote-endpoint = <&dsi0_out>;
+                };
+            };
+        };
+    };
+
+...
-- 
