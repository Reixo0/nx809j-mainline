From aa495e266b4739138b133d60cb72a9c62f3cb0fe Mon Sep 17 00:00:00 2001
From: Victor Fuentes <victor@vlinkz.dev>
Date: Thu, 24 Sep 2026 19:04:22 -0700
Subject: [PATCH 043/162] phy: qcom: qmp-combo: Keep the DP lanes of a
 USB-capable DP sink

UCSI reports TYPEC_STATE_USB after DP alt mode is set up for such sinks.
Ignore it until the port leaves DP alt mode.

Signed-off-by: Victor Fuentes <victor@vlinkz.dev>
---
 drivers/phy/qualcomm/phy-qcom-qmp-combo.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
index 0cf9caaaa030..08c8eb2e6029 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
@@ -2637,6 +2637,7 @@ struct qmp_combo {
 	struct phy_configure_opts_dp dp_opts;
 	unsigned int dp_init_count;
 	bool dp_powered_on;
+	bool dp_active;
 
 	struct phy *usb4_phy;
 	enum tbt_phy_submode usb4_phy_submode;
@@ -5178,6 +5179,7 @@ static int qmp_combo_typec_mux_set(struct typec_mux_dev *mux, struct typec_mux_s
 		return 0;
 
 	if (svid == USB_TYPEC_DP_SID) {
+		qmp->dp_active = true;
 		switch (state->mode) {
 		/* DP Only */
 		case TYPEC_DP_STATE_C:
@@ -5194,7 +5196,13 @@ static int qmp_combo_typec_mux_set(struct typec_mux_dev *mux, struct typec_mux_s
 			new_mode = QMPPHY_MODE_USB3DP;
 			break;
 		}
+	} else if (state->mode == TYPEC_STATE_USB && qmp->dp_active) {
+		/* Keep the lanes of a DP sink that also does USB */
+		return 0;
 	} else {
+		if (state->mode == TYPEC_STATE_SAFE)
+			qmp->dp_active = false;
+
 		/* No DP SVID => don't care, assume it's just USB3 */
 		new_mode = QMPPHY_MODE_USB3_ONLY;
 	}
-- 
