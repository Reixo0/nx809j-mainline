From afc20a679269555ae16e5d7e7ac84533ab0be57a Mon Sep 17 00:00:00 2001
From: Reixo <125610085+Reixo0@users.noreply.github.com>
Date: Sat, 31 Oct 2026 18:26:23 +0100
Subject: [PATCH] ASoC: qcom: q6apm-voice: wait out the audio server probing
 the verb

PipeWire enables each UCM verb while it probes the card. When that took longer
than the 300 ms debounce the voice session started, the HiFi PCMs failed to
open and PipeWire dropped the HiFi profile. Wait two seconds.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sound/soc/qcom/qdsp6/q6apm-voice.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/sound/soc/qcom/qdsp6/q6apm-voice.c b/sound/soc/qcom/qdsp6/q6apm-voice.c
index ac28f59e9adb..24572387ee9b 100644
--- a/sound/soc/qcom/qdsp6/q6apm-voice.c
+++ b/sound/soc/qcom/qdsp6/q6apm-voice.c
@@ -774,7 +774,7 @@ static int q6apm_voice_ucm_put(struct q6apm_voice *voice, bool requested)
 		voice->ucm_pinned = true;
 		WRITE_ONCE(voice->ucm_requested, true);
 		/* UCM card probing may briefly enable devices. Debounce START. */
-		queue_delayed_work(system_long_wq, &voice->ucm_work, msecs_to_jiffies(300));
+		queue_delayed_work(system_long_wq, &voice->ucm_work, msecs_to_jiffies(2000));
 		return 1;
 	}
 	/* Never hold operation_lock while joining a worker that takes it. */
-- 
