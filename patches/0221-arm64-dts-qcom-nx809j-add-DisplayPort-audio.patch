From 22ea0c26139ac0a422b52ef62ccb41534bc0b170 Mon Sep 17 00:00:00 2001
From: Reixo <125610085+Reixo0@users.noreply.github.com>
Date: Mon, 2 Nov 2026 12:56:47 +0100
Subject: [PATCH] arm64: dts: qcom: nx809j: add DisplayPort audio

Add the DisplayPort playback link to the sound card, from the DSP's
DISPLAY_PORT_RX_0 port to the DP controller's audio codec, so a monitor
on the USB-C port can play sound.

Based on the OnePlus Pad 4 change by mzak.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/qcom/kaanapali-nubia-nx809j.dts     | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts b/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts
index 4244362e0622..37eada94a408 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts
@@ -435,6 +435,22 @@ platform {
 				sound-dai = <&q6apm>;
 			};
 		};
+
+		displayport-0-dai-link {
+			link-name = "DisplayPort0 Playback";
+
+			codec {
+				sound-dai = <&mdss_dp0>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai DISPLAY_PORT_RX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
 	};
 
 	wcn-pmu {
-- 
