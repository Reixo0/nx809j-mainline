From f15a5199cf4e355014a6f6b6deadb5e9ddd11024 Mon Sep 17 00:00:00 2001
From: Doctor Logix <doctor.logix@gmail.com>
Date: Wed, 28 Oct 2026 17:08:40 +0100
Subject: [PATCH 152/162] phy: add a MIPI C-PHY mode and configuration set

A C-PHY receiver needs the symbol rate per trio and the number of
trios. Add PHY_MODE_MIPI_CPHY and phy_configure_opts_mipi_cphy for
them, beside the D-PHY set.

(cherry picked from commit 464189f2ce48bfa87c6d243263be3d0ac04c6e3d)
---
 include/linux/phy/phy.h | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/include/linux/phy/phy.h b/include/linux/phy/phy.h
index c480d6cb42c5..5a7f064ed8fd 100644
--- a/include/linux/phy/phy.h
+++ b/include/linux/phy/phy.h
@@ -47,6 +47,7 @@ enum phy_mode {
 	PHY_MODE_DP,
 	PHY_MODE_HDMI,
 	PHY_MODE_TBT,
+	PHY_MODE_MIPI_CPHY,
 };
 
 enum phy_media {
@@ -64,11 +65,24 @@ union phy_notify {
 	enum phy_ufs_state ufs_state;
 };
 
+/**
+ * struct phy_configure_opts_mipi_cphy - MIPI C-PHY configuration set
+ *
+ * @symbol_rate:	Symbol rate per trio, in symbols per second.
+ * @trios:		Number of active trios, 1 to 3.
+ */
+struct phy_configure_opts_mipi_cphy {
+	u64 symbol_rate;
+	unsigned int trios;
+};
+
 /**
  * union phy_configure_opts - Opaque generic phy configuration
  *
  * @mipi_dphy:	Configuration set applicable for phys supporting
  *		the MIPI_DPHY phy mode.
+ * @mipi_cphy:	Configuration set applicable for phys supporting
+ *		the MIPI_CPHY phy mode.
  * @dp:		Configuration set applicable for phys supporting
  *		the DisplayPort protocol.
  * @lvds:	Configuration set applicable for phys supporting
@@ -78,6 +92,7 @@ union phy_notify {
  */
 union phy_configure_opts {
 	struct phy_configure_opts_mipi_dphy	mipi_dphy;
+	struct phy_configure_opts_mipi_cphy	mipi_cphy;
 	struct phy_configure_opts_dp		dp;
 	struct phy_configure_opts_lvds		lvds;
 	struct phy_configure_opts_hdmi		hdmi;
-- 
