From 3a61c5a1a171fca387d19c0ec922213f9fb88ecb Mon Sep 17 00:00:00 2001
From: Reixo <125610085+Reixo0@users.noreply.github.com>
Date: Tue, 3 Nov 2026 00:48:04 +0100
Subject: [PATCH] power: supply: qcom_battmgr: work out SM8550 battery power
 from V and I

The SM8550 battery manager firmware reports the battery power in nW as a
32-bit value, which is a thousand times the unit power_now expects and
wraps around above about 2.1 W, so power_now read 986 W for 1 W of
charging and turned positive while discharging at 3.5 W.

Work it out from the battery voltage and current instead, read together.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/qcom_battmgr.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index 594063b62ec9..10b0a3361f5b 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -465,6 +465,18 @@ static int qcom_battmgr_bat_sm8350_update(struct qcom_battmgr *battmgr,
 
 	mutex_lock(&battmgr->lock);
 	ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET, prop, 0);
+	/*
+	 * SM8550 firmware reports power in nW in 32 bits, which wraps above
+	 * about 2 W, so work it out from the voltage and current instead
+	 */
+	if (!ret && psp == POWER_SUPPLY_PROP_POWER_NOW &&
+	    battmgr->variant == QCOM_BATTMGR_SM8550) {
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET,
+						    BATT_CURR_NOW, 0);
+		if (!ret)
+			ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET,
+							    BATT_VOLT_NOW, 0);
+	}
 	mutex_unlock(&battmgr->lock);
 
 	return ret;
@@ -563,6 +575,11 @@ static int qcom_battmgr_bat_get_property(struct power_supply *psy,
 		val->intval = battmgr->status.current_now;
 		break;
 	case POWER_SUPPLY_PROP_POWER_NOW:
+		if (battmgr->variant == QCOM_BATTMGR_SM8550) {
+			val->intval = div_s64((s64)battmgr->status.current_now *
+					      battmgr->status.voltage_now, 1000000);
+			break;
+		}
 		val->intval = battmgr->status.power_now;
 		break;
 	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
-- 
