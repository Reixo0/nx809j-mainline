From f17dedab62a0195059617a2c2402eb836cd2eb7c Mon Sep 17 00:00:00 2001
From: Reixo <125610085+Reixo0@users.noreply.github.com>
Date: Wed, 25 Nov 2026 16:50:10 +0100
Subject: [PATCH 319/319] wifi: ath12k: make net-detect work while not connected

WoW net-detect never armed the firmware's PNO scan when the station
was not connected, which is the only case it is for:

- A station that is not connected has no vdev: ath12k creates it only
  for a connection or a scan, and deletes the scan vdev when the scan
  ends. ath12k_wow_set_wakeups() walks the existing vdevs, so it found
  none and armed nothing. Create a vdev on a scan link for the sleep
  when there is none, and delete it on resume.

- cfg80211 fills a net-detect request without channels with every
  enabled one, about 100 with 6 GHz, and the firmware takes at most
  WMI_PNO_MAX_NETW_CHANNELS_EX. The whole request was then dropped
  without a word. Keep 6 GHz to its preferred scanning channels and
  cut the rest, with a warning, and warn when a request is refused.

- The PNO stop at resume only walked the default links, so it missed
  the scan-link vdev, left nlo_enabled set and every later suspend
  skipped net-detect. Remember the vdev PNO runs on and stop it there.
  A failed stop no longer fails the resume.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/net/wireless/ath/ath12k/mac.c |  82 +++++++++++++++
 drivers/net/wireless/ath/ath12k/mac.h |   3 +
 drivers/net/wireless/ath/ath12k/wow.c | 146 +++++++++++++++++++-------
 drivers/net/wireless/ath/ath12k/wow.h |   6 ++
 4 files changed, 197 insertions(+), 40 deletions(-)

diff --git a/drivers/net/wireless/ath/ath12k/mac.c b/drivers/net/wireless/ath/ath12k/mac.c
index 4a0d71a80eeb..0701f3a99dd2 100644
--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -11005,6 +11005,88 @@ static struct ath12k *ath12k_mac_assign_vif_to_vdev(struct ieee80211_hw *hw,
 	return arvif->ar;
 }
 
+#ifdef CONFIG_PM
+struct ath12k_mac_nd_vif_iter {
+	struct ieee80211_vif *vif;
+};
+
+static void ath12k_mac_nd_vif_iter(void *data, u8 *mac,
+				   struct ieee80211_vif *vif)
+{
+	struct ath12k_mac_nd_vif_iter *iter = data;
+	struct ath12k_vif *ahvif = ath12k_vif_to_ahvif(vif);
+
+	if (iter->vif || vif->type != NL80211_IFTYPE_STATION || vif->p2p ||
+	    ahvif->vdev_type != WMI_VDEV_TYPE_STA)
+		return;
+
+	iter->vif = vif;
+}
+
+/*
+ * Net-detect in WoW needs a vdev to run the firmware scans on, but a
+ * station that is not connected has none: its vdev is only created for
+ * a connection or a scan, and the scan one is deleted when the scan ends.
+ * Find the vdev of the first station on @ar, creating one on a scan link
+ * when there is none. *@created tells the caller to release it with
+ * ath12k_mac_wow_nd_vdev_put() on resume.
+ */
+struct ath12k_link_vif *ath12k_mac_wow_nd_vdev_get(struct ath12k *ar,
+						   bool *created)
+{
+	struct ieee80211_hw *hw = ath12k_ar_to_hw(ar);
+	struct ath12k_mac_nd_vif_iter iter = {};
+	struct ath12k_link_vif *arvif;
+	struct ath12k_vif *ahvif;
+	u8 link_id;
+	int ret;
+
+	lockdep_assert_wiphy(hw->wiphy);
+
+	*created = false;
+
+	ieee80211_iterate_active_interfaces_mtx(hw, IEEE80211_IFACE_ITER_NORMAL,
+						ath12k_mac_nd_vif_iter, &iter);
+	if (!iter.vif)
+		return ERR_PTR(-ENOENT);
+
+	ahvif = ath12k_vif_to_ahvif(iter.vif);
+	link_id = ath12k_mac_find_link_id_by_ar(ahvif, ar);
+	if (link_id >= ATH12K_NUM_MAX_LINKS)
+		return ERR_PTR(-EBUSY);
+
+	arvif = ath12k_mac_assign_link_vif(ar->ah, iter.vif, link_id);
+	if (!arvif)
+		return ERR_PTR(-ENOMEM);
+
+	if (arvif->is_created)
+		return arvif;
+
+	ret = ath12k_mac_vdev_create(ar, arvif);
+	if (ret) {
+		ath12k_mac_unassign_link_vif(arvif);
+		return ERR_PTR(ret);
+	}
+
+	ath12k_dbg(ar->ab, ATH12K_DBG_MAC,
+		   "mac net-detect vdev %d created (link id %u)\n",
+		   arvif->vdev_id, arvif->link_id);
+	*created = true;
+
+	return arvif;
+}
+
+void ath12k_mac_wow_nd_vdev_put(struct ath12k_link_vif *arvif)
+{
+	struct ieee80211_hw *hw = ath12k_ar_to_hw(arvif->ar);
+
+	lockdep_assert_wiphy(hw->wiphy);
+
+	ath12k_mac_remove_link_interface(hw, arvif);
+	ath12k_mac_unassign_link_vif(arvif);
+}
+#endif
+
 int ath12k_mac_op_add_interface(struct ieee80211_hw *hw,
 				struct ieee80211_vif *vif)
 {
diff --git a/drivers/net/wireless/ath/ath12k/mac.h b/drivers/net/wireless/ath/ath12k/mac.h
index d97412da3b03..ac20b3a022fd 100644
--- a/drivers/net/wireless/ath/ath12k/mac.h
+++ b/drivers/net/wireless/ath/ath12k/mac.h
@@ -182,6 +182,9 @@ enum hal_encrypt_type ath12k_dp_tx_get_encrypt_type(u32 cipher);
 int ath12k_mac_rfkill_enable_radio(struct ath12k *ar, bool enable);
 int ath12k_mac_rfkill_config(struct ath12k *ar);
 int ath12k_mac_wait_tx_complete(struct ath12k *ar);
+struct ath12k_link_vif *ath12k_mac_wow_nd_vdev_get(struct ath12k *ar,
+						   bool *created);
+void ath12k_mac_wow_nd_vdev_put(struct ath12k_link_vif *arvif);
 void ath12k_mac_handle_beacon(struct ath12k *ar, struct sk_buff *skb);
 void ath12k_mac_handle_beacon_miss(struct ath12k *ar,
 				   struct ath12k_link_vif *arvif);
diff --git a/drivers/net/wireless/ath/ath12k/wow.c b/drivers/net/wireless/ath/ath12k/wow.c
index ae9820c5b9b3..1062eaedebc8 100644
--- a/drivers/net/wireless/ath/ath12k/wow.c
+++ b/drivers/net/wireless/ath/ath12k/wow.c
@@ -265,7 +265,8 @@ ath12k_wow_pno_check_and_convert(struct ath12k *ar, u32 vdev_id,
 				 const struct cfg80211_sched_scan_request *nd_config,
 				 struct wmi_pno_scan_req_arg *pno)
 {
-	int i, j;
+	struct ieee80211_channel *chans[WMI_PNO_MAX_NETW_CHANNELS_EX];
+	int i, j, n_chans = 0;
 	u8 ssid_len;
 
 	pno->enable = 1;
@@ -276,8 +277,25 @@ ath12k_wow_pno_check_and_convert(struct ath12k *ar, u32 vdev_id,
 	    pno->uc_networks_count > WMI_PNO_MAX_SUPP_NETWORKS)
 		return -EINVAL;
 
-	if (nd_config->n_channels > WMI_PNO_MAX_NETW_CHANNELS_EX)
-		return -EINVAL;
+	/*
+	 * The firmware takes at most WMI_PNO_MAX_NETW_CHANNELS_EX channels,
+	 * and a phone has about 100 with 6 GHz: keep 6 GHz to its preferred
+	 * scanning channels then, as phones scan, rather than refusing.
+	 */
+	for (j = 0; j < nd_config->n_channels; j++) {
+		struct ieee80211_channel *chan = nd_config->channels[j];
+
+		if (nd_config->n_channels > WMI_PNO_MAX_NETW_CHANNELS_EX &&
+		    chan->band == NL80211_BAND_6GHZ &&
+		    !cfg80211_channel_is_psc(chan))
+			continue;
+		if (n_chans == WMI_PNO_MAX_NETW_CHANNELS_EX)
+			break;
+		chans[n_chans++] = chan;
+	}
+	if (n_chans < nd_config->n_channels)
+		ath12k_warn(ar->ab, "net-detect on %d of %d channels\n",
+			    n_chans, nd_config->n_channels);
 
 	/* Filling per profile params */
 	for (i = 0; i < pno->uc_networks_count; i++) {
@@ -296,13 +314,11 @@ ath12k_wow_pno_check_and_convert(struct ath12k *ar, u32 vdev_id,
 		pno->a_networks[i].bcast_nw_type  = 0;
 
 		/* Copying list of valid channel into request */
-		pno->a_networks[i].channel_count = nd_config->n_channels;
+		pno->a_networks[i].channel_count = n_chans;
 		pno->a_networks[i].rssi_threshold = nd_config->match_sets[i].rssi_thold;
 
-		for (j = 0; j < nd_config->n_channels; j++) {
-			pno->a_networks[i].channels[j] =
-					nd_config->channels[j]->center_freq;
-		}
+		for (j = 0; j < n_chans; j++)
+			pno->a_networks[i].channels[j] = chans[j]->center_freq;
 	}
 
 	/* set scan to passive if no SSIDs are specified in the request */
@@ -396,13 +412,16 @@ static int ath12k_wow_vif_set_wakeups(struct ath12k_link_vif *arvif,
 			if (!pno)
 				return -ENOMEM;
 
-			ar->nlo_enabled = true;
-
 			ret = ath12k_wow_pno_check_and_convert(ar, arvif->vdev_id,
 							       wowlan->nd_config, pno);
 			if (!ret) {
 				ath12k_wmi_wow_config_pno(ar, arvif->vdev_id, pno);
+				ar->nlo_enabled = true;
+				ar->wow.nlo_vdev_id = arvif->vdev_id;
 				__set_bit(WOW_NLO_DETECTED_EVENT, &wow_mask);
+			} else {
+				ath12k_warn(ar->ab, "net-detect request refused: %d\n",
+					    ret);
 			}
 
 			kfree(pno);
@@ -509,56 +528,94 @@ static int ath12k_wow_vdev_clean_nlo(struct ath12k *ar, u32 vdev_id)
 		return -ENOMEM;
 
 	pno->enable = 0;
+	ar->nlo_enabled = false;
 	ret = ath12k_wmi_wow_config_pno(ar, vdev_id, pno);
-	if (ret) {
+	if (ret)
 		ath12k_warn(ar->ab, "failed to disable PNO: %d", ret);
-		goto out;
-	}
-
-	ar->nlo_enabled = false;
 
-out:
 	kfree(pno);
 	return ret;
 }
 
-static int ath12k_wow_vif_clean_nlo(struct ath12k_link_vif *arvif)
+/*
+ * Stop net-detect on the vdev it was set on. That may be the scan-link vdev
+ * of a station that is not connected (ath12k_wow_set_nd_vdev()), which a
+ * walk over the default links would miss, leaving nlo_enabled set and
+ * net-detect off for every later suspend.
+ */
+static int ath12k_wow_nlo_cleanup(struct ath12k *ar)
 {
-	struct ath12k *ar = arvif->ar;
+	int ret;
 
-	switch (arvif->ahvif->vdev_type) {
-	case WMI_VDEV_TYPE_STA:
-		return ath12k_wow_vdev_clean_nlo(ar, arvif->vdev_id);
-	default:
-		return 0;
-	}
+	lockdep_assert_wiphy(ath12k_ar_to_hw(ar)->wiphy);
+
+	ret = ath12k_wow_vdev_clean_nlo(ar, ar->wow.nlo_vdev_id);
+	if (ret)
+		ath12k_warn(ar->ab, "failed to clean nlo settings on vdev %i: %d\n",
+			    ar->wow.nlo_vdev_id, ret);
+
+	return ret;
 }
 
-static int ath12k_wow_nlo_cleanup(struct ath12k *ar)
+/*
+ * A station that is not connected has no vdev, so ath12k_wow_set_wakeups()
+ * skipped its net-detect: give it one for the sleep.
+ */
+static void ath12k_wow_nd_vdev_release(struct ath12k *ar);
+
+static int ath12k_wow_set_nd_vdev(struct ath12k *ar,
+				  struct cfg80211_wowlan *wowlan)
 {
 	struct ath12k_link_vif *arvif;
+	bool created;
 	int ret;
 
-	lockdep_assert_wiphy(ath12k_ar_to_hw(ar)->wiphy);
+	if (!wowlan->nd_config || ar->nlo_enabled)
+		return 0;
 
-	list_for_each_entry(arvif, &ar->arvifs, list) {
-		if (arvif != &arvif->ahvif->deflink)
-			continue;
+	arvif = ath12k_mac_wow_nd_vdev_get(ar, &created);
+	if (IS_ERR(arvif)) {
+		ath12k_warn(ar->ab, "no vdev for net-detect: %ld\n",
+			    PTR_ERR(arvif));
+		return 0;
+	}
 
-		if (ath12k_wow_is_p2p_vdev(arvif->ahvif))
-			continue;
+	if (created)
+		ar->wow.nd_arvif = arvif;
 
-		ret = ath12k_wow_vif_clean_nlo(arvif);
-		if (ret) {
-			ath12k_warn(ar->ab, "failed to clean nlo settings on vdev %i: %d\n",
-				    arvif->vdev_id, ret);
-			return ret;
-		}
+	ret = ath12k_wow_vif_set_wakeups(arvif, wowlan);
+	if (ret) {
+		/* Sleep with WoW all the same, without net-detect */
+		ath12k_warn(ar->ab, "failed to set net-detect on vdev %i: %d\n",
+			    arvif->vdev_id, ret);
+		ath12k_wow_nd_vdev_release(ar);
 	}
 
 	return 0;
 }
 
+static void ath12k_wow_nd_vdev_release(struct ath12k *ar)
+{
+	struct ath12k_link_vif *arvif = ar->wow.nd_arvif;
+	int ret;
+
+	if (!arvif)
+		return;
+
+	ar->wow.nd_arvif = NULL;
+
+	/* The firmware is gone: the recovery drops the vdevs */
+	if (test_bit(ATH12K_FLAG_CRASH_FLUSH, &ar->ab->dev_flags) ||
+	    test_bit(ATH12K_FLAG_UNRESPONSIVE, &ar->ab->dev_flags))
+		return;
+
+	ret = ath12k_wow_nlo_cleanup(ar);
+	if (ret)
+		ath12k_warn(ar->ab, "failed to cleanup nlo: %d\n", ret);
+
+	ath12k_mac_wow_nd_vdev_put(arvif);
+}
+
 static int ath12k_wow_set_hw_filter(struct ath12k *ar)
 {
 	struct wmi_hw_data_filter_arg arg;
@@ -902,6 +959,10 @@ int ath12k_wow_op_suspend(struct ieee80211_hw *hw,
 		goto cleanup;
 	}
 
+	ret = ath12k_wow_set_nd_vdev(ar, wowlan);
+	if (ret)
+		goto cleanup;
+
 	ret = ath12k_wow_protocol_offload(ar, true);
 	if (ret) {
 		ath12k_warn(ar->ab, "failed to set wow protocol offload events: %d\n",
@@ -942,6 +1003,7 @@ int ath12k_wow_op_suspend(struct ieee80211_hw *hw,
 		ath12k_warn(ar->ab, "wow refused (%u in a row), suspend called off\n",
 			    ar->wow.refused);
 		ath12k_wow_undo_suspend(ar);
+		ath12k_wow_nd_vdev_release(ar);
 		return -EBUSY;
 	}
 	if (ret) {
@@ -967,6 +1029,7 @@ int ath12k_wow_op_suspend(struct ieee80211_hw *hw,
 
 cleanup:
 	ath12k_wow_cleanup(ar);
+	ath12k_wow_nd_vdev_release(ar);
 
 exit:
 	return ret ? 1 : 0;
@@ -1016,11 +1079,12 @@ int ath12k_wow_op_resume(struct ieee80211_hw *hw)
 		goto exit;
 	}
 
+	/* Not fatal: the firmware drops it with the vdev or the next config */
 	ret = ath12k_wow_nlo_cleanup(ar);
-	if (ret) {
+	if (ret)
 		ath12k_warn(ar->ab, "failed to cleanup nlo: %d\n", ret);
-		goto exit;
-	}
+
+	ath12k_wow_nd_vdev_release(ar);
 
 	ret = ath12k_wow_clear_hw_filter(ar);
 	if (ret) {
@@ -1045,6 +1109,8 @@ int ath12k_wow_op_resume(struct ieee80211_hw *hw)
 
 exit:
 	if (ret) {
+		ath12k_wow_nd_vdev_release(ar);
+
 		switch (ah->state) {
 		case ATH12K_HW_STATE_ON:
 			ah->state = ATH12K_HW_STATE_RESTARTING;
diff --git a/drivers/net/wireless/ath/ath12k/wow.h b/drivers/net/wireless/ath/ath12k/wow.h
index 1cfc17d11dd2..6eac7299c9ef 100644
--- a/drivers/net/wireless/ath/ath12k/wow.h
+++ b/drivers/net/wireless/ath/ath12k/wow.h
@@ -11,12 +11,18 @@
 #define ATH12K_WOW_REFUSED_MAX		30
 #define ATH12K_WOW_PATTERNS		22
 
+struct ath12k_link_vif;
+
 struct ath12k_wow {
 	u32 max_num_patterns;
 	struct completion wakeup_completed;
 	struct wiphy_wowlan_support wowlan_support;
 	/* Suspends in a row the firmware refused WoW for */
 	u32 refused;
+	/* vdev created for net-detect while not connected, if any */
+	struct ath12k_link_vif *nd_arvif;
+	/* vdev net-detect runs on, while ar->nlo_enabled */
+	u32 nlo_vdev_id;
 };
 
 struct ath12k_pkt_pattern {
-- 
2.56.1

