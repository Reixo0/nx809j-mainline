From 9498520fab582f01d67a6dd7f33d5fc505b64ebc Mon Sep 17 00:00:00 2001
From: Reixo <125610085+Reixo0@users.noreply.github.com>
Date: Sun, 8 Nov 2026 11:21:02 +0100
Subject: [PATCH] arm64: dts: qcom: kaanapali-nubia-nx809j: add ECC to ramoops

The RAM holding ramoops isn't refreshed for a moment during a reset, and
about 2% of the bytes come back flipped. A flip in the buffer's start or
size made Linux show stale Android text instead of the previous log.

With 16 bytes of Reed-Solomon parity per block the header is checked and
most flips are repaired: a test reboot corrected 2606 bytes and left 57
of ~1150 blocks unrecoverable. Android (ecc 0) still reads the text,
uncorrected.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts b/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts
index 758b2d7af4eb..d7ac83dc22b4 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts
@@ -193,12 +193,19 @@ cont_splash_mem: cont-splash@fc800000 {
 		 * Same layout as downstream (incl. write-combine mem-type 0), so
 		 * Android shows our log in /sys/fs/pstore. A cached mapping would
 		 * lose the log in the CPU caches on a hard reset.
+		 *
+		 * The RAM isn't refreshed for a moment during a reset, so about 2%
+		 * of the bytes come back flipped. Reed-Solomon parity repairs most
+		 * of them, the header too; a flipped start or size made Linux show
+		 * stale data instead of the last log. Android (ecc 0) still reads
+		 * the text, just uncorrected.
 		 */
 		ramoops@e2000000 {
 			compatible = "ramoops";
 			reg = <0x0 0xe2000000 0x0 0x200000>;
 			console-size = <0x200000>;
 			mem-type = <0>;
+			ecc-size = <16>;
 		};
 	};
 
