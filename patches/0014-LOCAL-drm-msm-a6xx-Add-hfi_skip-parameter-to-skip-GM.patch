From 8e991da3c1202e73b5b0ed25be06076036270ab4 Mon Sep 17 00:00:00 2001
From: Reixo <125610085+Reixo0@users.noreply.github.com>
Date: Sat, 24 Oct 2026 01:26:50 +0200
Subject: [PATCH 14/27] [LOCAL] drm/msm/a6xx: Add hfi_skip parameter to skip
 GMU power features

Not for upstream: a bring-up switch. Bits 0..3 skip the CLX table, the
IFF/PCLX limits table, ACD and IFPC when starting the GMU. Writable at
runtime; GPU init is retried on the next open of a DRM node if it failed.

On the Nubia RedMagic 11 Pro (Adreno 840), sending the reference CLX table
makes the GMU hang on the first GX_BW_PERF_VOTE; hfi_skip=3 works.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/msm/adreno/a6xx_hfi.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/drivers/gpu/drm/msm/adreno/a6xx_hfi.c b/drivers/gpu/drm/msm/adreno/a6xx_hfi.c
index 6b34e704a..b49d8803a 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_hfi.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_hfi.c
@@ -12,6 +12,15 @@
 #include "a6xx_gmu.xml.h"
 #include "a6xx_gpu.h"
 
+/*
+ * DEBUG (nx809j bring-up, not for upstream): skip GMU power features at
+ * runtime to find what the GMU chokes on. Bits: 0 = CLX table, 1 = IFF/PCLX
+ * limits, 2 = ACD, 3 = IFPC. GPU init is retried on every open of a
+ * /dev/dri node, so: echo N > /sys/module/msm/parameters/hfi_skip; then open.
+ */
+static unsigned int hfi_skip;
+module_param(hfi_skip, uint, 0600);
+
 #define HFI_MSG_ID(val) [val] = #val
 
 static const char * const a6xx_hfi_msg_id[] = {
@@ -857,6 +866,9 @@ static int a6xx_hfi_feature_ctrl_msg(struct a6xx_gmu *gmu, u32 feature, u32 enab
 
 static int a6xx_hfi_enable_ifpc(struct a6xx_gmu *gmu)
 {
+	if (hfi_skip & BIT(3))
+		return 0;
+
 	if (gmu->idle_level != GMU_IDLE_STATE_IFPC)
 		return 0;
 
@@ -868,6 +880,9 @@ static int a6xx_hfi_enable_acd(struct a6xx_gmu *gmu)
 	struct a6xx_hfi_acd_table *acd_table = &gmu->acd_table;
 	int ret;
 
+	if (hfi_skip & BIT(2))
+		return 0;
+
 	if (!acd_table->enable_by_level)
 		return 0;
 
@@ -890,6 +905,9 @@ static int a6xx_hfi_enable_acd(struct a6xx_gmu *gmu)
 
 static int a6xx_hfi_enable_iff_pclx(struct a6xx_gmu *gmu, const struct a6xx_limits_tbl *limits)
 {
+	if (hfi_skip & BIT(1))
+		return 0;
+
 	struct a6xx_hfi_table_entry *entry;
 	struct a6xx_hfi_table *tbl;
 	size_t entry_size;
@@ -938,6 +956,9 @@ static int a6xx_hfi_enable_clx(struct a6xx_gmu *gmu)
 	if (!info->clx_tbl)
 		return 0;
 
+	if (hfi_skip & BIT(0))
+		return a6xx_hfi_enable_iff_pclx(gmu, info->limits_tbl);
+
 	ret = a6xx_hfi_feature_ctrl_msg(gmu, HFI_FEATURE_CLX, 1, 0);
 	if (ret) {
 		DRM_DEV_ERROR(gmu->dev, "Unable to enable CLX (%d)\n", ret);
-- 
