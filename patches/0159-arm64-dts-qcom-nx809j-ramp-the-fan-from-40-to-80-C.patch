From 271f599336cb5da1740f6ce3fc9fa0b1858f4249 Mon Sep 17 00:00:00 2001
From: Doctor Logix <doctor.logix@gmail.com>
Date: Wed, 28 Oct 2026 18:30:56 +0100
Subject: [PATCH 159/162] arm64: dts: qcom: nx809j: ramp the fan from 40 to 80
 C

The fan's speed follows its PWM duty almost linearly, from about
1,200 rpm at 4/63 of the LPG's 6-bit duty to about 20,800 rpm at full
duty; 3/63 and below do not start it from a stop. Give it 21 levels,
from 5/63 to full, and a trip every 2 C from 40 to 80 C on the prime
core and GPU sensors, each level holding until 2 C below its trip.

The pump switches on at the vendor's high level at 70 C and off below
65 C.

(cherry picked from commit 4b81abfc6532094cc397461c36e41f40e72f7e3f)
---
 .../boot/dts/qcom/kaanapali-nubia-nx809j.dts  | 265 ++++++------------
 1 file changed, 90 insertions(+), 175 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts b/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts
index 0b8f7a61cbbe..9317b7968140 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts
@@ -305,7 +305,12 @@ fan: pwm-fan {
 		interrupts-extended = <&tlmm 211 IRQ_TYPE_EDGE_FALLING>;
 		/* downstream computes rpm = pulses per 0.5 s * 40 */
 		pulses-per-revolution = <3>;
-		cooling-levels = <0 51 102 153 204 255>;
+		/*
+		 * Off, then from 5/63 of the LPG's 6-bit duty (4/63 is the
+		 * lowest that starts it from a stop) evenly to full speed.
+		 */
+		cooling-levels = <0 20 32 44 55 67 79 91 102 114 126 138 149 161
+				  173 185 196 208 220 232 243 255>;
 		#cooling-cells = <2>;
 
 		pinctrl-0 = <&fan_pwm_default>, <&fan_tach_default>;
@@ -2150,191 +2155,101 @@ &usb_dwc3_hs {
 
 
 /*
- * Fan and liquid cooling pump follow the prime core and GPU sensors: fan
- * levels 1-5 from 45 to 65 C, pump low/mid/high from 50 to 60 C.
+ * Fan and liquid cooling pump follow the prime core and GPU sensors. The fan
+ * starts at 40 C and goes up one level every 2 C to full speed at 80 C; each
+ * level holds until 2 C below its trip. The pump runs at the vendor's high
+ * level from 70 C until the sensors fall below 65 C.
  */
+#define FAN_TRIP(zone, n, temp)						\
+	zone##_fan##n: fan##n {						\
+		temperature = <temp>;					\
+		hysteresis = <2000>;					\
+		type = "active";					\
+	};
+
+#define FAN_MAP(zone, n)						\
+	map##n {							\
+		trip = <&zone##_fan##n>;				\
+		cooling-device = <&fan n n>;				\
+	};
+
+#define FAN_TRIPS(zone)							\
+	FAN_TRIP(zone, 1, 40000)					\
+	FAN_TRIP(zone, 2, 42000)					\
+	FAN_TRIP(zone, 3, 44000)					\
+	FAN_TRIP(zone, 4, 46000)					\
+	FAN_TRIP(zone, 5, 48000)					\
+	FAN_TRIP(zone, 6, 50000)					\
+	FAN_TRIP(zone, 7, 52000)					\
+	FAN_TRIP(zone, 8, 54000)					\
+	FAN_TRIP(zone, 9, 56000)					\
+	FAN_TRIP(zone, 10, 58000)					\
+	FAN_TRIP(zone, 11, 60000)					\
+	FAN_TRIP(zone, 12, 62000)					\
+	FAN_TRIP(zone, 13, 64000)					\
+	FAN_TRIP(zone, 14, 66000)					\
+	FAN_TRIP(zone, 15, 68000)					\
+	FAN_TRIP(zone, 16, 70000)					\
+	FAN_TRIP(zone, 17, 72000)					\
+	FAN_TRIP(zone, 18, 74000)					\
+	FAN_TRIP(zone, 19, 76000)					\
+	FAN_TRIP(zone, 20, 78000)					\
+	FAN_TRIP(zone, 21, 80000)
+
+#define FAN_MAPS(zone)							\
+	FAN_MAP(zone, 1)						\
+	FAN_MAP(zone, 2)						\
+	FAN_MAP(zone, 3)						\
+	FAN_MAP(zone, 4)						\
+	FAN_MAP(zone, 5)						\
+	FAN_MAP(zone, 6)						\
+	FAN_MAP(zone, 7)						\
+	FAN_MAP(zone, 8)						\
+	FAN_MAP(zone, 9)						\
+	FAN_MAP(zone, 10)						\
+	FAN_MAP(zone, 11)						\
+	FAN_MAP(zone, 12)						\
+	FAN_MAP(zone, 13)						\
+	FAN_MAP(zone, 14)						\
+	FAN_MAP(zone, 15)						\
+	FAN_MAP(zone, 16)						\
+	FAN_MAP(zone, 17)						\
+	FAN_MAP(zone, 18)						\
+	FAN_MAP(zone, 19)						\
+	FAN_MAP(zone, 20)						\
+	FAN_MAP(zone, 21)
+
+#define PUMP_TRIP(zone)							\
+	zone##_pump: pump {						\
+		temperature = <70000>;					\
+		hysteresis = <5000>;					\
+		type = "active";					\
+	};
+
+#define PUMP_MAP(zone)							\
+	map-pump {							\
+		trip = <&zone##_pump>;					\
+		cooling-device = <&micropump 3 3>;			\
+	};
+
 &{/thermal-zones/cpu-1-0-0-thermal} {
 	cooling-maps {
-		fan1 {
-			trip = <&cpu_1_0_0_fan1>;
-			cooling-device = <&fan 1 1>;
-		};
-
-		fan2 {
-			trip = <&cpu_1_0_0_fan2>;
-			cooling-device = <&fan 2 2>;
-		};
-
-		fan3 {
-			trip = <&cpu_1_0_0_fan3>;
-			cooling-device = <&fan 3 3>;
-		};
-
-		fan4 {
-			trip = <&cpu_1_0_0_fan4>;
-			cooling-device = <&fan 4 4>;
-		};
-
