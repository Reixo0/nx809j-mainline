Subject: [PATCH 272/274] arm64: dts: qcom: nx809j: enable the video codec

Use the phone's signed vpu40_2v.mbn firmware.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts b/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts
index 7027f1e4b4e8..748cb79fdaf9 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-nubia-nx809j.dts
@@ -1785,6 +1785,12 @@ &ipa {
 	status = "okay";
 };
 
+&iris {
+	firmware-name = "qcom/kaanapali/nubia/nx809j/vpu40_2v.mbn";
+
+	status = "okay";
+};
+
 &lpass_wsa2macro {
 	status = "disabled";
 };
