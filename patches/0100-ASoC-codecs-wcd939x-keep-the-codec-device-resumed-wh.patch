From 796085c81ce74d12ba6a10cc90996af9732d6291 Mon Sep 17 00:00:00 2001
From: Reixo <125610085+Reixo0@users.noreply.github.com>
Date: Sun, 25 Oct 2026 19:23:40 +0100
Subject: [PATCH 100/102] ASoC: codecs: wcd939x: keep the codec device resumed
 while a jack is set

Holding only the SoundWire RX/TX devices is not enough: the codec platform
device still runtime suspends, and jack removal is then not reported. Hold
it up as well for as long as a jack is registered.
---
 sound/soc/codecs/wcd939x.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/sound/soc/codecs/wcd939x.c b/sound/soc/codecs/wcd939x.c
index a898879e3..eff33e775 100644
--- a/sound/soc/codecs/wcd939x.c
+++ b/sound/soc/codecs/wcd939x.c
@@ -3443,6 +3443,7 @@ static int wcd939x_codec_set_jack(struct snd_soc_component *comp,
 		 * goes completely silent even though MBHC itself is armed and
 		 * powered. Hold them up for as long as a jack is registered.
 		 */
+		pm_runtime_forbid(comp->dev);
 		pm_runtime_forbid(wcd->rxdev);
 		pm_runtime_forbid(wcd->txdev);
 
@@ -3453,6 +3454,7 @@ static int wcd939x_codec_set_jack(struct snd_soc_component *comp,
 
 	pm_runtime_allow(wcd->txdev);
 	pm_runtime_allow(wcd->rxdev);
+	pm_runtime_allow(comp->dev);
 
 	return 0;
 }
