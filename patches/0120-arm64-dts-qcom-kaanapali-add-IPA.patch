From 7dacced0b6b158638f8a2ad024e2b950edec18f2 Mon Sep 17 00:00:00 2001
From: Reixo <125610085+Reixo0@users.noreply.github.com>
Date: Mon, 26 Oct 2026 17:12:35 +0100
Subject: [PATCH 120/165] arm64: dts: qcom: kaanapali: add IPA

Add the IPA node, disabled by default. The microcontroller firmware is
loaded by the AP (qcom,gsi-loader = "self") into ipa_gsi_mem.

As on the downstream kernel, IPA DMA is limited to IOVAs 0x20000000 to
0x3fffffff: with addresses above that, UFS stalls under mobile data
load. Its interrupt is level triggered, otherwise wakeups for downlink
data get lost and data stalls until the connection is restarted.

The modem tables live in IMEM at 0x14683000, so the IMEM node grows to
cover them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/kaanapali.dtsi | 60 ++++++++++++++++++++++++-
 1 file changed, 58 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali.dtsi b/arch/arm64/boot/dts/qcom/kaanapali.dtsi
index 300c8d503589..44a345e910f6 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali.dtsi
+++ b/arch/arm64/boot/dts/qcom/kaanapali.dtsi
@@ -389,6 +389,12 @@ ipa_gsi_mem: ipa-gsi@99590000 {
 			no-map;
 		};
 
+		/* IPA DMA may only use IOVAs 0x20000000-0x3fffffff */
+		ipa_iova_resv: ipa-iova-reserved {
+			iommu-addresses = <&ipa 0x0 0x0 0x0 0x20000000>,
+					  <&ipa 0x0 0x40000000 0xffffffff 0xc0000000>;
+		};
+
 		gpu_microcode_mem: gpu-microcode@9959a000 {
 			reg = <0x0 0x9959a000 0x0 0x2000>;
 			no-map;
@@ -3022,6 +3028,52 @@ adreno_smmu: iommu@3da0000 {
 			dma-coherent;
 		};
 
+		ipa: ipa@3f40000 {
+			compatible = "qcom,kaanapali-ipa", "qcom,sm8550-ipa";
+
+			iommus = <&apps_smmu 0x4a0 0x0>,
+				 <&apps_smmu 0x4a2 0x0>;
+			reg = <0x0 0x03f40000 0x0 0x10000>,
+			      <0x0 0x03f50000 0x0 0x5000>,
+			      <0x0 0x03e04000 0x0 0xfc000>;
+			reg-names = "ipa-reg",
+				    "ipa-shared",
+				    "gsi";
+
+			interrupts-extended = <&intc GIC_SPI 655 IRQ_TYPE_LEVEL_HIGH>,
+					      <&intc GIC_SPI 432 IRQ_TYPE_LEVEL_HIGH>,
+					      <&ipa_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
+					      <&ipa_smp2p_in 1 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "ipa",
+					  "gsi",
+					  "ipa-clock-query",
+					  "ipa-setup-ready";
+
+			clocks = <&rpmhcc RPMH_IPA_CLK>;
+			clock-names = "core";
+
+			interconnects = <&aggre_noc MASTER_IPA QCOM_ICC_TAG_ALWAYS
+					 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
+					<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
+					 &cnoc_main SLAVE_IPA_CFG QCOM_ICC_TAG_ACTIVE_ONLY>;
+			interconnect-names = "memory",
+					     "config";
+
+			qcom,qmp = <&aoss_qmp>;
+
+			qcom,smem-states = <&ipa_smp2p_out 0>,
+					   <&ipa_smp2p_out 1>;
+			qcom,smem-state-names = "ipa-clock-enabled-valid",
+						"ipa-clock-enabled";
+
+			qcom,gsi-loader = "self";
+			memory-region = <&ipa_gsi_mem>, <&ipa_iova_resv>;
+
+			sram = <&ipa_modem_tables>;
+
+			status = "disabled";
+		};
+
 		remoteproc_mpss: remoteproc@4080000 {
 			compatible = "qcom,kaanapali-mpss-pas", "qcom,sm8750-mpss-pas";
 			reg = <0x0 0x04080000 0x0 0x10000>;
@@ -5953,8 +6005,8 @@ tpdm_ipa_out: endpoint {
 
 		sram@14680000 {
 			compatible = "qcom,kaanapali-imem", "mmio-sram";
-			reg = <0x0 0x14680000 0x0 0x1000>;
-			ranges = <0x0 0x0 0x14680000 0x1000>;
+			reg = <0x0 0x14680000 0x0 0x5000>;
+			ranges = <0x0 0x0 0x14680000 0x5000>;
 
 			no-memory-wc;
 
@@ -5969,6 +6021,10 @@ pil-sram@94c {
 				compatible = "qcom,pil-reloc-info";
 				reg = <0x94c 0xc8>;
 			};
+
+			ipa_modem_tables: modem-tables@3000 {
+				reg = <0x3000 0x2000>;
+			};
 		};
 
 		apps_smmu: iommu@15000000 {
-- 
