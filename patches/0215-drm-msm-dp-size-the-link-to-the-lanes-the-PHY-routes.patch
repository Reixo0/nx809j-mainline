From f5b3a422dfa3fa1919e474004c0e9a87157a5715 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Mon, 19 Oct 2026 06:42:22 +0300
Subject: [PATCH] drm/msm/dp: size the link to the lanes the PHY routes to the
 connector

The link capabilities are the sink's DPCD limited by the data-lanes and
link-frequencies of the DT. Behind a USB-C connector that is not enough:
the DisplayPort alternate mode's pin assignment gives DisplayPort all
four lanes (C, E) or only two (D, F), the other two carrying USB3. A
board that describes four lanes for its DP-only case then validates
modes for four lanes on a pin assignment D sink and trains four lanes,
two of which reach the USB3 pins. Training falls back to two lanes at
best, and the mode chosen for four lanes does not fit in them: the sink
stays dark.

The QMP combo PHY reports the lanes of its Type-C mode as its bus width.
Cap the lane count with it when reading the link capabilities, which
happens at HPD before userspace probes the modes. A PHY that does not
report a width (0) leaves the DT limit alone.

The pin assignment can also change without an unplug, e.g. when a dock
gives up USB3; the Type-C driver then signals HPD again. Read the link
capabilities again on such an HPD if the PHY's lane count changed, so
that the modes probed next fit.

Log the result of every link capabilities read once, at info level: the
sink's lanes and rate, the PHY's lanes, the DT limits and the link
limits that come out. It is what tells whether a USB-C sink got the
lanes it should.

Signed-off-by: mzak <mzak.amin@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/msm/dp/dp_display.c | 18 +++++++++--
 drivers/gpu/drm/msm/dp/dp_panel.c   | 47 ++++++++++++++++++++++++++++-
 drivers/gpu/drm/msm/dp/dp_panel.h   |  4 ++-
 3 files changed, 64 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index 37cd8ba5b079..bd23e10ba89d 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -425,8 +425,20 @@ static int msm_dp_hpd_plug_handle(struct msm_dp_display_private *dp)
 			dp->link->sink_count);
 
 	guard(mutex)(&dp->plugged_lock);
-	if (dp->plugged)
-		return 0;
+	if (dp->plugged) {
+		/*
+		 * The USB-C mux can change the lanes routed to DisplayPort
+		 * without an unplug, e.g. when the sink gives up USB3. Read
+		 * the link capabilities again, so that the modes userspace
+		 * probes next fit the new lane count.
+		 */
+		if (!msm_dp_panel_routed_lanes_changed(dp->panel))
+			return 0;
+
+		msm_dp_display_host_phy_init(dp);
+
+		return msm_dp_display_process_hpd_high(dp);
+	}
 
 	ret = pm_runtime_resume_and_get(&pdev->dev);
 	if (ret) {
@@ -596,7 +608,7 @@ static int msm_dp_init_sub_modules(struct msm_dp_display_private *dp)
 		goto error_link;
 	}
 
-	dp->panel = msm_dp_panel_get(dev, dp->aux, dp->link, dp->link_base,
+	dp->panel = msm_dp_panel_get(dev, dp->aux, dp->link, phy, dp->link_base,
 				     dp->mst2link_base, dp->mst3link_base, dp->pixel_base[0]);
 	if (IS_ERR(dp->panel)) {
 		rc = PTR_ERR(dp->panel);
diff --git a/drivers/gpu/drm/msm/dp/dp_panel.c b/drivers/gpu/drm/msm/dp/dp_panel.c
index e633afdf2b47..82641b9494de 100644
--- a/drivers/gpu/drm/msm/dp/dp_panel.c
+++ b/drivers/gpu/drm/msm/dp/dp_panel.c
@@ -13,6 +13,7 @@
 #include <drm/drm_print.h>
 
 #include <linux/io.h>
+#include <linux/phy/phy.h>
 #include <linux/types.h>
 #include <asm/byteorder.h>
 
@@ -24,11 +25,14 @@ struct msm_dp_panel_private {
 	struct msm_dp_panel msm_dp_panel;
 	struct drm_dp_aux *aux;
 	struct msm_dp_link *link;
+	struct phy *phy;
 	void __iomem *link_base;
 	void __iomem *mst2link_base;
 	void __iomem *mst3link_base;
 	void __iomem *pixel_base;
 	bool panel_on;
+	/* routed lanes the link capabilities were last read with */
+	int routed_lanes;
 };
 
 u32 msm_dp_stream_reg(enum msm_dp_stream_id id, u32 reg)
@@ -96,6 +100,33 @@ u32 msm_dp_stream_reg(enum msm_dp_stream_id id, u32 reg)
 	}
 }
 
+/*
+ * The number of DP lanes the PHY routes to the connector, or 0 if it does not
+ * say. Behind a USB-C connector the PHY follows the DisplayPort alternate
+ * mode's pin assignment: four lanes for C and E, two for D and F, where the
+ * other two carry USB3.
+ */
+static int msm_dp_panel_routed_lanes(struct msm_dp_panel_private *panel)
+{
+	return phy_get_bus_width(panel->phy);
+}
+
+/**
+ * msm_dp_panel_routed_lanes_changed() - check the PHY's lanes against the caps
+ * @msm_dp_panel: DP panel
+ *
+ * Returns: true if the number of lanes the PHY routes to the connector changed
+ * since the link capabilities were read, e.g. because the USB-C mux switched
+ * the pin assignment, and the link capabilities have to be read again.
+ */
+bool msm_dp_panel_routed_lanes_changed(struct msm_dp_panel *msm_dp_panel)
+{
+	struct msm_dp_panel_private *panel =
+		container_of(msm_dp_panel, struct msm_dp_panel_private, msm_dp_panel);
+
+	return msm_dp_panel_routed_lanes(panel) != panel->routed_lanes;
+}
+
 static inline u32 msm_dp_read_link(struct msm_dp_panel_private *panel, u32 offset)
 {
 	offset = msm_dp_stream_reg(panel->msm_dp_panel.stream_id, offset);
@@ -288,6 +319,11 @@ static int msm_dp_panel_read_dpcd(struct msm_dp_panel *msm_dp_panel)
 	if (link_info->num_lanes > link->max_dp_lanes)
 		link_info->num_lanes = link->max_dp_lanes;
 
+	/* Limit data lanes to the lanes the PHY routes to the connector */
+	panel->routed_lanes = msm_dp_panel_routed_lanes(panel);
+	if (panel->routed_lanes > 0 && link_info->num_lanes > panel->routed_lanes)
+		link_info->num_lanes = panel->routed_lanes;
+
 	/* Limit data lanes from LTTPR capabilities, if any */
 	if (max_lttpr_lanes && max_lttpr_lanes < link_info->num_lanes)
 		link_info->num_lanes = max_lttpr_lanes;
@@ -356,6 +392,14 @@ int msm_dp_panel_read_link_caps(struct msm_dp_panel *msm_dp_panel,
 		return -EINVAL;
 	}
 
+	drm_info(connector->dev,
+		 "[CONNECTOR:%d:%s] sink %u lanes @ %u kHz, PHY %d lanes, DT %u lanes @ %u kHz: link up to %u lanes @ %u kHz\n",
+		 connector->base.id, connector->name,
+		 drm_dp_max_lane_count(msm_dp_panel->dpcd),
+		 drm_dp_max_link_rate(msm_dp_panel->dpcd), panel->routed_lanes,
+		 panel->link->max_dp_lanes, panel->link->max_dp_link_rate,
+		 msm_dp_panel->link_info.num_lanes, msm_dp_panel->link_info.rate);
+
 	if (drm_dp_is_branch(msm_dp_panel->dpcd)) {
 		count = drm_dp_read_sink_count(panel->aux);
 		if (!count) {
@@ -794,7 +838,7 @@ int msm_dp_panel_init_panel_info(struct msm_dp_panel *msm_dp_panel,
 }
 
 struct msm_dp_panel *msm_dp_panel_get(struct device *dev, struct drm_dp_aux *aux,
-			      struct msm_dp_link *link,
+			      struct msm_dp_link *link, struct phy *phy,
 			      void __iomem *link_base,
 			      void __iomem *mst2link_base,
 			      void __iomem *mst3link_base,
@@ -815,6 +859,7 @@ struct msm_dp_panel *msm_dp_panel_get(struct device *dev, struct drm_dp_aux *aux
 	panel->dev = dev;
 	panel->aux = aux;
 	panel->link = link;
+	panel->phy = phy;
 	panel->link_base = link_base;
 	panel->pixel_base = pixel_base;
 	panel->mst2link_base = mst2link_base;
diff --git a/drivers/gpu/drm/msm/dp/dp_panel.h b/drivers/gpu/drm/msm/dp/dp_panel.h
index dc046fec24fc..c242e2399831 100644
--- a/drivers/gpu/drm/msm/dp/dp_panel.h
+++ b/drivers/gpu/drm/msm/dp/dp_panel.h
@@ -13,6 +13,7 @@
 #include "dp_link.h"
 
 struct edid;
+struct phy;
 
 struct msm_dp_display_mode {
 	struct drm_display_mode drm_mode;
@@ -61,6 +62,7 @@ int msm_dp_panel_deinit(struct msm_dp_panel *msm_dp_panel);
 int msm_dp_panel_timing_cfg(struct msm_dp_panel *msm_dp_panel, bool wide_bus_en);
 int msm_dp_panel_read_link_caps(struct msm_dp_panel *msm_dp_panel,
 				struct drm_connector *connector);
+bool msm_dp_panel_routed_lanes_changed(struct msm_dp_panel *msm_dp_panel);
 u32 msm_dp_panel_get_mode_bpp(struct msm_dp_panel *msm_dp_panel, u32 mode_max_bpp,
 			u32 mode_pclk_khz);
 void msm_dp_panel_handle_sink_request(struct msm_dp_panel *msm_dp_panel,
@@ -102,7 +104,7 @@ static inline bool is_lane_count_valid(u32 lane_count)
 u32 msm_dp_stream_reg(enum msm_dp_stream_id id, u32 reg);
 
 struct msm_dp_panel *msm_dp_panel_get(struct device *dev, struct drm_dp_aux *aux,
-			      struct msm_dp_link *link,
+			      struct msm_dp_link *link, struct phy *phy,
 			      void __iomem *link_base,
 			      void __iomem *mst2link_base,
 			      void __iomem *mst3link_base,
-- 
2.56.0

