From 2289681dbd222b648a3dad69fa7f4da3e1e20609 Mon Sep 17 00:00:00 2001
From: Reixo <125610085+Reixo0@users.noreply.github.com>
Date: Sun, 8 Nov 2026 17:11:39 +0100
Subject: [PATCH] nfc: st54l: add NCI over I2C driver for the ST54L

The ST54L (NFC controller and secure element) speaks plain NCI 2.0
on I2C: a packet is read as its 3-byte header, then its payload in a
second transfer, while the interrupt line is high. The controller
sleeps between packets and refuses the transfer that wakes it, so
transfers are retried.

Out of reset it has no RF; a proprietary command (2F 02, "NFC mode
on") turns it on, after which the controller resets itself and needs
CORE_INIT again (the NCI 2.0 form). That runs in post_setup. Its PLL
runs from a board clock, held on while the device is open, and the
controller is held in reset while it is closed. Firmware debug
traces (proprietary notification 0x02) are dropped.

The secure element is not supported.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/nfc/Kconfig     |  12 ++
 drivers/nfc/Makefile    |   1 +
 drivers/nfc/st54l-i2c.c | 344 ++++++++++++++++++++++++++++++++++++++++
 3 files changed, 357 insertions(+)
 create mode 100644 drivers/nfc/st54l-i2c.c

diff --git a/drivers/nfc/Kconfig b/drivers/nfc/Kconfig
index 288c6f1c6979..e00a73ac4540 100644
--- a/drivers/nfc/Kconfig
+++ b/drivers/nfc/Kconfig
@@ -67,6 +67,18 @@ source "drivers/nfc/microread/Kconfig"
 source "drivers/nfc/nfcmrvl/Kconfig"
 source "drivers/nfc/st21nfca/Kconfig"
 source "drivers/nfc/st-nci/Kconfig"
+
+config NFC_ST54L_I2C
+	tristate "STMicroelectronics ST54L NCI over I2C"
+	depends on NFC_NCI && I2C && GPIOLIB && COMMON_CLK
+	help
+	  This option enables the NFC controller of the ST54L (NFC and
+	  secure element), which speaks NCI 2.0 over I2C, as on the
+	  Nubia RedMagic 11 Pro. The secure element is not supported.
+
+	  Say Y here to compile support for it into the kernel or
+	  say M to compile it as a module. The module will be called
+	  st54l-i2c.ko.
 source "drivers/nfc/nxp-nci/Kconfig"
 source "drivers/nfc/s3fwrn5/Kconfig"
 source "drivers/nfc/st95hf/Kconfig"
diff --git a/drivers/nfc/Makefile b/drivers/nfc/Makefile
index 7b1bfde1d971..f893201f76bb 100644
--- a/drivers/nfc/Makefile
+++ b/drivers/nfc/Makefile
@@ -14,6 +14,7 @@ obj-$(CONFIG_NFC_MRVL)		+= nfcmrvl/
 obj-$(CONFIG_NFC_TRF7970A)	+= trf7970a.o
 obj-$(CONFIG_NFC_ST21NFCA)  	+= st21nfca/
 obj-$(CONFIG_NFC_ST_NCI)	+= st-nci/
+obj-$(CONFIG_NFC_ST54L_I2C)	+= st54l-i2c.o
 obj-$(CONFIG_NFC_NXP_NCI)	+= nxp-nci/
 obj-$(CONFIG_NFC_S3FWRN5)	+= s3fwrn5/
