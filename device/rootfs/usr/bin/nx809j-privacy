#!/usr/bin/python3
"""Privacy switches and what is in use, for Settings and the status bar.

Switches: ~/.config/denial/privacy.json, written by Settings,
    {"microphone": true, "camera": true, "location": true,
     "apps": {"microphone": {"firefox": false}, "camera": {...},
              "location": {"org.gnome.Maps": false}}}
go into PipeWire's "privacy" metadata, where WirePlumber's nx809j-privacy.lua
hides microphones and cameras from the apps switched off. A copy goes to
/run/nx809j-privacy/users/<uid>.json, for the services that are not ours:
braun (the camera service) refuses the camera to apps switched off, and
nx809j-privacy-system makes geoclue refuse location to them. Location as a
whole is switched by Denial's geoclue agent from the first file.

In use: $XDG_RUNTIME_DIR/denial/privacy-usage.json,
    {"inUse": {"microphone": true, "camera": false, "location": true},
     "microphone": ["firefox"], "camera": [], "location": ["org.gnome.Maps"]}
rewritten whenever it changes: apps recording through PipeWire, the app
braun streams for, apps with a camera node open, by the name they report,
and the apps geoclue gives a location to (from nx809j-privacy-system), by
the desktop id they give it.

Seen: $XDG_STATE_HOME/denial/privacy-seen.json, every app that ever used
each, {"microphone": ["firefox"], "camera": [], "location": []}, for the
lists of apps in Settings.
"""

import json
import os
import re
import select
import subprocess
import sys
import time

KINDS = ("microphone", "camera", "location")
POLL_SECONDS = 2


def log(*args):
    print(*args, file=sys.stderr, flush=True)


def config_path():
    base = os.environ.get('XDG_CONFIG_HOME') or os.path.expanduser('~/.config')
    return os.path.join(base, 'denial', 'privacy.json')


def usage_path():
    base = os.environ.get('XDG_RUNTIME_DIR') or '/run/user/%d' % os.getuid()
    return os.path.join(base, 'denial', 'privacy-usage.json')


def seen_path():
    base = os.environ.get('XDG_STATE_HOME') or os.path.expanduser('~/.local/state')
    return os.path.join(base, 'denial', 'privacy-seen.json')


SYSTEM = '/run/nx809j-privacy'
APP = re.compile(r'[\w.+-]+')


def read_config():
    try:
        with open(config_path()) as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = {}
    return data if isinstance(data, dict) else {}


def publish_switches(data):
    """The switches, checked, where braun and nx809j-privacy-system read them."""
    clean = {kind: data.get(kind) is not False for kind in KINDS}
    clean['apps'] = {}
    for kind in KINDS:
        apps = (data.get('apps') or {}).get(kind) or {}
        if isinstance(apps, dict):
            clean['apps'][kind] = {app: on for app, on in apps.items()
                                   if isinstance(on, bool) and APP.fullmatch(app)}
    users = os.path.join(SYSTEM, 'users')
    if not os.path.isdir(users):
        return
    path = os.path.join(users, '%d.json' % os.getuid())
    tmp = '%s.%d.tmp' % (path, os.getpid())
    try:
        with open(tmp, 'w') as f:
            json.dump(clean, f)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except OSError as e:
        log('publishing the switches:', e)


def read_switches(data):
    switches = {}
    for kind in ("microphone", "camera"):
        switches[kind] = 'off' if data.get(kind) is False else 'on'
        apps = (data.get('apps') or {}).get(kind) or {}
        for app, on in apps.items():
            if on is False and re.fullmatch(r'[\w.+-]+', app):
                switches['%s.app.%s' % (kind, app)] = 'off'
    return switches


def metadata_switches():
    """What the privacy metadata holds now."""
    out = subprocess.run(['pw-metadata', '-n', 'privacy', '0'],
                         capture_output=True, text=True).stdout
    found = {}
    for key, value in re.findall(r"key:'([^']+)' value:'([^']*)'", out):
        found[key] = value
    return found


def push_switches(switches):
    current = metadata_switches()
    for key, value in switches.items():
        if current.get(key) != value:
            subprocess.run(['pw-metadata', '-n', 'privacy', '0', key, value, 'Spa:String'],
                           capture_output=True)
    for key in current:
        if key not in switches:
            subprocess.run(['pw-metadata', '-n', 'privacy', '-d', '0', key],
                           capture_output=True)


class Graph:
    """PipeWire's clients and nodes, from pw-dump --monitor."""

    def __init__(self):
        self.objects = {}
        self.proc = subprocess.Popen(['pw-dump', '--monitor', '--no-colors'],
                                     stdout=subprocess.PIPE, text=True, bufsize=1)
        self.buffer = ''
        self.decoder = json.JSONDecoder()

    def fileno(self):
        return self.proc.stdout.fileno()

    def read(self):
        chunk = os.read(self.fileno(), 65536).decode(errors='replace')
        if not chunk:
            raise EOFError('pw-dump ended')
        self.buffer += chunk
        while True:
            text = self.buffer.lstrip()
            if not text:
                self.buffer = ''
                return
            try:
                batch, end = self.decoder.raw_decode(text)
            except ValueError:
                self.buffer = text
                return
            self.buffer = text[end:]
            for obj in batch if isinstance(batch, list) else []:
                oid = obj.get('id')
                if obj.get('info') is None and 'type' not in obj:
                    self.objects.pop(oid, None)
                    continue
                old = self.objects.get(oid, {})
                merged = dict(old)
                merged.update(obj)
                info = dict(old.get('info') or {})
                info.update(obj.get('info') or {})
                merged['info'] = info
                self.objects[oid] = merged

    def app_of(self, client_id):
        client = self.objects.get(client_id) or {}
        props = (client.get('info') or {}).get('props') or {}
        return (props.get('application.process.binary') or props.get('application.name')
                or None)

    def recording(self):
        """Apps with a running capture stream, by kind."""
        found = {"microphone": set(), "camera": set()}
        for obj in self.objects.values():
            if not obj.get('type', '').endswith('Node'):
                continue
            info = obj.get('info') or {}
            props = info.get('props') or {}
            cls = props.get('media.class', '')
            if info.get('state') != 'running':
                continue
            if cls == 'Stream/Input/Audio':
                kind = 'microphone'
            elif cls == 'Stream/Input/Video':
                kind = 'camera'
            else:
                continue
            app = self.app_of(props.get('client.id')) or props.get('application.name')
            if app:
                found[kind].add(app)
        return found


def camera_openers():
    """Our processes with a camera node open (apps that skip PipeWire)."""
    nodes = set()
    for name in os.listdir('/dev'):
        if name.startswith('video'):
            # Video codecs (the iris decoder and encoder) are no cameras.
            # Asking the device with VIDIOC_QUERYCAP would open it, which
            # boots the codec's firmware, so go by the name sysfs gives.
            try:
                with open('/sys/class/video4linux/%s/name' % name) as f:
                    if f.read().strip().endswith(('-decoder', '-encoder')):
                        continue
            except OSError:
                pass
            try:
                st = os.stat('/dev/' + name)
                nodes.add((st.st_rdev))
            except OSError:
                pass
    found = set()
    uid = os.getuid()
    for pid in os.listdir('/proc'):
        if not pid.isdigit():
            continue
        try:
            if os.stat('/proc/' + pid).st_uid != uid:
                continue
            fds = os.listdir('/proc/%s/fd' % pid)
        except OSError:
            continue
        for fd in fds:
            try:
                st = os.stat('/proc/%s/fd/%s' % (pid, fd))
            except OSError:
                continue
            if st.st_rdev and st.st_rdev in nodes and (st.st_mode & 0o170000) == 0o020000:
                try:
                    found.add(os.path.basename(os.readlink('/proc/%s/exe' % pid)))
                except OSError:
                    pass
                break
    # PipeWire's own camera monitor keeps nodes open while idle, and
    # braun-loopback holds its webcam devices to write them: braun says when
    # it streams a camera for them.
    found -= {'pipewire', 'wireplumber', 'braun-loopback'}
    return found


BRAUN_STATUS = '/run/braun/streaming'


def braun_streaming():
    """The app braun streams a camera for: `<app>\t<camera>` while it does."""
    try:
        with open(BRAUN_STATUS) as f:
            app = f.read().split('\t', 1)[0].strip()
    except OSError:
        return set()
    return {app or 'unknown'}


def location_apps():
    """The apps geoclue gives a location to, by their desktop id."""
    try:
        with open(os.path.join(SYSTEM, 'location.json')) as f:
            apps = json.load(f).get('apps') or []
    except (OSError, ValueError, AttributeError):
        return set()
    uid = os.getuid()
    return {a['app'] for a in apps
            if isinstance(a, dict) and a.get('uid') in (uid, None)
            and isinstance(a.get('app'), str)}


def location_in_use():
    """Whether geoclue is giving anyone a location, as nx809j-privacy-system
    follows it. Asking geoclue would start it: busctl get-property ignores
    --auto-start=no, and every poll kept geoclue running."""
    try:
        with open(os.path.join(SYSTEM, 'location.json')) as f:
            return json.load(f).get('inUse') is True
    except (OSError, ValueError, AttributeError):
        return False


def write_usage(usage):
    path = usage_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.tmp'
    data = {'inUse': {k: bool(usage[k]) or (k == 'location' and usage['locationInUse'])
                      for k in KINDS}}
    data.update({k: sorted(usage[k]) for k in KINDS})
    with open(tmp, 'w') as f:
        json.dump(data, f)
    os.replace(tmp, path)


def remember(seen, usage):
    """Adds the apps in use to those seen; whether any was new."""
    new = False
    for kind in KINDS:
        known = seen.setdefault(kind, [])
        for app in sorted(usage[kind]):
            if app not in known and APP.fullmatch(app):
                known.append(app)
                new = True
    return new


def read_seen():
    try:
        with open(seen_path()) as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = {}
    if not isinstance(data, dict):
        data = {}
    return {kind: [a for a in data.get(kind) or [] if isinstance(a, str)] for kind in KINDS}


def write_seen(seen):
    path = seen_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(seen, f)
    os.replace(tmp, path)


def main():
    graph = None
    last_config = None
    last_usage = None
    seen = read_seen()
    next_poll = 0
    while True:
        if graph is None:
            try:
                graph = Graph()
            except OSError as e:
                log('pw-dump:', e)
                time.sleep(5)
                continue

        try:
            mtime = os.stat(config_path()).st_mtime_ns
        except OSError:
            mtime = None
        if mtime != last_config:
            last_config = mtime
            data = read_config()
            push_switches(read_switches(data))
            publish_switches(data)

        timeout = max(0, next_poll - time.monotonic())
        r, _, _ = select.select([graph], [], [], timeout)
        if r:
            try:
                graph.read()
            except (EOFError, OSError):
                log('PipeWire went away; reconnecting')
                graph.proc.kill()
                graph = None
                last_config = None
                time.sleep(2)
                continue

        if time.monotonic() >= next_poll:
            next_poll = time.monotonic() + POLL_SECONDS
            usage = graph.recording()
            usage['camera'] |= camera_openers() | braun_streaming()
            usage['location'] = location_apps()
            usage['locationInUse'] = location_in_use()
            if usage != last_usage:
                last_usage = usage
                write_usage(usage)
                if remember(seen, usage):
                    write_seen(seen)
            # WirePlumber restored them from its state when it started; put
            # them back if the metadata came up empty anyway.
            if not metadata_switches():
                push_switches(read_switches(read_config()))


if __name__ == '__main__':
    main()
