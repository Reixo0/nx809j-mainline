#!/usr/bin/python3
"""Present the shoulder triggers as one gamepad.

Each trigger is its own input device in the kernel ("Left shoulder trigger",
"Right shoulder trigger", aw9620x-key). Games want one controller, so this
grabs both and sends their presses as the left and right shoulder buttons
(BTN_TL, BTN_TR) of a virtual gamepad. A later mode can map them to touches
instead.

SDL only takes a device for a joystick if it has a face button, so the pad
also declares BTN_SOUTH, which is never pressed.
"""
import asyncio
import sys

import evdev
from evdev import ecodes as e

NAME = "RedMagic shoulder triggers"
SOURCES = {"Left shoulder trigger": e.BTN_TL, "Right shoulder trigger": e.BTN_TR}


def find_sources():
    found = {}
    for path in evdev.list_devices():
        dev = evdev.InputDevice(path)
        if dev.name in SOURCES:
            found[dev.name] = dev
        else:
            dev.close()
    return found


async def forward(dev, code, pad):
    dev.grab()
    async for ev in dev.async_read_loop():
        if ev.type == e.EV_KEY:
            pad.write(e.EV_KEY, code, ev.value)
            pad.syn()


async def main():
    # Started when one appears; give the other a moment
    sources = find_sources()
    for _ in range(10):
        if len(sources) == len(SOURCES):
            break
        for dev in sources.values():
            dev.close()
        await asyncio.sleep(0.5)
        sources = find_sources()
    if not sources:
        print("nx809j-triggers: no trigger devices", file=sys.stderr)
        return 1
    caps = {e.EV_KEY: [e.BTN_SOUTH, e.BTN_TL, e.BTN_TR]}
    with evdev.UInput(caps, name=NAME, bustype=e.BUS_VIRTUAL) as pad:
        await asyncio.gather(*(forward(dev, SOURCES[name], pad)
                               for name, dev in sources.items()))
    return 0


if __name__ == "__main__":
    sys.exit(asyncio.run(main()))
