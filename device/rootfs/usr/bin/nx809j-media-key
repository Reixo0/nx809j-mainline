#!/bin/sh
# Dispatch a media playback key to the Droidloom Android container when no
# native MPRIS player is active on the host session D-Bus.
set -eu

case "${1:-}" in
  play-pause|next|previous|stop) action=$1 ;;
  *) exit 2 ;;
esac

pid=$(pgrep -xo logd || true)
[ -n "$pid" ] || exit 1

exec sudo -n nsenter -t "$pid" -a /system/bin/cmd media_session dispatch "$action" >/dev/null 2>&1
