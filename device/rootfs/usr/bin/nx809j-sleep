#!/usr/bin/python3
"""Put the phone to sleep while its screen is off, as Android does.

Sleep is s2idle: the SoC powers down, the modem can still wake it for calls
and messages, and Wi-Fi stays associated, as on Android: the PCIe link to
the Wi-Fi chip is held through sleep (CESTA) and the chip wakes the phone
for frames addressed to it (wake-on-WLAN: unicast to its MAC, a magic
packet, or the access point dropping it), so pushes arrive while it sleeps
and nothing has to reconnect after a wakeup. The phone also wakes itself
every few minutes (a maintenance wakeup, like Android's Doze) for Android's
held-back alarms. When wake-on-WLAN cannot be armed (Wi-Fi not connected),
Wi-Fi drops in sleep and reconnects at the next wakeup.

It sleeps when the screen has been off for a while and nothing needs the
phone awake:
  - a logind "sleep" block inhibitor (systemd-inhibit, or the file
    /run/nx809j-sleep/hold for debugging),
  - sound playing on any output (music, a ringing alarm or call),
  - an Android app holding a partial wakelock (Droidloom's Android has no
    kernel to pass it to), each for at most WAKELOCK_MAX: a misbehaving app
    cannot keep the phone up all night,
  - a call in dmail,
  - network traffic, which keeps downloads going,
  - an Android alarm clock about to ring,
  - a charger: battery does not matter then, and Android does not doze on
    the charger, so its alarms (push reconnects among them) would wake the
    phone again within seconds of each sleep.
After any wakeup it stays up for a short window before sleeping again, so
Wi-Fi can reconnect and messages arrive: at least AWAKE_FOR, and until the
route to the internet has held for NET_SETTLE seconds (at most AWAKE_MAX),
since pushes held during sleep come some seconds after the link to Google
is made again.

Android's own wakeup alarms (push reconnects and the like) could wake the
phone, and so could packets on mobile data, which stays connected in sleep
(the carrier's, or answers to connections closed before sleep). Such a
wake, before the maintenance wakeup is due, keeps Android offline: it gets
a few seconds for its alarm, then the phone sleeps again unless something
else holds it up (a call, sound, an inhibitor, network traffic).
The network comes back at the maintenance wakeup or when the screen turns
on, so a push service that reconnects every few seconds cannot keep the
phone awake.

Android itself is put into Doze when the phone first sleeps, instead of
half an hour later, and let out when the screen turns on: before Doze its
push services' reconnect alarms would wake the phone every few seconds.

Android alarm clocks cannot program the phone's wakeup timer themselves:
the next one is read from Android before each sleep and the phone wakes a
little before it.

Settings, as environment variables (seconds):
  NX809J_SLEEP_AFTER      screen off this long before sleeping (15)
  NX809J_SLEEP_WAKE_EVERY maintenance wakeup interval (300)
  NX809J_SLEEP_AWAKE_FOR  stay up this long after a wakeup (30)
  NX809J_SLEEP_NET_BYTES  traffic per second that counts as busy (30000)
"""

import glob
import ipaddress
import os
import re
import subprocess
import sys
import time

SLEEP_AFTER = int(os.environ.get("NX809J_SLEEP_AFTER", "15"))
WAKE_EVERY = int(os.environ.get("NX809J_SLEEP_WAKE_EVERY", "300"))
AWAKE_FOR = int(os.environ.get("NX809J_SLEEP_AWAKE_FOR", "30"))
NET_BYTES = int(os.environ.get("NX809J_SLEEP_NET_BYTES", "30000"))
# Wake this long before an Android alarm clock; closer than ALARM_NEAR, stay up
ALARM_EARLY = 20
ALARM_NEAR = 90
NET_WINDOW = 10
# After a wakeup, stay up until the route has held this long, at most AWAKE_MAX
NET_SETTLE = 25
AWAKE_MAX = 75
POLL = 2
# Seconds after a wakeup before checking that Wi-Fi came back up
WIFI_CHECK_DELAY = 20
# After an early wakeup (Android alarm, mobile data), sleep again after this
# long
ANDROID_ALARM_WINDOW = 4
# After a wakeup by a packet (a push), sleep again after this long
WIFI_AWAKE_FOR = 10
# The Wi-Fi chip's wakeups: its wakeup source goes away with wake-on-WLAN,
# disarmed at every wakeup, so they are known by its interrupt
WIFI_WAKEUP = "irq:wifi"
# An Android wakelock keeps the phone up for at most this long; while Android
# is offline after an alarm, for at most WAKELOCK_OFFLINE
WAKELOCK_MAX = 600
WAKELOCK_OFFLINE = 30
# Mobile data may wake the phone (the modem needs the IPA data path to reach
# Linux: it crashed once waiting on it); after this many early mobile-data
# wakeups within MOBILE_WAKES_WINDOW seconds it may not, until they age out
MOBILE_WAKES_MAX = 3
MOBILE_WAKES_WINDOW = 3600
HOLD = "/run/nx809j-sleep/hold"
IPA_WAKEUP = "/sys/devices/platform/soc@0/3f40000.ipa/power/wakeup"
ALARM_WAKEUP = "/sys/bus/platform/devices/alarmtimer.*/power/wakeup"
RTC = "/sys/class/rtc/rtc0/wakealarm"


def log(*args):
    print(*args, file=sys.stderr, flush=True)


def run(args, timeout=5):
    try:
        return subprocess.run(args, capture_output=True, text=True,
                              timeout=timeout).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def screen_on():
    for path in glob.glob("/sys/class/drm/card*-DSI-*/dpms"):
        try:
            if open(path).read().strip() == "On":
                return True
        except OSError:
            pass
    return False


def sleep_blocked():
    out = run(["busctl", "get-property", "org.freedesktop.login1",
               "/org/freedesktop/login1", "org.freedesktop.login1.Manager",
               "BlockInhibited"])
    return "sleep" in out.split('"', 1)[-1].split(":")


def session_users():
    for path in glob.glob("/run/user/*/pulse/native"):
        yield path.split("/")[3]


def sound_playing():
    for uid in session_users():
        out = run(["setpriv", f"--reuid={uid}", f"--regid={uid}",
                   "--clear-groups", "env", f"XDG_RUNTIME_DIR=/run/user/{uid}",
                   "pactl", "list", "sinks", "short"])
        if any(line.split("\t")[-1] == "RUNNING" for line in out.splitlines()):
            return True
    return False


def on_charger():
    """Whether a charger feeds the phone (USB or wireless).

    The UCSI supply is left out: it is online too while the phone powers
    an accessory."""
    for psy in glob.glob("/sys/class/power_supply/*"):
        if os.path.basename(psy).startswith("ucsi-"):
            continue
        try:
            if (open(f"{psy}/type").read().strip() in ("USB", "Mains", "Wireless")
                    and open(f"{psy}/online").read().strip() == "1"):
                return True
        except OSError:
            pass
    return False


def in_call():
    out = run(["busctl", "get-property", "org.dmail", "/org/dmail",
               "org.dmail.Voice1", "Calls"])
    m = re.match(r"a\(\w+\) (\d+)", out)
    return bool(m and int(m.group(1)))


def net_bytes():
    total = 0
    for dev in glob.glob("/sys/class/net/*"):
        name = os.path.basename(dev)
        if name == "wlan0" or name.startswith(("rmnet_data", "usb", "eth")):
            for stat in ("rx_bytes", "tx_bytes"):
                try:
                    total += int(open(f"{dev}/statistics/{stat}").read())
                except (OSError, ValueError):
                    pass
    return total


def android(*args, timeout=10):
    """Runs a command in Droidloom's Android, or returns None without it."""
    pid = run(["pgrep", "-x", "logd"]).split()
    if not pid:
        return None
    return run(["nsenter", "-t", pid[0], "-a", "/system/bin/env",
                "PATH=/system/bin:/system/xbin", *args], timeout=timeout)


def android_doze(on):
    """Puts Android into deep Doze at once, or lets it out."""
    out = android("dumpsys", "deviceidle", *(("force-idle", "deep") if on
                                               else ("unforce",)))
    if out is not None:
        log(("Android dozes: " if on else "Android awake: ") + out.strip())
    return out is not None


def duration(text):
    """Seconds in Android's duration format, such as -1m2s345ms."""
    total = 0.0
    for n, unit in re.findall(r"(\d+)(ms|d|h|m|s)", text):
        total += int(n) * {"d": 86400, "h": 3600, "m": 60, "s": 1,
                           "ms": 0.001}[unit]
    return total


def android_wakelock(limit):
    """A partial wakelock an Android app holds, held for less than `limit`
    seconds, or None. Doze disables those of apps it holds back."""
    out = android("dumpsys", "power")
    if not out or "Wake Locks:" not in out:
        return None
    for line in out.split("Wake Locks:", 1)[1].splitlines()[1:]:
        if not line.startswith("  "):
            break
        m = re.match(r"\s+PARTIAL_WAKE_LOCK\s+'(.*)'(.*)", line)
        if not m or "DISABLED" in m.group(2):
            continue
        acq = re.search(r"ACQ=(\S+)", m.group(2))
        if acq and duration(acq.group(1)) >= limit:
            continue
        uid = re.search(r"uid=(\d+)", m.group(2))
        return m.group(1) + (f" (uid {uid.group(1)})" if uid else "")
    return None


def android_alarm_clock():
    """The next Android alarm clock, in seconds since the epoch, or None."""
    out = android("dumpsys", "alarm")
    if out is None:
        return None
    info = out.split("Next alarm clock information:", 1)
    if len(info) < 2:
        return None
    times = [int(t) / 1000 for t in
             re.findall(r"time:(\d+)", info[1].split("pending alarms", 1)[0])]
    return min(times) if times else None


def wakeup_sources():
    """Event counts of the kernel's wakeup sources, by name."""
    counts = {}
    for src in glob.glob("/sys/class/wakeup/wakeup*"):
        try:
            name = open(f"{src}/name").read().strip()
            n = int(open(f"{src}/event_count").read())
        except (OSError, ValueError):
            continue
        counts[name] = counts.get(name, 0) + n
    return counts


WAKE_IRQS = {"131072": "modem", "196608": "adsp"}


def wake_irq_counts():
    """Wake interrupts from the Wi-Fi chip, and message interrupts from the
    modem and ADSP (GLINK), by sender."""
    counts = {}
    try:
        for line in open("/proc/interrupts"):
            f = line.split()
            if not f or f[-1] not in ("glink-smem", "wlan_wake"):
                continue
            name = "wifi" if f[-1] == "wlan_wake" else WAKE_IRQS.get(f[-3])
            if name:
                counts[name] = sum(int(x) for x in f[1:-4] if x.isdigit())
    except OSError:
        pass
    return counts


def wakeup_events():
    counts = wakeup_sources()
    counts.update({f"irq:{k}": v for k, v in wake_irq_counts().items()})
    return counts


def new_events(before):
    """Wakeup sources that fired since `before`; ours and polls left out."""
    after = wakeup_events()
    return sorted(name for name, n in after.items()
                  if n > before.get(name, 0)
                  and not name.startswith(("eventpoll", "[timerfd]", "NETLINK")))


def uplink():
    """The route to the internet, or "" without one."""
    out = run(["ip", "-o", "route", "get", "1.1.1.1"])
    m = re.search(r" dev (\S+)", out)
    return m.group(1) if m else ""


def boottime():
    return time.clock_gettime(time.CLOCK_BOOTTIME)


def suspend_count():
    """Suspends that happened or failed. Timekeeping only stops in sleep
    when the CPUs reach a deep idle state, so a sleep does not always show
    in the clocks."""
    total = 0
    for stat in ("success", "fail"):
        try:
            total += int(open(f"/sys/power/suspend_stats/{stat}").read())
        except (OSError, ValueError):
            pass
    return total


def wakeup_irq():
    """The interrupt that ended the last sleep, by name if known."""
    try:
        irq = open("/sys/power/pm_wakeup_irq").read().strip()
    except OSError:
        return "none recorded"
    try:
        for line in open("/proc/interrupts"):
            f = line.split()
            if f and f[0] == irq + ":":
                return f"{irq} ({f[-1]})"
    except OSError:
        pass
    return irq


def why_awake(now, screen_off_since, awake_since, awake_for, net_rate,
              uplink_since, android_alarm_until):
    if screen_on():
        return "screen on"
    if now - screen_off_since < SLEEP_AFTER:
        return "screen just went off"
    offline = android_alarm_until is not None
    if offline:
        # Woken early: Android stays offline, the phone sleeps again soon
        if now < android_alarm_until:
            return "early wakeup"
    elif now - awake_since < awake_for:
        return "just woke"
    # Pushes held during sleep arrive some seconds after the link to Google
    # is up again; it is made anew whenever the route changes.
    elif now - awake_since < AWAKE_MAX and (
            uplink_since is None or now - uplink_since < NET_SETTLE):
        return "network coming back"
    if os.path.exists(HOLD):
        return "held by " + HOLD
    if on_charger():
        return "on the charger"
    if not offline and net_rate > NET_BYTES:
        return f"network busy ({net_rate // 1000} kB/s)"
    if sleep_blocked():
        return "sleep inhibitor"
    if in_call():
        return "call"
    if sound_playing():
        return "sound playing"
    lock = android_wakelock(WAKELOCK_OFFLINE if offline else WAKELOCK_MAX)
    if lock:
        return f"Android wakelock {lock}"
    return None


def android_net(up, cable=True, ipa=False):
    """Plug Droidloom's virtual cable in or out.

    Unplugged with `ipa` False, mobile data does not wake the phone either.
    It does by default: the modem crashed in sleep once when a bearer switch
    did not complete, with the IPA data path unable to wake Linux, and
    Android keeps it able to. suspend() turns it off only after mobile data
    woke the phone early several times. When Wi-Fi drops in sleep, every wakeup
    re-creates the Wi-Fi link, host traffic goes out over mobile data
    meanwhile, and the answers came in during the next sleep and woke the
    phone again. Calls and SMS reach it through the modem's control
    channel, not through the IPA.

    Android's wakeup alarms do not wake it either (kernel alarmtimer patch:
    with its wakeup disabled, alarm timers do not arm the RTC). Unplugged,
    its push service retried every 5 s, an alarm Doze does not hold back;
    they fire at the next wakeup. Alarm clocks still ring: suspend() sets
    the RTC for them itself."""
    for link in glob.glob("/sys/class/net/dlh*") if cable else ():
        run(["ip", "link", "set", os.path.basename(link), "up" if up else "down"])
    for path in (IPA_WAKEUP, *glob.glob(ALARM_WAKEUP)):
        on = up or (ipa and path == IPA_WAKEUP)
        try:
            with open(path, "w") as f:
                f.write("enabled" if on else "disabled")
        except OSError as err:
            log(f"cannot change wakeup {path}: {err}")


def wake_patterns(mac, addrs):
    """Frames that wake the phone, as iw patterns: sent to the phone itself
    and carrying TCP, UDP, an ARP request, an IPv6 neighbour solicitation or
    a key. Pings and other LAN chatter do not; "-" matches any byte. The
    address is in the pattern because access points also send multicasts
    (mDNS) to each station's own MAC."""
    def frame(*fields):
        out = mac.split(":") + ["-"] * 6
        for offset, data in fields:
            out += ["-"] * (offset - len(out)) + data.split(":")
        return ":".join(out)

    patterns = []
    for addr in addrs:
        dst = addr.packed.hex(":")
        for proto in ("06", "11"):
            patterns.append(
                frame((12, "08:00"), (23, proto), (30, dst)) if addr.version == 4
                else frame((12, "86:dd"), (20, proto), (38, dst)))
    # The chip takes 22 patterns in all
    return patterns[:19] + [
        frame((12, "86:dd"), (20, "3a"), (54, "87")),
        frame((12, "08:06"), (20, "00:01")),
        frame((12, "88:8e"))]


def wifi_addresses():
    """The phone's own addresses on Wi-Fi, IPv4 first."""
    addrs = []
    for line in run(["ip", "-o", "addr", "show", "dev", "wlan0"]).splitlines():
        m = re.search(r" inet6? ([^/ ]+)", line)
        if m:
            addrs.append(ipaddress.ip_address(m.group(1)))
    return sorted(addrs, key=lambda a: (a.version, a.is_link_local))


def wifi_keep_armed():
    """Arm wake-on-WLAN so Wi-Fi stays associated through the sleep.

    NetworkManager keeps a device up across suspend only when it has
    wake-on-WLAN set; nx809j-wowlan (systemd-sleep hook) disarms it after
    the wakeup, before NetworkManager hears of it, or NetworkManager would
    take the link down and reconnect. The chip and its PCIe root port need
    their wakeup enabled: the PCIe controller only holds the link through
    sleep for an endpoint armed to wake the phone. True when armed."""
    if not run(["iw", "dev", "wlan0", "link"]).startswith("Connected"):
        return False
    try:
        phy = os.path.basename(os.path.realpath("/sys/class/net/wlan0/phy80211"))
        mac = open("/sys/class/net/wlan0/address").read().strip()
        dev = os.path.realpath("/sys/class/net/wlan0/device")
        for d in (dev, os.path.dirname(dev)):
            with open(os.path.join(d, "power/wakeup"), "w") as f:
                f.write("enabled")
    except OSError as err:
        log(f"cannot arm wake-on-WLAN: {err}")
        return False
    armed = subprocess.run(["iw", "phy", phy, "wowlan", "enable", "disconnect",
                            "magic-packet", "patterns", *wake_patterns(mac, wifi_addresses())],
                           capture_output=True, text=True)
    if armed.returncode != 0:
        log(f"cannot arm wake-on-WLAN: {armed.stderr.strip()}")
    return armed.returncode == 0


def wifi_revive():
    """Reconnect Wi-Fi when a wakeup left the interface down.

    A Wi-Fi firmware crash in sleep fails the resume; ath12k restarts the
    chip, but leaves the interface down for the next open, and
    NetworkManager, back from its own sleep, still counts it connected and
    never opens it again: Wi-Fi stays dead until a reboot. Opening it lets
    wpa_supplicant associate again (nmcli refuses a device it counts
    connected)."""
    try:
        with open("/sys/class/net/wlan0/flags") as f:
            flags = int(f.read(), 16)
    except (OSError, ValueError):
        return
    if flags & 1 or run(["nmcli", "-t", "radio", "wifi"]).strip() != "enabled":
        return
    log("Wi-Fi left down after a wakeup: reconnecting")
    run(["ip", "link", "set", "wlan0", "up"])


def android_push_off(ipa=True):
    """Close Android's internet connections before Wi-Fi goes away in sleep.

    Wi-Fi drops without a word, so Google's server would keep sending
    pushes into a connection that is dead until the phone's next wakeup,
    and those are lost. Reset it while Wi-Fi is up, so the server holds them
    for the next connection, and unplug Android so it does not make a new
    one before the phone sleeps.

    The other connections are reset too: a server that closes an idle one
    (Private DNS over TLS does within minutes) gets no answer from the
    unplugged Android and resends its FIN for a long time, and over mobile
    data, which stays up in sleep, every resend wakes the phone.
    Connections to the host (Droidloom's own services) are left alone."""
    pid = run(["pgrep", "-x", "logd"]).split()
    if not pid or not glob.glob("/sys/class/net/dlh*"):
        return False
    netns = ["nsenter", "-t", pid[0], "-n", "ss"]
    peers = set()
    for line in run([*netns, "-tnH", "state", "connected"]).splitlines():
        f = line.split()
        if len(f) < 4:
            continue
        addr = f[-1].rsplit(":", 1)[0].strip("[]")
        try:
            ip = ipaddress.ip_address(addr)
        except ValueError:
            continue
        if (getattr(ip, "ipv4_mapped", None) or ip).is_global:
            peers.add(addr)
    for addr in sorted(peers):
        run([*netns, "-K", "state", "connected", "dst", f"[{addr}]"
             if ":" in addr else addr])
    time.sleep(0.3)  # the resets leave through the cable
    android_net(False, ipa=ipa)
    return True


def suspend(now_wall, wake, ipa=True):
    """Sleep until `wake` (seconds since the epoch) at the latest; mobile data
    wakes the phone if `ipa`."""
    alarm = android_alarm_clock()
    if alarm is not None and alarm > now_wall - 60:
        if alarm - now_wall < ALARM_NEAR:
            return "alarm clock due"
        if alarm - ALARM_EARLY < wake:
            wake = alarm - ALARM_EARLY
            log("waking before an alarm clock")
    try:
        with open(RTC, "w") as rtc:
            rtc.write("0")
        with open(RTC, "w") as rtc:
            rtc.write(str(int(wake)))
    except OSError as err:
        log(f"cannot set the wakeup timer: {err}")
        return "no wakeup timer"
    if wifi_keep_armed():
        # Wi-Fi stays up: Android keeps its connections and gets its pushes
        # in sleep. Only its alarms stop waking the phone.
        log(f"sleeping with Wi-Fi kept, wakeup in {int(wake - now_wall)} s"
            + ("" if ipa else ", mobile data wakeups off"))
        android_net(False, cable=False, ipa=ipa)
        unplugged = True
    else:
        log(f"sleeping, wakeup in {int(wake - now_wall)} s"
            + ("" if ipa else ", mobile data wakeups off"))
        unplugged = android_push_off(ipa)
    # Root may suspend through block inhibitors: why_awake checked them
    if subprocess.run(["systemctl", "suspend"]).returncode != 0:
        if unplugged:
            android_net(True)
        return "suspend refused"
    return None


def main():
    os.makedirs(os.path.dirname(HOLD), exist_ok=True)
    # A previous run may have stopped with Android unplugged
    android_net(True)
    now = time.monotonic()
    screen_off_since = now
    awake_since = now
    awake_for = AWAKE_FOR
    was_on = True
    net = [(now, net_bytes())]
    reason = None
    events = None
    unplugged_android = False
    # Set while a suspend was asked for: the suspend count and boot time then
    asleep = None
    # Wall time the maintenance wakeup is due, while Android stays offline
    maintenance = None
    android_alarm_until = None
    dozing = False
    # Boot times of early wakeups by mobile data: the monotonic clock stops in
    # sleep, so the window would last most of a night
    mobile_wakes = []
    # Monotonic time to check that Wi-Fi came back after a wakeup
    wifi_check = None
    last_route = uplink()
    uplink_since = now if last_route else None
    while True:
        time.sleep(POLL)
        now = time.monotonic()
        if asleep is not None and suspend_count() != asleep[0]:
            slept = boottime() - asleep[1]
            irq = wakeup_irq()
            fired = new_events(events) if events else []
            asleep = None
            events = None
            # An Android alarm due as the phone goes to sleep makes the
            # kernel's alarm timer cancel the sleep: no wakeup irq then
            cause = ("Android alarm" if "rtc" in irq
                     or (irq == "none recorded" and "alarmtimer.1.auto" in fired)
                     else "mobile data" if "(ipa)" in irq
                     else "Wi-Fi" if WIFI_WAKEUP in fired else None)
            early = (maintenance is not None and time.time() < maintenance - 5
                     and cause is not None and not screen_on())
            # A packet: Android is online for it, and the maintenance wakeup
            # stays due. A lost connection takes a full wakeup.
            packet = (early and cause == "Wi-Fi"
                      and run(["iw", "dev", "wlan0", "link"]).startswith("Connected"))
            early = early and cause != "Wi-Fi"
            log(f"woke after {int(slept)} s, wakeup irq {irq}"
                + (f", wakeup sources: {' '.join(fired)}" if fired else "")
                + (f", {cause}: Android stays offline" if early else
                   ", Wi-Fi packet" if packet else ""))
            wifi_check = now + WIFI_CHECK_DELAY
            if early and cause == "mobile data":
                mobile_wakes.append(boottime())
            if early:
                android_alarm_until = now + ANDROID_ALARM_WINDOW
            else:
                android_alarm_until = None
                if not packet:
                    maintenance = None
                awake_for = WIFI_AWAKE_FOR if packet else AWAKE_FOR
                awake_since = now
                net = []
        if wifi_check is not None and now >= wifi_check and asleep is None:
            wifi_check = None
            wifi_revive()
        on = screen_on()
        if on:
            was_on = True
            android_alarm_until = None
            maintenance = None
            if dozing:
                dozing = not android_doze(False)
        elif was_on:
            was_on = False
            screen_off_since = now
        # Awake for good: Android goes online again
        if unplugged_android and android_alarm_until is None and asleep is None:
            android_net(True)
            unplugged_android = False
        route = uplink()
        if route != last_route:
            last_route = route
            uplink_since = now if route else None
        net.append((now, net_bytes()))
        net = [s for s in net if now - s[0] <= NET_WINDOW]
        span = net[-1][0] - net[0][0]
        rate = int((net[-1][1] - net[0][1]) / span) if span >= 4 else NET_BYTES + 1
        why = why_awake(now, screen_off_since, awake_since, awake_for, rate,
                        uplink_since, android_alarm_until)
        if why is None:
            events = wakeup_events()
            wall = time.time()
            if maintenance is None or maintenance <= wall + 5:
                maintenance = wall + WAKE_EVERY
            if not dozing and not on_charger():
                dozing = android_doze(True)
            asleep = (suspend_count(), boottime())
            unplugged_android = True
            mobile_wakes = [t for t in mobile_wakes
                            if boottime() - t < MOBILE_WAKES_WINDOW]
            why = suspend(wall, maintenance, len(mobile_wakes) < MOBILE_WAKES_MAX)
            if why is None:
                time.sleep(5)
                continue
            asleep = None
            android_alarm_until = None
            maintenance = None
        if why != reason and not on:
            log(f"staying awake: {why}")
        reason = why


if __name__ == "__main__":
    main()
