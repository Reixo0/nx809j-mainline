# The system DMA-BUF heap, for the logged-in user and the video group: the
# Iris VA-API driver (vpu_drv_video.so) allocates the decoded surfaces it
# hands to browsers there. Not world-writable: any heap user can allocate
# memory without limit.
SUBSYSTEM=="dma_heap", KERNEL=="system", GROUP="video", MODE="0660", TAG+="uaccess"
