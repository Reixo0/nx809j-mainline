#!/bin/sh
# Droidloom's Android sees one constant network, so it never learns that the
# phone moved between USB, Wi-Fi and mobile data: its long-lived connections
# (push notifications above all) stay open toward an address that is gone.
# When the default route changes, unplug and replug Android's virtual cable so
# it reconnects everything, as a phone does when it changes networks.

case "$1" in dlh*|lo|p2p-*) exit 0 ;; esac
case "$2" in up|down|dhcp4-change|dhcp6-change|connectivity-change) ;; *) exit 0 ;; esac

exec /usr/bin/nx809j-droidloom-uplink
