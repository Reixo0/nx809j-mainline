# Notify when the modem has crashed and stays down until a reboot
# (nx809j-modem-watch).
[Unit]
Description=Modem crash notification
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/nx809j-modem-watch
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
