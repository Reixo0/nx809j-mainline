# Bring-up config fragment for the Nubia RedMagic 11 Pro (NX809J).
# Merged on top of arm64 defconfig by scripts/build.sh.
#
# Everything needed to reach a shell is built in (=y) so the first boots
# don't depend on loading modules from the initramfs.

# SoC core
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_KAANAPALI=y
CONFIG_CLK_KAANAPALI_GCC=y
CONFIG_CLK_KAANAPALI_TCSRCC=y
# Display clock controller, needed by MSM DRM. (While only simplefb was used
# it had to stay unloaded: probing it alone killed the bootloader splash.)
CONFIG_CLK_KAANAPALI_DISPCC=y
# GPU clocks (gpucc + gxclkctl); the GPU SMMU and the GPU need them at boot
CONFIG_CLK_KAANAPALI_GPUCC=y
CONFIG_CLK_KAANAPALI_CAMCC=m
CONFIG_CLK_KAANAPALI_VIDEOCC=m
CONFIG_INTERCONNECT_QCOM_KAANAPALI=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMHPD=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_INPUT_PM8941_PWRKEY=y
# PMIC PON block: creates the power key and volume down (resin) devices.
# No reboot modes are described for pmk8850, so it writes nothing on reboot.
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_AOSS_QMP=y
# SCMI (CPU frequency) talks to the CPUCP over this mailbox ("pdp0_mbox")
CONFIG_QCOM_CPUCP_MBOX=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y

# Storage: UFS
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_SCSI_UFS_CRYPTO=y

# USB (eUSB2 + QMP combo PHY, dwc3) and gadget for a USB network shell
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_M31_EUSB=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_TYPEC=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_ROLE_SWITCH=y

# DSPs (remoteproc PAS) and what talks to them. On Kaanapali, pmic-glink
# (battery, charger, USB-C) lives on the SoCCP, which XBL already started
# (driver attaches); the ADSP is loaded from firmware in the initramfs.
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_PDR_MSG=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_SOCINFO=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_BATTERY_QCOM_BATTMGR=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_PMIC_GLINK=y

# Touchscreen: Synaptics TouchComm on QUP SPI
CONFIG_SPI_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_I2C=y

# Wi-Fi/BT combo on PCIe0. The PCIe controller waits for the Wi-Fi node's
# power control driver (PCI_PWRCTRL_PWRSEQ), which only ath11k/ath12k can
# select, so it is a module like ath12k and loads from the rootfs.
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
# ath12k debug_mask (module option) only works with this; bring-up aid
CONFIG_ATH12K_DEBUG=y
CONFIG_ATH12K_COREDUMP=y

# postmarketOS services: nftables firewall rules and zram swap
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_CONNTRACK=m
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_ZRAM=m

# Rootfs served from the PC over USB networking (nx809j.root=nbd)
CONFIG_BLK_DEV_NBD=y
# Rootfs in a logical partition inside super (nx809j.root=dm): the kernel
# maps it from dm-mod.create= on the cmdline
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INIT=y

# Display: simplefb until MSM DRM + the panel driver take over
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=n
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
# DRM_MSM can only be built in if these are too
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_PANEL_RAYDIUM_RM692H5=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Keep the kernel log across reboots into Android (read /sys/fs/pstore)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# ABL may leave the APSS watchdog running; without the driver built in it
# would bite a few seconds into boot (downstream bark time: 11 s)
CONFIG_WATCHDOG=y
CONFIG_QCOM_WDT=y

# RTC offset in PMIC SDAM: needed when the RTC probes and sets the clock
CONFIG_NVMEM_SPMI_SDAM=y

# Debug aids for bring-up
CONFIG_PRINTK_TIME=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_FS=y
CONFIG_MAGIC_SYSRQ=y
# /sys/power/pm_test and pm_print_times, for the suspend bring-up
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# ABL appends Android's bootconfig to the initrd; this strips it cleanly
CONFIG_BOOT_CONFIG=y
CONFIG_LOCALVERSION="-nx809j"
CONFIG_LOCALVERSION_AUTO=n

# USB drives: exFAT/NTFS, UAS
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_USB_UAS=m

# Speaker amplifiers
CONFIG_SND_SOC_AW88461=m

# Cooling fan (pwm-fan on the PMH0101 LPG) and liquid cooling micropump
CONFIG_SENSORS_PWM_FAN=m
CONFIG_LEDS_QCOM_LPG=m
CONFIG_SENSORS_AWP1921=m
